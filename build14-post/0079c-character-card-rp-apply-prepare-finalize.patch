+    pub async fn finalize(
+        &self,
+        request: CharacterCardRpApplyFinalizeRequest,
+    ) -> Result<CharacterCardRpApplyCommitResult, ApplicationError> {
+        let _guard = self.commit_guard.lock().await;
+        let transaction_id = require_id(&request.transaction_id, "transactionId")?;
+        let stable_chat_id = require_id(&request.stable_chat_id, "stableChatId")?;
+        let mut journal = self
+            .materialization
+            .read_transaction(transaction_id)
+            .await?
+            .ok_or_else(|| ApplicationError::ValidationError(
+                "CARD_RP_TRANSACTION_MISSING: prepared transaction does not exist".to_string(),
+            ))?;
+        if !matches!(
+            journal.state,
+            CharacterCardTransactionState::RpProfileWritten
+                | CharacterCardTransactionState::ReadbackVerified
+                | CharacterCardTransactionState::Committed
+        ) {
+            return Err(ApplicationError::ValidationError(format!(
+                "CARD_RP_TRANSACTION_INVALID: transaction is in state {:?}",
+                journal.state
+            )));
+        }
+
+        let selected = self
+            .selected
+            .resolve_stable_chat_id(stable_chat_id)
+            .await?;
+        if selected.state_id != transaction_id {
+            return Err(ApplicationError::ValidationError(
+                "CARD_RP_HOST_COMMIT_MISSING: current chat has not selected the prepared persistent state"
+                    .to_string(),
+            ));
+        }
+        let state = self.read_rp_state(&selected).await?;
+        let mut binding = self.active_binding(&journal.binding_id).await?;
+        validate_binding_target(&binding, &selected, &state)?;
+        let character_id = binding.target.character_id.0.clone();
+        let profile_revision = state
+            .get("castRegistry")
+            .and_then(Value::as_object)
+            .and_then(|cast| cast.get(&character_id))
+            .and_then(Value::as_object)
+            .and_then(|entity| entity.get("profileRevision"))
+            .and_then(Value::as_u64)
+            .ok_or_else(|| ApplicationError::ValidationError(
+                "CARD_RP_STATE_INVALID: finalized profileRevision is missing".to_string(),
+            ))?;
+
+        if journal.state != CharacterCardTransactionState::Committed {
+            journal.state = CharacterCardTransactionState::ReadbackVerified;
+            journal.updated_at = Utc::now().to_rfc3339();
+            self.materialization.write_transaction(&journal).await?;
+            binding.profile_revision_at_last_sync = Some(profile_revision);
+            for context in &mut binding.contexts {
+                if context.branch_id.0 == stable_chat_id {
+                    context.last_seen_profile_revision = Some(profile_revision);
+                }
+            }
+            binding.updated_at = Utc::now().to_rfc3339();
+            self.materialization.write_binding(&binding).await?;
+            journal.state = CharacterCardTransactionState::Committed;
+            journal.updated_at = Utc::now().to_rfc3339();
+            self.materialization.write_transaction(&journal).await?;
+        }
+
+        Ok(CharacterCardRpApplyCommitResult {
+            transaction_id: transaction_id.to_string(),
+            binding_id: binding.binding_id,
+            state_id: selected.state_id,
+            profile_revision,
+        })
+    }
