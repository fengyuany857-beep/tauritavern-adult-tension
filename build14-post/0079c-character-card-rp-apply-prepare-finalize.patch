+
+fn apply_profile_selections(
+    state: &mut Value,
+    preview: &CharacterCardRpApplyPreview,
+    selections: &[CharacterCardRpApplySelection],
+    transaction_id: &str,
+) -> Result<(u64, usize), ApplicationError> {
+    let turn = state.get("turn").and_then(Value::as_u64).unwrap_or(0);
+    let entity = state
+        .get_mut("castRegistry")
+        .and_then(Value::as_object_mut)
+        .and_then(|cast| cast.get_mut(&preview.cas.character_id))
+        .and_then(Value::as_object_mut)
+        .ok_or_else(|| ApplicationError::ValidationError(
+            "CARD_RP_TARGET_MISSING: bound character disappeared before Prepare".to_string(),
+        ))?;
+    let current_revision = entity
+        .get("profileRevision")
+        .and_then(Value::as_u64)
+        .ok_or_else(|| ApplicationError::ValidationError(
+            "CARD_RP_STATE_INVALID: profileRevision is missing".to_string(),
+        ))?;
+    if current_revision != preview.cas.profile_revision {
+        return Err(ApplicationError::ValidationError(
+            "CARD_RP_PLAN_STALE: profile revision changed after Preview".to_string(),
+        ));
+    }
+    let author = entity
+        .get("authorCanon")
+        .and_then(Value::as_object)
+        .cloned()
+        .unwrap_or_default();
+    let stable = entity
+        .entry("stableProfile")
+        .or_insert_with(|| json!({}))
+        .as_object_mut()
+        .ok_or_else(|| ApplicationError::ValidationError(
+            "CARD_RP_STATE_INVALID: stableProfile must be an object".to_string(),
+        ))?;
+
+    let mut pending_evidence = Vec::new();
+    let mut change_count = 0usize;
+    for (index, selection) in selections.iter().enumerate() {
+        let trait_key = selection.trait_key.trim();
+        if author.contains_key(trait_key) {
+            return Err(ApplicationError::ValidationError(format!(
+                "CARD_RP_AUTHOR_CANON_PROTECTED: `{trait_key}` is controlled by Author Canon"
+            )));
+        }
+        let statement = selection.statement.trim();
+        let current = stable
+            .get(trait_key)
+            .and_then(Value::as_object)
+            .and_then(|value| value.get("statement"))
+            .and_then(Value::as_str)
+            .unwrap_or_default();
+        if current == statement {
+            continue;
+        }
+        let evidence_id = format!("card-import-{transaction_id}-{index}");
+        stable.insert(
+            trait_key.to_string(),
+            json!({
+                "statement": statement,
+                "evidenceRefs": [evidence_id.clone()],
+                "status": "stable",
+                "updatedTurn": turn,
+            }),
+        );
+        pending_evidence.push(json!({
+            "id": evidence_id,
+            "characterId": preview.cas.character_id,
+            "traitKey": trait_key,
+            "statement": statement,
+            "sourceKind": "imported_card",
+            "context": "character_card_apply",
+            "sourceRef": format!(
+                "binding:{}:generation:{}:cardRevision:{}",
+                preview.cas.binding_id,
+                preview.cas.binding_generation,
+                preview.cas.card_revision,
+            ),
+            "turn": turn,
+            "contradicts": false,
+            "retracted": false,
+        }));
+        change_count += 1;
+    }
+    if change_count == 0 {
+        return Err(ApplicationError::ValidationError(
+            "CARD_RP_NO_CHANGES: selected mappings already match the stable profile".to_string(),
+        ));
+    }
+    let profile_revision = current_revision.saturating_add(1);
+    entity.insert("profileRevision".to_string(), json!(profile_revision));
+
+    let evidence = state
+        .get_mut("profileEvidence")
+        .and_then(Value::as_array_mut)
+        .ok_or_else(|| ApplicationError::ValidationError(
+            "CARD_RP_STATE_INVALID: profileEvidence must be an array".to_string(),
+        ))?;
+    evidence.extend(pending_evidence);
+    if evidence.len() > MAX_PROFILE_EVIDENCE {
+        let overflow = evidence.len() - MAX_PROFILE_EVIDENCE;
+        evidence.drain(..overflow);
+    }
+    let runtime_revision = state
+        .get("runtimeRevision")
+        .and_then(Value::as_u64)
+        .unwrap_or(0)
+        .saturating_add(1);
+    if let Some(object) = state.as_object_mut() {
+        object.insert("runtimeRevision".to_string(), json!(runtime_revision));
+        object.insert("lastRunId".to_string(), json!(transaction_id));
+    }
+    Ok((profile_revision, change_count))
+}
