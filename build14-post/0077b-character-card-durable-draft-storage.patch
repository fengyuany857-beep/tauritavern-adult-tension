+        atomic_write_json(&path, draft).await
+    }
+
+    pub async fn list_drafts(&self) -> Result<Vec<CharacterCardDraftRecord>, DomainError> {
+        let mut output = Vec::new();
+        let mut entries = match fs::read_dir(self.drafts_dir()).await {
+            Ok(entries) => entries,
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(output),
+            Err(error) => return Err(DomainError::InternalError(format!(
+                "Failed to list Character Card drafts: {error}"
+            ))),
+        };
+        while let Some(entry) = entries.next_entry().await.map_err(|error| {
+            DomainError::InternalError(format!("Failed to inspect Character Card draft directory: {error}"))
+        })? {
+            if !entry.file_type().await.map_err(|error| {
+                DomainError::InternalError(format!("Failed to inspect Character Card draft entry: {error}"))
+            })?.is_file() {
+                continue;
+            }
+            let file_name = entry.file_name();
+            let Some(file_name) = file_name.to_str() else { continue; };
+            if !file_name.ends_with(".json") {
+                continue;
+            }
+            output.push(read_json(entry.path()).await?);
+        }
+        output.sort_by(|left, right| left.draft.draft_id.cmp(&right.draft.draft_id));
+        Ok(output)
+    }
