+fn decode_origin_secret(bytes: Vec<u8>) -> Result<[u8; 32], DomainError> {
+    bytes.try_into().map_err(|_| {
+        DomainError::InvalidData(
+            "Local Character Card origin proof secret has invalid length; refusing to regenerate over it"
+                .to_string(),
+        )
+    })
+}
+
+fn validate_staging_ref(value: &str) -> Result<&str, DomainError> {
+    let Some(file_name) = value.strip_prefix("staging/") else {
+        return Err(DomainError::InvalidData(
+            "staged import ref must be relative to staging/".to_string(),
+        ));
+    };
+    let (id, extension) = file_name.rsplit_once('.').ok_or_else(|| {
+        DomainError::InvalidData("staged import ref has no extension".to_string())
+    })?;
+    validate_opaque_id(id)?;
+    if !matches!(extension, "png" | "json") {
+        return Err(DomainError::InvalidData(
+            "staged import ref has an unsupported extension".to_string(),
+        ));
+    }
+    Ok(file_name)
+}
