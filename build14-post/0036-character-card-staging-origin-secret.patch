+    #[tokio::test]
+    async fn staging_is_immutable_and_never_persists_provider_path() {
+        let root = std::env::temp_dir().join(format!(
+            "tt-card-staging-test-{}",
+            uuid::Uuid::new_v4().simple()
+        ));
+        let data = DataDirectory::new(root.clone());
+        let store = CharacterCardMaterializationStore::new(&data);
+        store.initialize().await.unwrap();
+        let (logical_ref, hash) = store
+            .stage_import("tx-1", "json", br#"{"data":{"name":"Lin"}}"#)
+            .await
+            .unwrap();
+        assert_eq!(logical_ref, "staging/tx-1.json");
+        assert_eq!(hash.len(), 64);
+        assert!(!logical_ref.contains("/private/var/mobile/"));
+        assert!(store
+            .stage_import("tx-1", "json", b"replacement")
+            .await
+            .is_err());
+        store.remove_staged_import(&logical_ref).await.unwrap();
+        let _ = fs::remove_dir_all(root).await;
+    }
+
+    #[tokio::test]
+    async fn origin_secret_is_stable_and_corruption_fails_closed() {
+        let root = std::env::temp_dir().join(format!(
+            "tt-card-secret-test-{}",
+            uuid::Uuid::new_v4().simple()
+        ));
+        let data = DataDirectory::new(root.clone());
+        let store = CharacterCardMaterializationStore::new(&data);
+        store.initialize().await.unwrap();
+        let first = store.load_or_create_origin_secret().await.unwrap();
+        let second = store.load_or_create_origin_secret().await.unwrap();
+        assert_eq!(first, second);
+        assert_ne!(first, [0u8; 32]);
+
+        fs::write(store.keys_dir().join(ORIGIN_SECRET_FILE), b"broken")
+            .await
+            .unwrap();
+        assert!(store.load_or_create_origin_secret().await.is_err());
+        let _ = fs::remove_dir_all(root).await;
+    }
