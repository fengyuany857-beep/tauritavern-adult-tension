+    /// Copy bytes from a provider-owned URL into an immutable local staging
+    /// object. Preview and Commit must use this copy, never the provider path.
+    pub async fn stage_import(
+        &self,
+        transaction_id: &str,
+        extension: &str,
+        bytes: &[u8],
+    ) -> Result<(String, String), DomainError> {
+        validate_opaque_id(transaction_id)?;
+        let extension = match extension.to_ascii_lowercase().as_str() {
+            "json" => "json",
+            "png" => "png",
+            _ => {
+                return Err(DomainError::InvalidData(
+                    "Character Card staging only accepts PNG or JSON".to_string(),
+                ));
+            }
+        };
+        let file_name = format!("{transaction_id}.{extension}");
+        let target = self.staging_dir().join(&file_name);
+        let mut file = fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(&target)
+            .await
+            .map_err(|error| map_io("create immutable staged import", error))?;
+        if let Err(error) = file.write_all(bytes).await {
+            let _ = fs::remove_file(&target).await;
+            return Err(map_io("write immutable staged import", error));
+        }
+        if let Err(error) = file.sync_all().await {
+            let _ = fs::remove_file(&target).await;
+            return Err(map_io("sync immutable staged import", error));
+        }
+        drop(file);
+        let hash = format!("{:x}", Sha256::digest(bytes));
+        Ok((format!("{STAGING_DIR}/{file_name}"), hash))
+    }
+
+    pub async fn read_staged_import(&self, logical_ref: &str) -> Result<Vec<u8>, DomainError> {
+        let file_name = validate_staging_ref(logical_ref)?;
+        fs::read(self.staging_dir().join(file_name))
+            .await
+            .map_err(|error| map_io("read staged import", error))
+    }
+
+    pub async fn remove_staged_import(&self, logical_ref: &str) -> Result<(), DomainError> {
+        let file_name = validate_staging_ref(logical_ref)?;
+        match fs::remove_file(self.staging_dir().join(file_name)).await {
+            Ok(()) => Ok(()),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(()),
+            Err(error) => Err(map_io("remove staged import", error)),
+        }
+    }
+
+    /// [EXPORT-LOCAL-ONLY] [LOG-NEVER] Returns the per-installation HMAC secret.
+    /// The secret lives in the existing continuity-covered `_tauritavern` root
+    /// and is never exposed as a portable path or Character Card field.
+    pub async fn load_or_create_origin_secret(&self) -> Result<[u8; 32], DomainError> {
+        let path = self.keys_dir().join(ORIGIN_SECRET_FILE);
+        match fs::read(&path).await {
+            Ok(bytes) => return decode_origin_secret(bytes),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+            Err(error) => return Err(map_io("read local origin proof secret", error)),
+        }
+
+        fs::create_dir_all(self.keys_dir())
+            .await
+            .map_err(|error| map_io("create local key directory", error))?;
+        let mut secret = [0u8; 32];
+        secret[..16].copy_from_slice(uuid::Uuid::new_v4().as_bytes());
+        secret[16..].copy_from_slice(uuid::Uuid::new_v4().as_bytes());
+
+        match fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(&path)
+            .await
+        {
+            Ok(mut file) => {
+                if let Err(error) = file.write_all(&secret).await {
+                    let _ = fs::remove_file(&path).await;
+                    return Err(map_io("write local origin proof secret", error));
+                }
+                if let Err(error) = file.sync_all().await {
+                    let _ = fs::remove_file(&path).await;
+                    return Err(map_io("sync local origin proof secret", error));
+                }
+                Ok(secret)
+            }
+            Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => {
+                decode_origin_secret(
+                    fs::read(&path)
+                        .await
+                        .map_err(|error| map_io("read concurrently created origin secret", error))?,
+                )
+            }
+            Err(error) => Err(map_io("create local origin proof secret", error)),
+        }
+    }
