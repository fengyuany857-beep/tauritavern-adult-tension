+#[tauri::command]
+pub async fn plan_character_card_return(
+    request: PlanCharacterCardReturnRequest,
+    app_state: State<'_, Arc<AppState>>,
+) -> Result<CharacterCardReturnPlanResult, CommandError> {
+    log_command("plan_character_card_return");
+    let session_id = SessionId(request.session_id);
+    let branch_id = BranchId(request.branch_id);
+    app_state
+        .services
+        .character_card_materialization_orchestrator
+        .plan_staged_return(
+            &request.staged_ref,
+            request.format,
+            request.replace_avatar,
+            &session_id,
+            &branch_id,
+            &request.choices,
+        )
+        .await
+        .map_err(map_command_error("Failed to plan Character Card Return"))
+}
+
+#[tauri::command]
+pub async fn commit_character_card_return(
+    request: CommitCharacterCardReturnRequest,
+    app_state: State<'_, Arc<AppState>>,
+) -> Result<CharacterCardReturnCommitResult, CommandError> {
+    log_command("commit_character_card_return");
+    let session_id = SessionId(request.session_id);
+    let branch_id = BranchId(request.branch_id);
+    app_state
+        .services
+        .character_card_materialization_orchestrator
+        .commit_staged_return(
+            &request.staged_ref,
+            request.format,
+            request.replace_avatar,
+            &request.supplied_plan,
+            &session_id,
+            &branch_id,
+            &request.choices,
+        )
+        .await
+        .map_err(map_command_error("Failed to commit Character Card Return"))
+}
