index 0000000..50d0241
--- /dev/null
+++ b/src/scripts/tauri/setting/acceptance-app/index.js
@@ -0,0 +1,14 @@
+import { createApp } from 'vue/dist/vue.esm-bundler.js';
+import { createTauriTavernAcceptanceApp } from './AcceptanceApp.js';
+
+export function mountTauriTavernAcceptanceApp(mount, options) {
+    if (!(mount instanceof HTMLElement)) {
+        throw new Error('TauriTavern Auto Acceptance mount element is required');
+    }
+    const app = createApp(createTauriTavernAcceptanceApp(options));
+    const instance = app.mount(mount);
+    return {
+        unmount: () => app.unmount(),
+        getRunId: () => instance.runId,
+    };
+}
diff --git a/src/scripts/tauri/setting/acceptance.js b/src/scripts/tauri/setting/acceptance.js
new file mode 100644
index 0000000..0837173
--- /dev/null
+++ b/src/scripts/tauri/setting/acceptance.js
@@ -0,0 +1,58 @@
+import { POPUP_TYPE } from '../../popup.js';
+import { translate } from '../../i18n.js';
+import { downloadBlobWithRuntime } from '../../file-export.js';
+import { callTauriTavernPanelPopup } from './panel-popup.js';
+
+const STYLE_ID = 'tauritavern-acceptance-style';
+
+function getAcceptanceApi() {
+    const api = window.__TAURITAVERN__?.api?.acceptance;
+    if (!api) {
+        throw new Error('TauriTavern Auto Acceptance API is unavailable');
+    }
+    return api;
+}
+
+function ensureStyle() {
+    if (document.getElementById(STYLE_ID)) return;
+    const link = document.createElement('link');
+    link.id = STYLE_ID;
+    link.rel = 'stylesheet';
+    link.href = new URL('./acceptance-app.css', import.meta.url).href;
+    document.head.appendChild(link);
+}
+
+async function importBundle() {
+    return import(new URL('./dist/acceptance.bundle.js', import.meta.url).href);
+}
+
+async function exportReport(api, runId) {
+    const report = await api.getReport(runId);
+    const text = `${JSON.stringify(report, null, 2)}\n`;
+    const blob = new Blob([text], { type: 'application/json' });
+    return downloadBlobWithRuntime(blob, `TauriTavern-Auto-Acceptance-${runId}.json`, {
+        fallbackName: 'tauritavern-auto-acceptance.json',
+    });
+}
+
+export async function openAutoAcceptancePanel() {
+    ensureStyle();
+    const api = getAcceptanceApi();
+    const bundle = await importBundle();
+    const mount = document.createElement('div');
+    const appHandle = bundle.mountTauriTavernAcceptanceApp(mount, {
+        api,
+        tr: translate,
+        exportReport: (runId) => exportReport(api, runId),
+    });
+    try {
+        await callTauriTavernPanelPopup(mount, POPUP_TYPE.TEXT, '', {
+            okButton: translate('Close'),
+            allowVerticalScrolling: true,
+            wide: true,
+            large: true,
+        });
+    } finally {
+        appHandle.unmount();
+    }
+}
