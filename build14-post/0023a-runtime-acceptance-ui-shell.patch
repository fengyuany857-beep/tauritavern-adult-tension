diff --git a/src/tauri/main/api/acceptance.js b/src/tauri/main/api/acceptance.js
new file mode 100644
index 0000000..b6b6149
--- /dev/null
+++ b/src/tauri/main/api/acceptance.js
@@ -0,0 +1,34 @@
+// @ts-check
+
+function createAcceptanceApi({ safeInvoke }) {
+    return {
+        start() {
+            return safeInvoke('acceptance_start');
+        },
+        getStatus(runId = null) {
+            return safeInvoke('acceptance_get_status', { dto: { runId } });
+        },
+        cancel(runId) {
+            return safeInvoke('acceptance_cancel', { dto: { runId } });
+        },
+        getReport(runId) {
+            return safeInvoke('acceptance_get_report', { dto: { runId } });
+        },
+    };
+}
+
+export function installAcceptanceApi(context) {
+    const hostWindow = /** @type {any} */ (window);
+    const hostAbi = hostWindow.__TAURITAVERN__;
+    if (!hostAbi || typeof hostAbi !== 'object') {
+        throw new Error('Host ABI __TAURITAVERN__ is missing');
+    }
+    const safeInvoke = context?.safeInvoke;
+    if (typeof safeInvoke !== 'function') {
+        throw new Error('Tauri main context safeInvoke is missing');
+    }
+    if (!hostAbi.api || typeof hostAbi.api !== 'object') {
+        hostAbi.api = {};
+    }
+    hostAbi.api.acceptance = createAcceptanceApi({ safeInvoke });
+}
