+function mountEditingGuideButton() {
+    if (!window.__TAURITAVERN__ || document.getElementById(GUIDE_BUTTON_ID)) return;
+    const bar = document.querySelector('#avatar_controls .form_create_bottom_buttons_block');
+    const form = document.getElementById('form_create');
+    if (!(bar instanceof HTMLElement) || !(form instanceof HTMLElement)) return;
+
+    const button = document.createElement('button');
+    button.id = GUIDE_BUTTON_ID;
+    button.type = 'button';
+    button.className = 'menu_button menu_button_icon';
+    button.title = t`Export Editing Guide`;
+    button.setAttribute('aria-label', t`Export Editing Guide`);
+    button.innerHTML = '<i class="fa-solid fa-file-lines"></i>';
+    const returnButton = document.getElementById(BUTTON_ID);
+    if (returnButton?.parentElement === bar) returnButton.after(button);
+    else bar.insertBefore(button, document.getElementById('export_button'));
+
+    const sync = () => {
+        const visible = form.getAttribute('actiontype') === 'editcharacter';
+        button.classList.toggle('displayNone', !visible);
+        button.disabled = !visible;
+    };
+    new MutationObserver(sync).observe(form, { attributes: true, attributeFilter: ['actiontype'] });
+    button.addEventListener('click', async (event) => {
+        event.preventDefault();
+        if (button.disabled) return;
+        button.disabled = true;
+        try {
+            await exportEditingGuide();
+        } catch (error) {
+            console.error('[CharacterCardEditingGuide]', error);
+            toast()?.error?.(error instanceof Error ? error.message : String(error));
+        } finally {
+            sync();
+        }
+    });
+    sync();
+}
