+use async_trait::async_trait;
+use tt_domain::errors::DomainError;
+use tt_domain::models::character_card_materialization::{
+    CharacterCardBinding, CharacterCardTransactionJournal, ExportRecord,
+    StagedCharacterCardImport, UndoRecord,
+};
+
+/// Persistence boundary for Character Card Materialization local orchestration.
+/// Portable Character Card bytes are intentionally not an authority source here.
+#[async_trait]
+pub trait CharacterCardMaterializationRepository: Send + Sync {
+    async fn read_binding(
+        &self,
+        binding_id: &str,
+    ) -> Result<Option<CharacterCardBinding>, DomainError>;
+
+    async fn write_binding(&self, binding: &CharacterCardBinding) -> Result<(), DomainError>;
+
+    async fn read_export_record(
+        &self,
+        export_id: &str,
+    ) -> Result<Option<ExportRecord>, DomainError>;
+
+    async fn write_export_record(&self, record: &ExportRecord) -> Result<(), DomainError>;
+
+    async fn read_transaction(
+        &self,
+        transaction_id: &str,
+    ) -> Result<Option<CharacterCardTransactionJournal>, DomainError>;
+
+    async fn write_transaction(
+        &self,
+        journal: &CharacterCardTransactionJournal,
+    ) -> Result<(), DomainError>;
+
+    async fn list_transactions(
+        &self,
+    ) -> Result<Vec<CharacterCardTransactionJournal>, DomainError>;
+
+    async fn write_undo_record(&self, record: &UndoRecord) -> Result<(), DomainError>;
+
+    async fn write_snapshot(&self, bytes: &[u8]) -> Result<String, DomainError>;
+
+    async fn read_snapshot(&self, logical_ref: &str) -> Result<Vec<u8>, DomainError>;
+
+    async fn stage_import(
+        &self,
+        transaction_id: &str,
+        format: &str,
+        bytes: &[u8],
+    ) -> Result<StagedCharacterCardImport, DomainError>;
+
+    async fn read_staged_import(&self, logical_ref: &str) -> Result<Vec<u8>, DomainError>;
+
+    async fn remove_staged_import(&self, logical_ref: &str) -> Result<(), DomainError>;
+
+    /// [EXPORT-LOCAL-ONLY] [LOG-NEVER]
+    async fn load_or_create_origin_secret(&self) -> Result<[u8; 32], DomainError>;
+}
