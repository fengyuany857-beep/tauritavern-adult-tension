diff --git a/src-tauri/crates/tauritavern/src/presentation/commands/acceptance_commands.rs b/src-tauri/crates/tauritavern/src/presentation/commands/acceptance_commands.rs
new file mode 100644
index 0000000..dc4aa2c
--- /dev/null
+++ b/src-tauri/crates/tauritavern/src/presentation/commands/acceptance_commands.rs
@@ -0,0 +1,101 @@
+use std::sync::Arc;
+
+use tauri::State;
+
+use crate::app::AppState;
+use crate::presentation::commands::helpers::{log_command, map_command_error};
+use crate::presentation::errors::CommandError;
+use tt_application::dto::runtime_acceptance_dto::{
+    AcceptanceBuildInfoDto, AcceptanceCancelResultDto, AcceptanceReportDto,
+    AcceptanceRunRequestDto, AcceptanceStartResultDto, AcceptanceStatusDto,
+    AcceptanceStatusRequestDto,
+};
+
+#[tauri::command]
+pub async fn acceptance_start(
+    app_state: State<'_, Arc<AppState>>,
+) -> Result<AcceptanceStartResultDto, CommandError> {
+    log_command("acceptance_start");
+    app_state
+        .services
+        .runtime_acceptance_service
+        .clone()
+        .start(build_info())
+        .await
+        .map_err(map_command_error("Failed to start runtime acceptance"))
+}
+
+#[tauri::command]
+pub async fn acceptance_get_status(
+    dto: AcceptanceStatusRequestDto,
+    app_state: State<'_, Arc<AppState>>,
+) -> Result<AcceptanceStatusDto, CommandError> {
+    log_command("acceptance_get_status");
+    app_state
+        .services
+        .runtime_acceptance_service
+        .get_status(dto.run_id.as_deref())
+        .await
+        .map_err(map_command_error("Failed to read runtime acceptance status"))
+}
+
+#[tauri::command]
+pub async fn acceptance_cancel(
+    dto: AcceptanceRunRequestDto,
+    app_state: State<'_, Arc<AppState>>,
+) -> Result<AcceptanceCancelResultDto, CommandError> {
+    log_command("acceptance_cancel");
+    app_state
+        .services
+        .runtime_acceptance_service
+        .cancel(&dto.run_id)
+        .await
+        .map_err(map_command_error("Failed to cancel runtime acceptance"))
+}
+
+#[tauri::command]
+pub async fn acceptance_get_report(
+    dto: AcceptanceRunRequestDto,
+    app_state: State<'_, Arc<AppState>>,
+) -> Result<AcceptanceReportDto, CommandError> {
+    log_command("acceptance_get_report");
+    app_state
+        .services
+        .runtime_acceptance_service
+        .get_report(&dto.run_id)
+        .await
+        .map_err(map_command_error("Failed to read runtime acceptance report"))
+}
+
+fn build_info() -> AcceptanceBuildInfoDto {
+    AcceptanceBuildInfoDto {
+        platform: platform_name().to_string(),
+        tauri_version: crate::product::VERSION.to_string(),
+        integration_revision: optional(crate::product::GIT_REVISION),
+        git_branch: optional(crate::product::GIT_BRANCH),
+        distribution_flavor: crate::product::DISTRIBUTION_FLAVOR.to_string(),
+        control_sha: crate::product::CONTROL_SHA.and_then(optional),
+        upstream_sha: crate::product::UPSTREAM_SHA.and_then(optional),
+        github_run_id: crate::product::BUILD_RUN_ID.and_then(optional),
+        github_run_number: crate::product::BUILD_RUN_NUMBER.and_then(optional),
+    }
+}
+
+fn optional(value: &str) -> Option<String> {
+    let value = value.trim();
+    (!value.is_empty()).then(|| value.to_string())
+}
+
+fn platform_name() -> &'static str {
+    if cfg!(target_os = "ios") {
+        "ios"
+    } else if cfg!(target_os = "macos") {
+        "macos"
+    } else if cfg!(windows) {
+        "windows"
+    } else if cfg!(target_os = "linux") {
+        "linux"
+    } else {
+        "unknown"
+    }
+}
