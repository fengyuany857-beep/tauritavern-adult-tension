+use std::collections::BTreeMap;
+
+use tt_domain::models::rp_architecture::{
+    CanonChangeClass, CanonChangeSet, CharacterId, LoreAssetStatus, LoreDependencyIndex,
+    LoreDependencyRef, LorePackManifest, LoreRecord, LoreSensitivity, LoreTargetIntent,
+    WorldAssetIdentity, WorldId,
+};
+
+#[test]
+fn canon_changeset_serialization_is_stable() {
+    let change_set = CanonChangeSet {
+        change_set_id: "changeset-1".to_string(),
+        world_id: WorldId("cityschool-core".to_string()),
+        from_canon_revision: 7,
+        to_canon_revision: 8,
+        from_canon_fingerprint: "a".repeat(64),
+        to_canon_fingerprint: "b".repeat(64),
+        changed_entity_refs: vec![CharacterId("yintingchuan".to_string())],
+        added_entity_refs: vec![CharacterId("yintingchuan".to_string())],
+        updated_entity_refs: Vec::new(),
+        removed_entity_refs: Vec::new(),
+        origin_proposal_ids: vec!["proposal-1".to_string()],
+        change_classes: vec![CanonChangeClass::CharacterAdded],
+        created_at_runtime_revision: 42,
+    };
+
+    let value = serde_json::to_value(&change_set).unwrap();
+    assert_eq!(value["changeClasses"][0], "CHARACTER_ADDED");
+    assert_eq!(value["addedEntityRefs"][0], "yintingchuan");
+    let decoded: CanonChangeSet = serde_json::from_value(value).unwrap();
+    assert_eq!(decoded, change_set);
+}
+
+#[test]
+fn lore_registry_contract_keeps_destination_and_sensitivity_explicit() {
+    let record = LoreRecord {
+        lore_id: "lore.character.yintingchuan.overview".to_string(),
+        lore_type: "CHARACTER_OVERVIEW".to_string(),
+        title: "尹听川".to_string(),
+        aliases: vec!["听川".to_string()],
+        source_refs: vec!["canon:character:yintingchuan".to_string()],
+        source_entity_refs: vec![CharacterId("yintingchuan".to_string())],
+        content: "confirmed public identity".to_string(),
+        sensitivity: LoreSensitivity::Restricted,
+        primary_triggers: vec!["尹听川".to_string()],
+        secondary_triggers: vec!["听川".to_string()],
+        collision_risk: "LOW".to_string(),
+        owner_fact_refs: Vec::new(),
+        dependent_lore_refs: Vec::new(),
+        target_intent: LoreTargetIntent::CanonRegistryRef,
+        status: LoreAssetStatus::NeedsRevalidation,
+        source_revision: 8,
+        lore_revision: 1,
+    };
+
+    let value = serde_json::to_value(&record).unwrap();
+    assert_eq!(value["sensitivity"], "RESTRICTED");
+    assert_eq!(value["targetIntent"], "CANON_REGISTRY_REF");
+    assert_eq!(value["status"], "NEEDS_REVALIDATION");
+    assert_eq!(value["type"], "CHARACTER_OVERVIEW");
+}
+
+#[test]
+fn dependency_index_supports_reverse_character_lookup() {
+    let character = CharacterId("yintingchuan".to_string());
+    let lore_id = "lore.character.yintingchuan.overview".to_string();
+    let mut by_entity = BTreeMap::new();
+    by_entity.insert(character.clone(), vec![lore_id.clone()]);
+    let mut by_lore = BTreeMap::new();
+    by_lore.insert(
+        lore_id.clone(),
+        LoreDependencyRef {
+            lore_id: lore_id.clone(),
+            source_entity_refs: vec![character.clone()],
+            dependent_lore_refs: Vec::new(),
+        },
+    );
+    let index = LoreDependencyIndex { by_entity, by_lore };
+
+    assert_eq!(index.by_entity.get(&character), Some(&vec![lore_id]));
+}
+
+#[test]
+fn world_asset_identity_keeps_canon_and_lore_identity_separate() {
+    let lore_pack = LorePackManifest {
+        lore_pack_id: "cityschool-core.characters".to_string(),
+        lore_revision: 3,
+        lore_fingerprint: "c".repeat(64),
+        source_canon_revision: 8,
+        entry_refs: vec!["lore.character.yintingchuan.overview".to_string()],
+    };
+    let identity = WorldAssetIdentity {
+        manifest_revision: 12,
+        canon_revision: 8,
+        canon_fingerprint: "b".repeat(64),
+        asset_revision: 4,
+        asset_fingerprint: "d".repeat(64),
+        lore_pack_refs: vec![lore_pack.lore_pack_id.clone()],
+    };
+
+    assert_eq!(identity.canon_revision, lore_pack.source_canon_revision);
+    assert_ne!(identity.canon_fingerprint, lore_pack.lore_fingerprint);
+}
