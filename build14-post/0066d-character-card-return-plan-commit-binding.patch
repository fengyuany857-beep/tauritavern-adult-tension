+fn validate_return_plan_commit_context(
+    plan: &ReturnImportPlan,
+    staged_ref: &str,
+    format: PortableCharacterCardFormat,
+    replace_avatar: bool,
+    expected_session_id: &SessionId,
+    expected_branch_id: &BranchId,
+) -> Result<(), DomainError> {
+    if plan.staged_import_ref != staged_ref {
+        return Err(DomainError::Conflict(
+            "Character Card Return staged ref does not match the confirmed plan".to_string(),
+        ));
+    }
+    if plan.format != format.as_str() {
+        return Err(DomainError::Conflict(
+            "Character Card Return format does not match the confirmed plan".to_string(),
+        ));
+    }
+    if plan.replace_avatar != replace_avatar {
+        return Err(DomainError::Conflict(
+            "Character Card Return avatar policy does not match the confirmed plan".to_string(),
+        ));
+    }
+    if &plan.session_id != expected_session_id {
+        return Err(DomainError::Conflict(
+            "Character Card Return session does not match the confirmed plan".to_string(),
+        ));
+    }
+    if &plan.branch_id != expected_branch_id {
+        return Err(DomainError::Conflict(
+            "Character Card Return branch does not match the confirmed plan".to_string(),
+        ));
+    }
+    let staged_transaction_id = staged_return_transaction_id(staged_ref, format)?;
+    if staged_transaction_id != plan.transaction_id {
+        return Err(DomainError::Conflict(
+            "Character Card Return preview transaction does not match the confirmed plan"
+                .to_string(),
+        ));
+    }
+    Ok(())
+}
