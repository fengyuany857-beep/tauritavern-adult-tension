+/// [EXPORT-NEVER] Convert a stored/raw card into a portable definition before
+/// Return Metadata is added. Local orchestration and RP authority fields are
+/// removed here, then a separate fail-closed scanner verifies no forbidden
+/// material survived.
+pub fn portable_definition_projection(mut card: Value) -> Value {
+    for key in ["chat", "create_date", "date_added", "fav"] {
+        remove_object_key(&mut card, key);
+    }
+
+    if let Some(data) = card.get_mut("data") {
+        for key in ["chat", "create_date", "date_added", "fav"] {
+            remove_object_key(data, key);
+        }
+        if let Some(extensions) = data.get_mut("extensions").and_then(Value::as_object_mut) {
+            // The local primary World/Lorebook binding is not the embedded
+            // Character Book and must not become portable authority.
+            extensions.remove("world");
+            extensions.remove("fav");
+            // TauriTavern internal namespace is rebuilt from an explicit
+            // portable whitelist after the definition has been sanitized.
+            extensions.remove("tauritavern");
+        }
+    }
+
+    strip_known_internal_keys(&mut card);
+    card
+}
+
+fn strip_known_internal_keys(value: &mut Value) {
+    match value {
+        Value::Array(items) => {
+            for item in items {
+                strip_known_internal_keys(item);
+            }
+        }
+        Value::Object(object) => {
+            for key in [
+                "character_id",
+                "characterId",
+                "worldId",
+                "sessionId",
+                "branchId",
+                "runId",
+                "workspaceId",
+                "toolCallId",
+                "installationId",
+                "control_owner",
+                "controlOwner",
+                "controlPolicy",
+                "safetyState",
+            ] {
+                object.remove(key);
+            }
+            for child in object.values_mut() {
+                strip_known_internal_keys(child);
+            }
+        }
+        _ => {}
+    }
+}
+
+fn remove_object_key(value: &mut Value, key: &str) {
+    if let Some(object) = value.as_object_mut() {
+        object.remove(key);
+    }
+}
+
+/// Add only the v1 portable return-link whitelist. Proof validity never grants
+/// authority and never skips Diff/Preview/user confirmation.
+pub fn attach_portable_return_metadata(
+    card: &mut Value,
+    metadata: &PortableReturnMetadata,
+    annotations: &ExportAnnotations,
+) -> Result<(), String> {
+    metadata.validate_shape()?;
+    let root = card
+        .as_object_mut()
+        .ok_or_else(|| "character card root must be an object".to_string())?;
+    let data = ensure_object(root, "data")?;
+    let extensions = ensure_object(data, "extensions")?;
+    let metadata_value = serde_json::to_value(metadata)
+        .map_err(|error| format!("failed to serialize return metadata: {error}"))?;
+    let annotations_value = serde_json::to_value(annotations)
+        .map_err(|error| format!("failed to serialize export annotations: {error}"))?;
+    extensions.insert(
+        "tauritavern".to_string(),
+        json!({
+            "characterCardLink": {
+                "schemaVersion": CARD_LINK_SCHEMA_VERSION,
+                "returnMetadata": metadata_value,
+                "exportAnnotations": annotations_value,
+            }
+        }),
+    );
+    Ok(())
+}
+
+fn ensure_object<'a>(
+    parent: &'a mut Map<String, Value>,
+    key: &str,
+) -> Result<&'a mut Map<String, Value>, String> {
+    if !parent.contains_key(key) {
+        parent.insert(key.to_string(), Value::Object(Map::new()));
+    }
+    parent
+        .get_mut(key)
+        .and_then(Value::as_object_mut)
+        .ok_or_else(|| format!("character card {key} must be an object"))
+}
+
+/// Canonical definition bytes used for BASE snapshots and baseCardHash.
+/// Formatting, object insertion order and portable Return Metadata do not
+/// influence the digest. Array order remains semantic.
+pub fn canonical_definition_bytes(card: &Value) -> Result<Vec<u8>, String> {
+    let mut value = card.clone();
+    remove_return_metadata_for_hash(&mut value);
+    let mut output = Vec::new();
+    write_canonical_json(&value, &mut output)?;
+    Ok(output)
+}
+
+pub fn canonical_definition_hash(card: &Value) -> Result<String, String> {
+    let bytes = canonical_definition_bytes(card)?;
+    Ok(format!("{:x}", Sha256::digest(bytes)))
+}
+
+fn remove_return_metadata_for_hash(card: &mut Value) {
+    let Some(data) = card.get_mut("data").and_then(Value::as_object_mut) else {
+        return;
+    };
+    let Some(extensions) = data.get_mut("extensions").and_then(Value::as_object_mut) else {
+        return;
+    };
+    let remove_namespace = if let Some(tauri) = extensions.get_mut("tauritavern") {
+        if let Some(tauri_object) = tauri.as_object_mut() {
+            tauri_object.remove("characterCardLink");
+            tauri_object.is_empty()
+        } else {
+            false
+        }
+    } else {
+        false
+    };
+    if remove_namespace {
+        extensions.remove("tauritavern");
+    }
+}
+
+fn write_canonical_json(value: &Value, output: &mut Vec<u8>) -> Result<(), String> {
+    match value {
+        Value::Null => output.extend_from_slice(b"null"),
+        Value::Bool(true) => output.extend_from_slice(b"true"),
+        Value::Bool(false) => output.extend_from_slice(b"false"),
+        Value::Number(number) => output.extend_from_slice(number.to_string().as_bytes()),
+        Value::String(string) => output.extend_from_slice(
+            serde_json::to_string(string)
+                .map_err(|error| format!("failed to canonicalize JSON string: {error}"))?
+                .as_bytes(),
+        ),
+        Value::Array(items) => {
+            output.push(b'[');
+            for (index, item) in items.iter().enumerate() {
+                if index != 0 {
+                    output.push(b',');
+                }
+                write_canonical_json(item, output)?;
+            }
+            output.push(b']');
+        }
+        Value::Object(object) => {
+            output.push(b'{');
+            let mut keys = object.keys().collect::<Vec<_>>();
+            keys.sort_unstable();
+            for (index, key) in keys.into_iter().enumerate() {
+                if index != 0 {
+                    output.push(b',');
+                }
+                output.extend_from_slice(
+                    serde_json::to_string(key)
+                        .map_err(|error| format!("failed to canonicalize JSON key: {error}"))?
+                        .as_bytes(),
+                );
+                output.push(b':');
+                write_canonical_json(&object[key], output)?;
+            }
+            output.push(b'}');
+        }
+    }
+    Ok(())
+}
