+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum PortableSecurityViolation {
+    ProtectedNamespace(String),
+    InternalId(String),
+    AbsolutePath(String),
+    Secret(String),
+    RuntimeState(String),
+    RawHistory(String),
+}
