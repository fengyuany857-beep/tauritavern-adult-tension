+pub fn scan_portable_card(card: &Value) -> Result<(), PortableSecurityViolation> {
+    scan_value(card, &mut Vec::new())
+}
+
+fn scan_value(
+    value: &Value,
+    path: &mut Vec<String>,
+) -> Result<(), PortableSecurityViolation> {
+    match value {
+        Value::String(text) => scan_text(text, path),
+        Value::Array(items) => {
+            for (index, item) in items.iter().enumerate() {
+                path.push(index.to_string());
+                scan_value(item, path)?;
+                path.pop();
+            }
+            Ok(())
+        }
+        Value::Object(object) => {
+            for (key, child) in object {
+                path.push(key.clone());
+                scan_key(key, path)?;
+                if key == "tauritavern" && path_ends_with(path, &["data", "extensions", "tauritavern"])
+                {
+                    validate_tauritavern_namespace(child, path)?;
+                } else {
+                    scan_value(child, path)?;
+                }
+                path.pop();
+            }
+            Ok(())
+        }
+        _ => Ok(()),
+    }
+}
+
+fn scan_key(key: &str, path: &[String]) -> Result<(), PortableSecurityViolation> {
+    let normalized = key.to_ascii_lowercase();
+    let location = path.join(".");
+    if matches!(
+        normalized.as_str(),
+        "character_id" | "characterid" | "worldid" | "sessionid" | "branchid"
+            | "runid" | "workspaceid" | "toolcallid" | "installationid"
+    ) {
+        return Err(PortableSecurityViolation::InternalId(location));
+    }
+    if matches!(
+        normalized.as_str(),
+        "apikey" | "api_key" | "authorization" | "bearer" | "cookie" | "password"
+    ) {
+        return Err(PortableSecurityViolation::Secret(location));
+    }
+    if matches!(
+        normalized.as_str(),
+        "control_owner" | "controlowner" | "controlpolicy" | "safetystate" | "grants" | "boundaries"
+    ) {
+        return Err(PortableSecurityViolation::RuntimeState(location));
+    }
+    Ok(())
+}
+
+fn scan_text(text: &str, path: &[String]) -> Result<(), PortableSecurityViolation> {
+    let lower = text.to_ascii_lowercase();
+    if text.starts_with("/private/var/mobile/")
+        || text.contains("/Containers/Data/Application/")
+        || text.contains("\\AppData\\")
+        || looks_like_windows_absolute_path(text)
+    {
+        return Err(PortableSecurityViolation::AbsolutePath(path.join(".")));
+    }
+    if lower.starts_with("bearer ")
+        || lower.contains("authorization: bearer ")
+        || lower.contains("api_key=")
+        || lower.contains("apikey=")
+    {
+        return Err(PortableSecurityViolation::Secret(path.join(".")));
+    }
+    Ok(())
+}
+
+fn looks_like_windows_absolute_path(text: &str) -> bool {
+    let bytes = text.as_bytes();
+    bytes.len() >= 3
+        && bytes[0].is_ascii_alphabetic()
+        && bytes[1] == b':'
+        && matches!(bytes[2], b'\\' | b'/')
+}
+
+fn validate_tauritavern_namespace(
+    value: &Value,
+    path: &mut Vec<String>,
+) -> Result<(), PortableSecurityViolation> {
+    let Some(namespace) = value.as_object() else {
+        return Err(PortableSecurityViolation::ProtectedNamespace(path.join(".")));
+    };
+    if namespace.keys().any(|key| key != "characterCardLink") {
+        return Err(PortableSecurityViolation::ProtectedNamespace(path.join(".")));
+    }
+    let Some(link) = namespace.get("characterCardLink").and_then(Value::as_object) else {
+        return Err(PortableSecurityViolation::ProtectedNamespace(path.join(".")));
+    };
+    if link.keys().any(|key| {
+        !matches!(
+            key.as_str(),
+            "schemaVersion" | "returnMetadata" | "exportAnnotations"
+        )
+    }) {
+        return Err(PortableSecurityViolation::ProtectedNamespace(path.join(".")));
+    }
+    if link.get("schemaVersion").and_then(Value::as_u64) != Some(CARD_LINK_SCHEMA_VERSION) {
+        return Err(PortableSecurityViolation::ProtectedNamespace(path.join(".")));
+    }
+    for key in ["returnMetadata", "exportAnnotations"] {
+        if let Some(child) = link.get(key) {
+            path.push("characterCardLink".to_string());
+            path.push(key.to_string());
+            scan_value(child, path)?;
+            path.pop();
+            path.pop();
+        }
+    }
+    Ok(())
+}
+
+fn path_ends_with(path: &[String], suffix: &[&str]) -> bool {
+    path.len() >= suffix.len()
+        && path[path.len() - suffix.len()..]
+            .iter()
+            .map(String::as_str)
+            .eq(suffix.iter().copied())
+}
+
+pub fn classify_three_way_field(
+    field_path: impl Into<String>,
+    base: Option<&Value>,
+    local: Option<&Value>,
+    imported: Option<&Value>,
+) -> MergeFieldDecision {
+    let imported_presence = field_presence(imported);
+    let local_presence = field_presence(local);
+    let state = match (base, local, imported) {
+        (None, None, None) => MergeFieldState::Unchanged,
+        (None, Some(_), None) => MergeFieldState::LocalOnly,
+        (None, None, Some(_)) => MergeFieldState::ImportedOnly,
+        (None, Some(local), Some(imported)) if local == imported => MergeFieldState::BothSame,
+        (None, Some(_), Some(_)) => MergeFieldState::Conflict,
+        (Some(_), Some(_), None) => MergeFieldState::FieldMissingImported,
+        (Some(_), None, Some(_)) => MergeFieldState::FieldMissingLocal,
+        (Some(base), Some(local), Some(imported)) if local == base && imported == base => {
+            MergeFieldState::Unchanged
+        }
+        (Some(base), Some(local), Some(imported)) if local != base && imported == base => {
+            MergeFieldState::LocalOnly
+        }
+        (Some(base), Some(local), Some(imported)) if local == base && imported != base => {
+            MergeFieldState::ImportedOnly
+        }
+        (Some(_), Some(local), Some(imported)) if local == imported => MergeFieldState::BothSame,
+        (Some(_), Some(_), Some(_)) => MergeFieldState::Conflict,
+        (Some(_), None, None) => MergeFieldState::FieldMissingImported,
+    };
+    let requires_user_confirmation = matches!(
+        state,
+        MergeFieldState::Conflict
+            | MergeFieldState::FieldMissingImported
+            | MergeFieldState::FieldMissingLocal
+            | MergeFieldState::UnsupportedChange
+    );
+    let resolution = match state {
+        MergeFieldState::Unchanged | MergeFieldState::LocalOnly => local.cloned(),
+        MergeFieldState::ImportedOnly | MergeFieldState::BothSame => imported.cloned(),
+        _ => None,
+    };
+    MergeFieldDecision {
+        field_path: field_path.into(),
+        state,
+        base: base.cloned(),
+        local: local.cloned(),
+        imported: imported.cloned(),
+        imported_presence,
+        local_presence,
+        resolution,
+        requires_user_confirmation,
+    }
+}
+
+fn field_presence(value: Option<&Value>) -> FieldPresence {
+    match value {
+        None => FieldPresence::Missing,
+        Some(Value::String(value)) if value.is_empty() => FieldPresence::Empty,
+        Some(Value::Array(value)) if value.is_empty() => FieldPresence::Empty,
+        Some(Value::Object(value)) if value.is_empty() => FieldPresence::Empty,
+        Some(_) => FieldPresence::Value,
+    }
+}
