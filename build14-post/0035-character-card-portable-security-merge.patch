+use serde::Serialize;
+use serde_json::{Map, Value, json};
+use sha2::{Digest, Sha256};
+use tt_domain::models::character_card_materialization::{
+    FieldPresence, MergeFieldDecision, MergeFieldState, PortableReturnMetadata,
+};
+
+const RETURN_PROOF_DOMAIN: &[u8] = b"tauritavern.character-card-return.v1\0";
+const CARD_LINK_SCHEMA_VERSION: u64 = 1;
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ExportAnnotations {
+    pub draft_mode: String,
+    pub contains_runtime_state: bool,
+    pub contains_chat_transcript: bool,
+    pub contains_internal_rp_identity: bool,
+    pub contains_user_private_messages: bool,
+}
+
+impl Default for ExportAnnotations {
+    fn default() -> Self {
+        Self {
+            draft_mode: "conservative".to_string(),
+            contains_runtime_state: false,
+            contains_chat_transcript: false,
+            contains_internal_rp_identity: false,
+            contains_user_private_messages: false,
+        }
+    }
+}
