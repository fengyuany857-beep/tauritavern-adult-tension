+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn metadata() -> PortableReturnMetadata {
+        PortableReturnMetadata {
+            binding_id: "binding-abc".to_string(),
+            export_id: "export-abc".to_string(),
+            binding_generation: 3,
+            base_card_revision: 7,
+            base_card_hash: "abc123".to_string(),
+            origin_proof: String::new(),
+        }
+    }
+
+    #[test]
+    fn semantic_object_key_order_has_same_hash() {
+        let left = json!({"data":{"name":"Lin","tags":["a","b"]},"spec":"chara_card_v2"});
+        let right: Value = serde_json::from_str(
+            r#"{"spec":"chara_card_v2","data":{"tags":["a","b"],"name":"Lin"}}"#,
+        )
+        .expect("valid json");
+        assert_eq!(
+            canonical_definition_hash(&left).unwrap(),
+            canonical_definition_hash(&right).unwrap()
+        );
+    }
+
+    #[test]
+    fn return_metadata_does_not_change_base_hash() {
+        let clean = json!({"data":{"name":"Lin","extensions":{}}});
+        let mut exported = clean.clone();
+        let mut link = metadata();
+        link.origin_proof = "proof".to_string();
+        attach_portable_return_metadata(&mut exported, &link, &ExportAnnotations::default()).unwrap();
+        assert_eq!(
+            canonical_definition_hash(&clean).unwrap(),
+            canonical_definition_hash(&exported).unwrap()
+        );
+    }
+
+    #[test]
+    fn origin_proof_detects_mutated_locator_tuple() {
+        let secret = b"local-installation-secret-for-test";
+        let mut value = metadata();
+        value.origin_proof = compute_origin_proof(secret, &value);
+        assert!(verify_origin_proof(secret, &value));
+        value.binding_generation += 1;
+        assert!(!verify_origin_proof(secret, &value));
+    }
+
+    #[test]
+    fn origin_proof_does_not_cover_editable_card_body() {
+        let secret = b"local-installation-secret-for-test";
+        let mut value = metadata();
+        value.origin_proof = compute_origin_proof(secret, &value);
+        let mut card = json!({"data":{"name":"Original"}});
+        attach_portable_return_metadata(&mut card, &value, &ExportAnnotations::default()).unwrap();
+        card["data"]["name"] = json!("Edited externally");
+        assert!(verify_origin_proof(secret, &value));
+    }
+
+    #[test]
+    fn portable_projection_strips_internal_identity_and_local_state() {
+        let card = json!({
+            "chat":"chat-file",
+            "characterId":"internal-character",
+            "data":{
+                "name":"Lin",
+                "extensions":{
+                    "world":"local-world-binding",
+                    "fav":true,
+                    "third.party":{"safe":"kept"},
+                    "tauritavern":{"private":"removed"}
+                }
+            }
+        });
+        let projected = portable_definition_projection(card);
+        assert!(projected.get("chat").is_none());
+        assert!(projected.get("characterId").is_none());
+        assert!(projected["data"]["extensions"].get("world").is_none());
+        assert_eq!(projected["data"]["extensions"]["third.party"]["safe"], "kept");
+    }
+
+    #[test]
+    fn scanner_blocks_ios_path_and_secret() {
+        assert!(matches!(
+            scan_portable_card(&json!({"data":{"notes":"/private/var/mobile/Containers/Data/Application/UUID/x"}})),
+            Err(PortableSecurityViolation::AbsolutePath(_))
+        ));
+        assert!(matches!(
+            scan_portable_card(&json!({"data":{"notes":"Authorization: Bearer token"}})),
+            Err(PortableSecurityViolation::Secret(_))
+        ));
+    }
+
+    #[test]
+    fn scanner_allows_only_portable_tauritavern_namespace() {
+        let mut card = json!({"data":{"name":"Lin","extensions":{}}});
+        let mut link = metadata();
+        link.origin_proof = "proof".to_string();
+        attach_portable_return_metadata(&mut card, &link, &ExportAnnotations::default()).unwrap();
+        assert!(scan_portable_card(&card).is_ok());
+        card["data"]["extensions"]["tauritavern"]["control_owner"] = json!("ai");
+        assert!(matches!(
+            scan_portable_card(&card),
+            Err(PortableSecurityViolation::ProtectedNamespace(_))
+        ));
+    }
+
+    #[test]
+    fn three_way_merge_handles_imported_only_local_only_and_conflict() {
+        let base = json!("base");
+        let local = json!("local");
+        let imported = json!("imported");
+        assert_eq!(
+            classify_three_way_field("personality", Some(&base), Some(&base), Some(&imported)).state,
+            MergeFieldState::ImportedOnly
+        );
+        assert_eq!(
+            classify_three_way_field("personality", Some(&base), Some(&local), Some(&base)).state,
+            MergeFieldState::LocalOnly
+        );
+        assert_eq!(
+            classify_three_way_field("personality", Some(&base), Some(&local), Some(&imported)).state,
+            MergeFieldState::Conflict
+        );
+    }
+
+    #[test]
+    fn imported_missing_never_silently_deletes_local() {
+        let base = json!("base");
+        let local = json!("local");
+        let decision = classify_three_way_field("description", Some(&base), Some(&local), None);
+        assert_eq!(decision.state, MergeFieldState::FieldMissingImported);
+        assert!(decision.requires_user_confirmation);
+        assert!(decision.resolution.is_none());
+    }
+
+    #[test]
+    fn empty_and_missing_remain_distinct() {
