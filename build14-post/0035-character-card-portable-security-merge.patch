+/// originProof authenticates only the exported return locator/base tuple. It
+/// intentionally does not authenticate the card's current editable body.
+pub fn compute_origin_proof(secret: &[u8], metadata: &PortableReturnMetadata) -> String {
+    let mut message = Vec::from(RETURN_PROOF_DOMAIN);
+    append_proof_component(&mut message, metadata.binding_id.as_bytes());
+    append_proof_component(&mut message, metadata.export_id.as_bytes());
+    append_proof_component(
+        &mut message,
+        metadata.binding_generation.to_string().as_bytes(),
+    );
+    append_proof_component(
+        &mut message,
+        metadata.base_card_revision.to_string().as_bytes(),
+    );
+    append_proof_component(&mut message, metadata.base_card_hash.as_bytes());
+    hex_lower(&hmac_sha256(secret, &message))
+}
+
+pub fn verify_origin_proof(secret: &[u8], metadata: &PortableReturnMetadata) -> bool {
+    let expected = compute_origin_proof(secret, metadata);
+    constant_time_eq(expected.as_bytes(), metadata.origin_proof.as_bytes())
+}
+
+fn append_proof_component(output: &mut Vec<u8>, value: &[u8]) {
+    output.extend_from_slice(&(value.len() as u64).to_be_bytes());
+    output.extend_from_slice(value);
+}
+
+fn hmac_sha256(secret: &[u8], message: &[u8]) -> [u8; 32] {
+    const BLOCK: usize = 64;
+    let mut key = [0u8; BLOCK];
+    if secret.len() > BLOCK {
+        key[..32].copy_from_slice(&Sha256::digest(secret));
+    } else {
+        key[..secret.len()].copy_from_slice(secret);
+    }
+    let mut inner_pad = [0x36u8; BLOCK];
+    let mut outer_pad = [0x5cu8; BLOCK];
+    for index in 0..BLOCK {
+        inner_pad[index] ^= key[index];
+        outer_pad[index] ^= key[index];
+    }
+    let mut inner = Sha256::new();
+    inner.update(inner_pad);
+    inner.update(message);
+    let inner_digest = inner.finalize();
+    let mut outer = Sha256::new();
+    outer.update(outer_pad);
+    outer.update(inner_digest);
+    outer.finalize().into()
+}
+
+fn hex_lower(bytes: &[u8]) -> String {
+    let mut output = String::with_capacity(bytes.len() * 2);
+    for byte in bytes {
+        use std::fmt::Write as _;
+        let _ = write!(&mut output, "{byte:02x}");
+    }
+    output
+}
+
+fn constant_time_eq(left: &[u8], right: &[u8]) -> bool {
+    if left.len() != right.len() {
+        return false;
+    }
+    let mut difference = 0u8;
+    for (left, right) in left.iter().zip(right) {
+        difference |= left ^ right;
+    }
+    difference == 0
+}
