+test('Auto Acceptance inline Vue expressions are syntactically parseable', () => {
+    const app = read('src/scripts/tauri/setting/acceptance-app/AcceptanceApp.js');
+    const expressions = [...app.matchAll(/\{\{([\s\S]*?)\}\}/g)]
+        .map((match) => match[1].trim());
+
+    assert.ok(expressions.length > 0, 'expected Vue interpolation expressions');
+    for (const expression of expressions) {
+        assert.doesNotThrow(
+            () => new Function(`return (${expression});`),
+            `invalid Vue interpolation: ${expression}`,
+        );
+    }
+});
+
