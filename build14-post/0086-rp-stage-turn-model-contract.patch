diff --git a/tests/rp-stage-turn-active-hotfix.test.mjs b/tests/rp-stage-turn-active-hotfix.test.mjs
new file mode 100644
index 0000000..d2b8b23
--- /dev/null
+++ b/tests/rp-stage-turn-active-hotfix.test.mjs
@@ -0,0 +1,36 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+
+const read = (path) => fs.readFileSync(new URL(`../${path}`, import.meta.url), 'utf8');
+const descriptor = read('src-tauri/crates/tt-application/src/services/agent_tools/rp/descriptors.rs');
+const state = read('src-tauri/crates/tt-application/src/services/agent_tools/rp/state.rs');
+const profile = read('src-tauri/crates/tt-application/src/services/agent_profile_service/defaults.rs');
+
+test('rp.stage_turn model contract names the strict schema and rejects the npcs alias', () => {
+    assert.match(descriptor, /RP_STAGE_TURN_MODEL_CONTRACT_V1/);
+    assert.match(descriptor, /field is npc_updates, never npcs/);
+    assert.match(descriptor, /additionalProperties": false/);
+    assert.match(descriptor, /event_derived only with an exact id/);
+    assert.match(descriptor, /existing only with an exact active accepted fact id/);
+    assert.match(state, /#\[serde\(rename_all = "snake_case", deny_unknown_fields\)\]\s*struct StageTurnArgs/);
+});
+
+test('stage repair is schema-guided, bounded, single-success, and fail-closed before render', () => {
+    assert.match(profile, /RP_STAGE_TURN_MODEL_CONTRACT_V1/);
+    assert.match(profile, /repair it from the exact error, the original rp\.state, and the tool schema/);
+    assert.match(profile, /at most 3 stage attempts and at most one successful stage/);
+    assert.match(profile, /render only the successfully staged beat/);
+    assert.match(profile, /after exhaustion fail closed without rendering unstaged prose/);
+    assert.match(profile, /rp\.state -> plan -> rp\.stage_turn -> render/);
+    assert.match(profile, /max_calls_per_tool\.insert\("rp\.stage_turn"\.to_string\(\), 3\)/);
+});
+
+test('authority and provenance remain Runtime-owned rather than model-invented', () => {
+    assert.match(descriptor, /rp\.state\.active_grants/);
+    assert.match(descriptor, /Do not manufacture grant ids/);
+    assert.match(descriptor, /Never invent turn\/beat references/);
+    assert.match(state, /fn validate_fact_provenance/);
+    assert.match(state, /fn validate_knowledge_provenance/);
+    assert.match(state, /fn validate_stage_against_state/);
+});
