+    /// Resolve interrupted Return transactions before the host exposes any
+    /// Character Card commands. A transaction at or beyond the durable export
+    /// boundary may roll forward only when exact Card, binding, export and Undo
+    /// ownership are all still provable. Everything earlier rolls back.
+    pub async fn recover_incomplete_returns(&self) -> Result<(), DomainError> {
+        let _commit_guard = self.return_commit_lock.lock().await;
+        let transactions = self.materialization.list_transactions().await?;
+        for mut journal in transactions {
+            match journal.state {
+                CharacterCardTransactionState::Committed
+                | CharacterCardTransactionState::RolledBack => continue,
+                CharacterCardTransactionState::RollbackFailed => {
+                    return Err(DomainError::Conflict(format!(
+                        "Character Card Return transaction {} has an unresolved rollback failure",
+                        journal.transaction_id
+                    )));
+                }
+                CharacterCardTransactionState::IndexesInvalidated
+                | CharacterCardTransactionState::ReadbackVerified => {
+                    if self
+                        .return_is_fully_owned_for_recovery(&journal)
+                        .await?
+                    {
+                        advance_return_journal(
+                            &*self.materialization,
+                            &mut journal,
+                            CharacterCardTransactionState::Committed,
+                        )
+                        .await?;
+                        continue;
+                    }
+                }
+                _ => {}
+            }
+
+            self.rollback_return_transaction(&mut journal).await?;
+        }
+        Ok(())
+    }
+
+    async fn return_is_fully_owned_for_recovery(
+        &self,
+        journal: &CharacterCardTransactionJournal,
+    ) -> Result<bool, DomainError> {
+        let (
+            Some(card_before_ref),
+            Some(binding_before_ref),
+            Some(expected_card_hash),
+            Some(expected_png_hash),
+            Some(expected_binding_hash),
+            Some(export_id),
+        ) = (
+            journal.before_card_ref.as_deref(),
+            journal.before_binding_ref.as_deref(),
+            journal.expected_after_card_hash.as_deref(),
+            journal.expected_after_png_hash.as_deref(),
+            journal.expected_after_binding_hash.as_deref(),
+            journal.export_id.as_deref(),
+        ) else {
+            return Ok(false);
+        };
+
+        let Some(undo) = self
+            .materialization
+            .read_undo_record(&journal.transaction_id)
+            .await?
+        else {
+            return Ok(false);
+        };
+        if undo.transaction_id.as_str() != journal.transaction_id.as_str()
+            || undo.card_before_ref.as_str() != card_before_ref
+            || undo.binding_before_ref.as_str() != binding_before_ref
+            || undo.profile_before_ref.as_deref() != journal.before_profile_ref.as_deref()
+            || undo.expected_after_card_hash.as_str() != expected_card_hash
+            || undo.expected_after_profile_hash.is_some()
+        {
+            return Ok(false);
+        }
+
+        let Some(binding) = self.materialization.read_binding(&journal.binding_id).await? else {
+            return Ok(false);
+        };
+        if binding_state_hash(&binding)? != expected_binding_hash {
+            return Ok(false);
+        }
+        let png = self.cards.read_card_png_bytes(&binding.card_storage_identity).await?;
+        if sha256_hex(&png) != expected_png_hash {
+            return Ok(false);
+        }
+        let card_text = self.cards.read_card_json(&binding.card_storage_identity).await?;
+        let card = parse_json_card(card_text.as_bytes())?;
+        let card_hash = canonical_definition_hash(&portable_definition_projection(card))
+            .map_err(DomainError::InvalidData)?;
+        if card_hash != expected_card_hash {
+            return Ok(false);
+        }
+
+        let Some(export) = self.materialization.read_export_record(export_id).await? else {
+            return Ok(false);
+        };
+        Ok(export.transaction_id.as_deref() == Some(journal.transaction_id.as_str()))
+    }
+
