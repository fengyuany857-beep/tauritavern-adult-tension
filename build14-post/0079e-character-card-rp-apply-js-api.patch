     }
     await script.saveChat({ commitReason });
 }
+
+/**
+ * Switch the currently selected chat branch to a prepared immutable persistent
+ * state without rewriting message provenance. The backend performs the final
+ * readback and Binding sync update after this host commit succeeds.
+ *
+ * @param {{ stableChatId: string; baseStateId: string; preparedStateId: string; transactionId: string; changeCount?: number }} input
+ */
+export async function commitPreparedPersistentStateToActiveChat(input) {
+    const stableChatId = requirePayloadString(input, 'stableChatId');
+    const baseStateId = requirePayloadString(input, 'baseStateId');
+    const preparedStateId = requirePayloadString(input, 'preparedStateId');
+    const transactionId = requirePayloadString(input, 'transactionId');
+    const currentRef = window.__TAURITAVERN__?.api?.chat?.current?.ref?.();
+    const currentStableChatId = await resolveStableChatId(currentRef);
+    if (currentStableChatId !== stableChatId) {
+        throw new Error('CARD_RP_HOST_CHAT_MISMATCH: active chat changed before persistent-state commit');
+    }
+
+    const script = await loadMainScript();
+    if (!Array.isArray(script.chat)) {
+        throw new Error('CARD_RP_HOST_CHAT_INVALID: active chat is unavailable');
+    }
+    let messageId = -1;
+    for (let index = script.chat.length - 1; index >= 0; index -= 1) {
+        const agent = script.chat[index]?.extra?.tauritavern?.agent;
+        if (agent?.persistStateStatus === 'committed' && agent?.persistStateId === baseStateId) {
+            messageId = index;
+            break;
+        }
+    }
+    if (messageId < 0) {
+        throw new Error('CARD_RP_HOST_BASE_STATE_MISSING: selected persistent-state message is no longer present');
+    }
+
+    const message = script.chat[messageId];
+    const extra = {
+        tauritavern: {
+            agent: {
+                persistStateId: preparedStateId,
+                persistBaseStateId: baseStateId,
+                persistStateStatus: 'committed',
+                persistChangeCount: Number(input?.changeCount ?? 0),
+                profileMutation: {
+                    type: 'character_card_apply',
+                    transactionId,
+                },
+            },
+        },
+    };
+    message.extra = mergePlainObject(message.extra, extra);
+    const swipeId = Number(message.swipe_id);
+    if (Array.isArray(message.swipe_info) && Number.isInteger(swipeId) && message.swipe_info[swipeId]) {
+        message.swipe_info[swipeId].extra = structuredClone(message.extra);
+    }
+    await persistActiveChat(script, CHAT_COMMIT_REASON.MUTATION);
+    return { messageId, preparedStateId, transactionId };
+}
