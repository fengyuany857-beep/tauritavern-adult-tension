diff --git a/src/tauri/main/api/character-cards.js b/src/tauri/main/api/character-cards.js
--- a/src/tauri/main/api/character-cards.js
+++ b/src/tauri/main/api/character-cards.js
@@ -128,10 +128,82 @@ function createCharacterCardsApi({
         return pickDesktopFiles(options);
     }
 
+    async function returnBytes(file) {
+        if (!file || typeof file.arrayBuffer !== 'function') {
+            throw new Error('Character Card Return requires a readable File');
+        }
+        const bytes = new Uint8Array(await file.arrayBuffer());
+        return Array.from(bytes);
+    }
+
+    function returnFormat(file) {
+        return characterCardExtension(requireNonEmptyString(file?.name, 'character card file name'));
+    }
+
+    async function previewReturnImport(file, { userIndicatedReturn = true } = {}) {
+        return safeInvoke('preview_character_card_return', {
+            bytes: await returnBytes(file),
+            format: returnFormat(file),
+            user_indicated_return: Boolean(userIndicatedReturn),
+        });
+    }
+
+    async function planReturnImport({
+        stagedRef,
+        format,
+        replaceAvatar,
+        sessionId,
+        branchId,
+        choices = {},
+    }) {
+        return safeInvoke('plan_character_card_return', {
+            request: {
+                stagedRef: requireNonEmptyString(stagedRef, 'Character Card Return staged ref'),
+                format: requireNonEmptyString(format, 'Character Card Return format'),
+                replaceAvatar: Boolean(replaceAvatar),
+                sessionId: requireNonEmptyString(sessionId, 'Character Card Return session id'),
+                branchId: requireNonEmptyString(branchId, 'Character Card Return branch id'),
+                choices,
+            },
+        });
+    }
+
+    async function commitReturnImport({
+        stagedRef,
+        format,
+        replaceAvatar,
+        suppliedPlan,
+        sessionId,
+        branchId,
+        choices = {},
+    }) {
+        if (!suppliedPlan || typeof suppliedPlan !== 'object') {
+            throw new Error('Character Card Return confirmed plan is required');
+        }
+        return safeInvoke('commit_character_card_return', {
+            request: {
+                stagedRef: requireNonEmptyString(stagedRef, 'Character Card Return staged ref'),
+                format: requireNonEmptyString(format, 'Character Card Return format'),
+                replaceAvatar: Boolean(replaceAvatar),
+                suppliedPlan,
+                sessionId: requireNonEmptyString(sessionId, 'Character Card Return session id'),
+                branchId: requireNonEmptyString(branchId, 'Character Card Return branch id'),
+                choices,
+            },
+        });
+    }
+
+    async function discardReturnPreview(stagedRef) {
+        return safeInvoke('discard_character_card_return_preview', {
+            logical_ref: requireNonEmptyString(stagedRef, 'Character Card Return staged ref'),
+        });
+    }
+
     return {
         isNativePickerAvailable,
         pickFiles,
+        previewReturnImport,
+        planReturnImport,
+        commitReturnImport,
+        discardReturnPreview,
     };
 }
