+    /** @param {{ stableChatId: string; characterId: string }} input */
+    async function resumeMaterializationDraft({ stableChatId, characterId }) {
+        return safeInvoke('resume_character_card_draft', {
+            stable_chat_id: requireNonEmptyString(stableChatId, 'Character Card draft stable chat id'),
+            character_id: requireNonEmptyString(characterId, 'Character Card draft character id'),
+        });
+    }
+
+    /**
+     * @param {{ cas: TauriTavernCharacterCardDraftCas; draftId: string; expectedDraftRevision: number; definition: Record<string, unknown> }} input
+     */
+    async function saveMaterializationDraft({ cas, draftId, expectedDraftRevision, definition }) {
+        if (!cas || typeof cas !== 'object' || Array.isArray(cas)) {
+            throw new Error('Character Card draft CAS is required');
+        }
+        if (!Number.isSafeInteger(expectedDraftRevision) || expectedDraftRevision < 1) {
+            throw new Error('Character Card expected draft revision must be a positive integer');
+        }
+        if (!definition || typeof definition !== 'object' || Array.isArray(definition)) {
+            throw new Error('Character Card draft definition is required');
+        }
+        return safeInvoke('save_character_card_draft', {
+            request: {
+                cas,
+                draftId: requireNonEmptyString(draftId, 'Character Card draft id'),
+                expectedDraftRevision,
+                definition,
+            },
+        });
+    }
+
+    /** @param {{ stableChatId: string; characterId: string }} input */
+    async function regenerateMaterializationDraft({ stableChatId, characterId }) {
+        return safeInvoke('regenerate_character_card_draft', {
+            stable_chat_id: requireNonEmptyString(stableChatId, 'Character Card draft stable chat id'),
+            character_id: requireNonEmptyString(characterId, 'Character Card draft character id'),
+        });
+    }
+
+    /**
+     * @param {{ stableChatId: string; characterId: string; draftId: string; expectedDraftRevision: number }} input
+     */
+    async function archiveMaterializationDraft({ stableChatId, characterId, draftId, expectedDraftRevision }) {
+        if (!Number.isSafeInteger(expectedDraftRevision) || expectedDraftRevision < 1) {
+            throw new Error('Character Card expected draft revision must be a positive integer');
+        }
+        return safeInvoke('archive_character_card_draft', {
+            request: {
+                stableChatId: requireNonEmptyString(stableChatId, 'Character Card draft stable chat id'),
+                characterId: requireNonEmptyString(characterId, 'Character Card draft character id'),
+                draftId: requireNonEmptyString(draftId, 'Character Card draft id'),
+                expectedDraftRevision,
+            },
+        });
+    }
+
