+    async fn case_retraction(&self, ctx: &SuiteContext) -> Result<CaseRunResult, ApplicationError> {
+        let root = self.create_run(ctx, "retract-root", None, &ctx.base_prompt).await?;
+        let staged = self.rp_call(ctx, &root.id, &ctx.base_prompt, "rp.stage_turn", json!({
+            "beat_summary":"Synthetic beat to retract.","advances_story":true,
+            "events":[{"id":"acceptance-event-r","summary":"temporary event","status":"resolved"}],
+            "facts":[{"id":"acceptance-fact-r","subject":"red-door","predicate":"opened","value":true,"source":{"kind":"user_asserted","reference":"synthetic input"}}]
+        })).await?;
+        require_success(&staged, "rp.retraction_pair.root")?;
+        let committed = ctx.sandbox.workspace_repository.commit_persistent_changes(&root.id).await?;
+
+        let correction = self.create_run(ctx, "retract-correction", Some(committed.state_id.clone()), &ctx.base_prompt).await?;
+        let corrected = self.rp_call(ctx, &correction.id, &ctx.base_prompt, "rp.stage_turn", json!({
+            "beat_summary":"Retract synthetic prior beat.","advances_story":false,
+            "retract_turns":[1],"retraction_reason":"synthetic user correction"
+        })).await?;
+        require_success(&corrected, "rp.retraction_pair.correct")?;
+        let state = self.rp_call(ctx, &correction.id, &ctx.base_prompt, "rp.state", json!({})).await?;
+        require_success(&state, "rp.retraction_pair.state")?;
+        if state.structured.get("recentRetractions").and_then(Value::as_array).map(Vec::len).unwrap_or(0) == 0 {
+            return Err(ApplicationError::ValidationError("acceptance.retraction_missing: successful correction did not record a retraction".to_string()));
+        }
+
+        let invalid = self.create_run(ctx, "retract-invalid", Some(committed.state_id), &ctx.base_prompt).await?;
+        let future = self.rp_call(ctx, &invalid.id, &ctx.base_prompt, "rp.stage_turn", json!({
+            "beat_summary":"Invalid future retraction.","advances_story":false,
+            "retract_turns":[99],"retraction_reason":"invalid synthetic target"
+        })).await?;
+        if !future.is_error { return Err(ApplicationError::ValidationError("acceptance.invalid_retraction_accepted".to_string())); }
+        Ok(CaseRunResult::pass("Accepted history retracts through the runtime checkpoint path and an invalid future target is rejected."))
+    }
