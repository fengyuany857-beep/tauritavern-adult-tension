+    async fn case_world_binding(&self, ctx: &SuiteContext) -> Result<CaseRunResult, ApplicationError> {
+        let root = self.create_run(ctx, "world-root", None, &ctx.base_prompt).await?;
+        let bind = self.rp_call(ctx, &root.id, &ctx.base_prompt, "rp.stage_turn", json!({"beat_summary":"Bind synthetic world.","advances_story":true})).await?;
+        require_success(&bind, "world.binding_matrix.bind")?;
+        let committed = ctx.sandbox.workspace_repository.commit_persistent_changes(&root.id).await?;
+
+        let same = self.create_run(ctx, "world-same", Some(committed.state_id.clone()), &ctx.base_prompt).await?;
+        require_success(&self.rp_call(ctx, &same.id, &ctx.base_prompt, "rp.state", json!({})).await?, "world.binding_matrix.same")?;
+
+        let other_prompt = prompt_for_world("acceptance-world-b", 1, "acceptance-fp-a", false, "Synthetic acceptance input.");
+        let other = self.create_run(ctx, "world-other", Some(committed.state_id.clone()), &other_prompt).await?;
+        let mismatch = self.rp_call(ctx, &other.id, &other_prompt, "rp.state", json!({})).await?;
+        require_error_code(&mismatch, "rp.world_binding_mismatch")?;
+
+        let divergent_prompt = prompt_for_world("acceptance-world-a", 2, "acceptance-fp-b", false, "Synthetic acceptance input.");
+        let divergent = self.create_run(ctx, "world-divergent", Some(committed.state_id.clone()), &divergent_prompt).await?;
+        let divergence = self.rp_call(ctx, &divergent.id, &divergent_prompt, "rp.state", json!({})).await?;
+        require_error_code(&divergence, "rp.world_revision_diverged")?;
+
+        let ambiguous_prompt = prompt_for_world("acceptance-world-a", 1, "acceptance-fp-a", true, "Synthetic acceptance input.");
+        let ambiguous = self.create_run(ctx, "world-ambiguous", Some(committed.state_id), &ambiguous_prompt).await?;
+        let ambiguity = self.rp_call(ctx, &ambiguous.id, &ambiguous_prompt, "rp.state", json!({})).await?;
+        require_error_code(&ambiguity, "rp.world_manifest_ambiguous")?;
+        Ok(CaseRunResult::pass("Matching, world mismatch, revision divergence, and ambiguous-manifest paths are distinguished."))
+    }
