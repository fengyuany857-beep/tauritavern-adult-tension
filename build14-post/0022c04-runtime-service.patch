+    async fn case_knowledge_provenance(&self, ctx: &SuiteContext) -> Result<CaseRunResult, ApplicationError> {
+        let run = self.create_run(ctx, "knowledge", None, &ctx.base_prompt).await?;
+        let rejected = self.rp_call(ctx, &run.id, &ctx.base_prompt, "rp.stage_turn", json!({
+            "beat_summary":"Synthetic unsupported knowledge.","advances_story":true,
+            "knowledge":[{"character_id":"npc-a","subject":"blue-key","predicate":"serial","state":"knows"}]
+        })).await?;
+        require_error_code(&rejected, "rp.knowledge_provenance_required")?;
+        let accepted = self.rp_call(ctx, &run.id, &ctx.base_prompt, "rp.stage_turn", json!({
+            "beat_summary":"NPC A directly observes the blue key.","advances_story":true,
+            "facts":[{"id":"acceptance-knowledge-fact","subject":"blue-key","predicate":"serial","value":"KT-71839","source":{"kind":"observed","reference":"current beat"}}],
+            "knowledge":[{"character_id":"npc-a","subject":"blue-key","predicate":"serial","state":"knows","fact_id":"acceptance-knowledge-fact","source":{"kind":"observed","reference":"current beat"}}]
+        })).await?;
+        require_success(&accepted, "rp.knowledge_provenance_pair.accepted")?;
+        Ok(CaseRunResult::pass("Missing provenance is rejected and explicit observed provenance is accepted."))
+    }
