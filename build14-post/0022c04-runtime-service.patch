+    async fn case_stage_recall(&self, ctx: &SuiteContext) -> Result<CaseRunResult, ApplicationError> {
+        let run = self.create_run(ctx, "stage-recall", None, &ctx.base_prompt).await?;
+        let staged = self.rp_call(ctx, &run.id, &ctx.base_prompt, "rp.stage_turn", json!({
+            "beat_summary":"Acceptance NPC observes blue key.",
+            "advances_story":true,
+            "facts":[{"id":"acceptance-fact-a","subject":"blue-key","predicate":"serial","value":"KT-71839","source":{"kind":"user_asserted","reference":"synthetic acceptance user fact"}}]
+        })).await?;
+        require_success(&staged, "rp.stage_recall_roundtrip.stage")?;
+        let readback = self.rp_call(ctx, &run.id, &ctx.base_prompt, "rp.state", json!({})).await?;
+        require_success(&readback, "rp.stage_recall_roundtrip.state")?;
+        let recall = self.rp_call(ctx, &run.id, &ctx.base_prompt, "rp.recall", json!({"query":"blue-key","limit":5})).await?;
+        require_success(&recall, "rp.stage_recall_roundtrip.recall")?;
+        let hits = recall.structured.get("hits").and_then(Value::as_array).map(Vec::len).unwrap_or(0);
+        if hits == 0 { return Err(ApplicationError::ValidationError("acceptance.rp_recall_empty: staged fact was not recalled".to_string())); }
+        Ok(CaseRunResult::pass("Stage, state readback, and recall traversed the production RP path."))
+    }
