+    async fn case_pause_gate(&self, ctx: &SuiteContext) -> Result<CaseRunResult, ApplicationError> {
+        let root = self.create_run(ctx, "pause-root", None, &ctx.base_prompt).await?;
+        let paused = self.rp_call(ctx, &root.id, &ctx.base_prompt, "rp.stage_turn", json!({
+            "beat_summary":"Pause synthetic session.","advances_story":false,
+            "authority":{"safety_state":"paused"}
+        })).await?;
+        require_success(&paused, "rp.authority_pause_gate.pause")?;
+        let committed = ctx.sandbox.workspace_repository.commit_persistent_changes(&root.id).await?;
+        let child = self.create_run(ctx, "pause-child", Some(committed.state_id), &ctx.base_prompt).await?;
+        let blocked = self.rp_call(ctx, &child.id, &ctx.base_prompt, "rp.stage_turn", json!({
+            "beat_summary":"Attempt to advance while paused.","advances_story":true
+        })).await?;
+        require_error_code(&blocked, "rp.stage_rejected")?;
+        Ok(CaseRunResult::pass("Paused authority blocks story advancement until an explicit resume."))
+    }
