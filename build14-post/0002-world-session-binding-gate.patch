+fn binding_status(state: &RpState, manifest: Option<&tt_domain::models::rp_architecture::WorldManifest>) -> RuntimeBindingStatus {
+    if state.session.is_some() {
+        RuntimeBindingStatus::Bound
+    } else if manifest.is_some() {
+        RuntimeBindingStatus::ManifestAvailable
+    } else {
+        RuntimeBindingStatus::LegacyUnbound
+    }
+}
+
+fn state_has_continuity(state: &RpState) -> bool {
+    state.runtime_revision > 0
+        || state.turn > 0
+        || state.clock.is_some()
+        || state.scene_id.is_some()
+        || state.scene.is_some()
+        || state.location.is_some()
+        || !state.participants.is_empty()
+        || !state.npcs.is_empty()
+        || !state.events.is_empty()
+        || !state.facts.is_empty()
+        || !state.knowledge.is_empty()
+        || !state.commitments.is_empty()
+        || !state.threads.is_empty()
+        || !state.recent_beats.is_empty()
+        || !state.retractions.is_empty()
+}
+
+fn ensure_stage_session_binding(
+    state: &mut RpState,
+    stable_chat_id: &str,
+    manifest: Option<&tt_domain::models::rp_architecture::WorldManifest>,
+) -> Result<(), super::binding::BindingFailure> {
+    if let Some(session) = state.session.as_mut() {
+        validate_bound_session(session, manifest)?;
+        session.active_branch_id = BranchId(stable_chat_id.to_string());
+        return Ok(());
+    }
+
+    let Some(manifest) = manifest else {
+        // Build #13 compatibility mode. Legacy worlds remain playable until a
+        // first-class World Manifest is adopted; once a Session is bound, the
+        // manifest gate becomes fail-closed on every subsequent RP tool call.
+        return Ok(());
+    };
+
+    if state_has_continuity(state) {
+        return Err(super::binding::BindingFailure {
+            code: "rp.session_binding_required",
+            message: format!(
+                "SESSION_NOT_BOUND: this branch already contains legacy RP continuity but now exposes World Manifest `{}`. Refusing to silently adopt existing facts into that world. Start a fresh session or perform an explicit legacy-session migration.",
+                manifest.world_id.0
+            ),
+        });
+    }
+
+    state.session = Some(SessionIdentity {
+        schema_version: RP_ARCHITECTURE_SCHEMA_VERSION,
+        session_id: SessionId(format!("session-{}", Uuid::new_v4())),
+        world_id: manifest.world_id.clone(),
+        bound_canon_revision: manifest.canon_revision,
+        bound_canon_fingerprint: manifest.canon_fingerprint.clone(),
+        session_status: SessionStatus::Active,
+        host_chat_id: Some(stable_chat_id.to_string()),
+        active_branch_id: BranchId(stable_chat_id.to_string()),
+    });
+    Ok(())
+}
