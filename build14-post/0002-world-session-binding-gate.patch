+    fn world_manifest(world: &str, revision: u64, fingerprint: &str) -> tt_domain::models::rp_architecture::WorldManifest {
+        tt_domain::models::rp_architecture::WorldManifest {
+            schema_version: RP_ARCHITECTURE_SCHEMA_VERSION,
+            world_id: tt_domain::models::rp_architecture::WorldId(world.to_string()),
+            title: world.to_string(),
+            manifest_revision: 1,
+            canon_revision: revision,
+            canon_fingerprint: fingerprint.to_string(),
+            immutable_rules: Vec::new(),
+            canon_entity_refs: Vec::new(),
+            lore_pack_refs: Vec::new(),
+            compatibility: BTreeMap::new(),
