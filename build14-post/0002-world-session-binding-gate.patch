diff --git a/src-tauri/crates/tt-application/src/services/agent_tools/rp/binding.rs b/src-tauri/crates/tt-application/src/services/agent_tools/rp/binding.rs
new file mode 100644
index 0000000..0c0f2ae
--- /dev/null
+++ b/src-tauri/crates/tt-application/src/services/agent_tools/rp/binding.rs
@@ -0,0 +1,231 @@
+use serde::Serialize;
+use serde_json::Value;
+use tt_domain::models::rp_architecture::{
+    RP_ARCHITECTURE_SCHEMA_VERSION, SessionIdentity, WorldBindingDecision, WorldManifest,
+    check_world_binding,
+};
+
+pub(super) const WORLD_MANIFEST_DISPLAY_NAME: &str = "TauriTavern World Manifest";
+
+#[derive(Debug, Clone, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub(super) enum RuntimeBindingStatus {
+    LegacyUnbound,
+    ManifestAvailable,
+    Bound,
+}
+
+#[derive(Debug, Clone)]
+pub(super) struct BindingFailure {
+    pub(super) code: &'static str,
+    pub(super) message: String,
+}
+
+pub(super) fn active_world_manifest(
+    prompt_snapshot: &Value,
+) -> Result<Option<WorldManifest>, BindingFailure> {
+    let Some(entries) = prompt_snapshot
+        .get("worldInfoActivation")
+        .and_then(|batch| batch.get("entries"))
+        .and_then(Value::as_array)
+    else {
+        return Ok(None);
+    };
+
+    let mut manifests = Vec::new();
+    for (index, entry) in entries.iter().enumerate() {
+        let Some(object) = entry.as_object() else {
+            continue;
+        };
+        let is_constant = object
+            .get("constant")
+            .and_then(Value::as_bool)
+            .unwrap_or(false);
+        let display_name = object
+            .get("displayName")
+            .and_then(Value::as_str)
+            .unwrap_or_default()
+            .trim();
+        if !is_constant || display_name != WORLD_MANIFEST_DISPLAY_NAME {
+            continue;
+        }
+
+        let content = object
+            .get("content")
+            .and_then(Value::as_str)
+            .ok_or_else(|| BindingFailure {
+                code: "rp.world_manifest_invalid",
+                message: format!(
+                    "World Manifest entry at activated index {index} must contain JSON text"
+                ),
+            })?;
+        let manifest = serde_json::from_str::<WorldManifest>(content).map_err(|error| {
+            BindingFailure {
+                code: "rp.world_manifest_invalid",
+                message: format!(
+                    "World Manifest entry at activated index {index} is invalid: {error}"
+                ),
+            }
+        })?;
+        validate_manifest(&manifest)?;
+        manifests.push(manifest);
+    }
+
+    match manifests.len() {
+        0 => Ok(None),
+        1 => Ok(manifests.pop()),
+        count => Err(BindingFailure {
+            code: "rp.world_manifest_ambiguous",
+            message: format!(
+                "{count} constant `{WORLD_MANIFEST_DISPLAY_NAME}` entries are active; exactly one World Manifest may define the RP session world"
+            ),
+        }),
+    }
+}
+
+pub(super) fn validate_bound_session(
+    session: &SessionIdentity,
+    manifest: Option<&WorldManifest>,
+) -> Result<(), BindingFailure> {
+    let Some(manifest) = manifest else {
+        return Err(BindingFailure {
+            code: "rp.world_manifest_required",
+            message: format!(
+                "session `{}` is bound to world `{}` but this run has no active constant `{WORLD_MANIFEST_DISPLAY_NAME}` entry; restore the bound world before continuing",
+                session.session_id.0, session.world_id.0
+            ),
+        });
+    };
+
+    match check_world_binding(session, manifest) {
+        WorldBindingDecision::Match => Ok(()),
+        WorldBindingDecision::WorldBindingMismatch => Err(BindingFailure {
+            code: "rp.world_binding_mismatch",
+            message: format!(
+                "WORLD_BINDING_MISMATCH: session `{}` is bound to world `{}`, but the active World Manifest is `{}`. Start a new session for the loaded world, switch back to the bound world, or perform an explicit migration/fork; RP state will not cross this boundary silently.",
+                session.session_id.0, session.world_id.0, manifest.world_id.0
+            ),
+        }),
+        WorldBindingDecision::WorldRevisionDiverged => Err(BindingFailure {
+            code: "rp.world_revision_diverged",
+            message: format!(
+                "WORLD_REVISION_DIVERGED: session `{}` is pinned to canon revision {} / fingerprint `{}`, while world `{}` is now revision {} / fingerprint `{}`. Review or explicitly migrate/fork before continuing.",
+                session.session_id.0,
+                session.bound_canon_revision,
+                session.bound_canon_fingerprint,
+                manifest.world_id.0,
+                manifest.canon_revision,
+                manifest.canon_fingerprint
+            ),
+        }),
+    }
+}
+
+fn validate_manifest(manifest: &WorldManifest) -> Result<(), BindingFailure> {
+    if manifest.schema_version != RP_ARCHITECTURE_SCHEMA_VERSION {
+        return Err(BindingFailure {
+            code: "rp.world_manifest_schema_unsupported",
+            message: format!(
+                "World Manifest schema {} is unsupported; expected {}",
+                manifest.schema_version, RP_ARCHITECTURE_SCHEMA_VERSION
+            ),
+        });
+    }
+    if manifest.world_id.0.trim().is_empty() {
+        return Err(BindingFailure {
+            code: "rp.world_manifest_invalid",
+            message: "World Manifest worldId must not be empty".to_string(),
+        });
+    }
+    if manifest.title.trim().is_empty() {
+        return Err(BindingFailure {
+            code: "rp.world_manifest_invalid",
+            message: "World Manifest title must not be empty".to_string(),
+        });
+    }
+    if manifest.canon_fingerprint.trim().is_empty() {
+        return Err(BindingFailure {
+            code: "rp.world_manifest_invalid",
+            message: "World Manifest canonFingerprint must not be empty".to_string(),
+        });
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use serde_json::json;
+    use tt_domain::models::rp_architecture::{BranchId, SessionId, SessionStatus, WorldId};
+
+    use super::*;
+
+    fn manifest_json(world: &str, revision: u64, fingerprint: &str) -> String {
+        serde_json::to_string(&WorldManifest {
+            schema_version: RP_ARCHITECTURE_SCHEMA_VERSION,
+            world_id: WorldId(world.to_string()),
+            title: world.to_string(),
+            manifest_revision: 1,
+            canon_revision: revision,
+            canon_fingerprint: fingerprint.to_string(),
+            immutable_rules: Vec::new(),
+            canon_entity_refs: Vec::new(),
+            lore_pack_refs: Vec::new(),
+            compatibility: Default::default(),
+        })
+        .unwrap()
+    }
+
+    fn session(world: &str, revision: u64, fingerprint: &str) -> SessionIdentity {
+        SessionIdentity {
+            schema_version: RP_ARCHITECTURE_SCHEMA_VERSION,
+            session_id: SessionId("session-1".to_string()),
+            world_id: WorldId(world.to_string()),
+            bound_canon_revision: revision,
+            bound_canon_fingerprint: fingerprint.to_string(),
+            session_status: SessionStatus::Active,
+            host_chat_id: Some("chat-a".to_string()),
+            active_branch_id: BranchId("chat-a".to_string()),
+        }
+    }
+
+    #[test]
+    fn extracts_only_constant_named_manifest() {
+        let snapshot = json!({
+            "worldInfoActivation": {
+                "entries": [
+                    {"displayName":"Lore", "constant":true, "content":"not manifest"},
+                    {"displayName":WORLD_MANIFEST_DISPLAY_NAME, "constant":true, "content":manifest_json("world-a", 1, "fp-a")}
+                ]
+            }
+        });
+        let manifest = active_world_manifest(&snapshot).unwrap().unwrap();
+        assert_eq!(manifest.world_id.0, "world-a");
+    }
+
+    #[test]
+    fn rejects_multiple_active_manifests() {
+        let content = manifest_json("world-a", 1, "fp-a");
+        let snapshot = json!({
+            "worldInfoActivation": {
+                "entries": [
+                    {"displayName":WORLD_MANIFEST_DISPLAY_NAME, "constant":true, "content":content},
+                    {"displayName":WORLD_MANIFEST_DISPLAY_NAME, "constant":true, "content":manifest_json("world-b", 1, "fp-b")}
+                ]
+            }
+        });
+        let error = active_world_manifest(&snapshot).unwrap_err();
+        assert_eq!(error.code, "rp.world_manifest_ambiguous");
+    }
+
+    #[test]
+    fn bound_session_distinguishes_world_and_revision_failures() {
+        let bound = session("world-a", 17, "fp-17");
+        let world_b = serde_json::from_str::<WorldManifest>(&manifest_json("world-b", 17, "fp-17")).unwrap();
+        let error = validate_bound_session(&bound, Some(&world_b)).unwrap_err();
+        assert_eq!(error.code, "rp.world_binding_mismatch");
+
+        let rev_18 = serde_json::from_str::<WorldManifest>(&manifest_json("world-a", 18, "fp-18")).unwrap();
+        let error = validate_bound_session(&bound, Some(&rev_18)).unwrap_err();
+        assert_eq!(error.code, "rp.world_revision_diverged");
+    }
+}
