+++ b/src-tauri/crates/tt-application/src/services/agent_runtime_service/rp_asset_rebuild.rs
@@ -0,0 +1,104 @@
+use std::collections::BTreeSet;
+
+use sha2::{Digest, Sha256};
+use tt_domain::models::rp_architecture::{
+    CanonChangeClass, CanonChangeSet, CharacterId, WorldId,
+};
+
+pub(super) fn build_character_added_change_set(
+    world_id: &WorldId,
+    from_canon_revision: u64,
+    to_canon_revision: u64,
+    from_canon_fingerprint: &str,
+    to_canon_fingerprint: &str,
+    additions: &[(String, String)],
+    created_at_runtime_revision: u64,
+) -> CanonChangeSet {
+    let mut normalized = additions.to_vec();
+    normalized.sort();
+    normalized.dedup();
+
+    let entity_ids = normalized
+        .iter()
+        .map(|(character_id, _)| CharacterId(character_id.clone()))
+        .collect::<BTreeSet<_>>()
+        .into_iter()
+        .collect::<Vec<_>>();
+    let proposal_ids = normalized
+        .iter()
+        .map(|(_, proposal_id)| proposal_id.clone())
+        .collect::<BTreeSet<_>>()
+        .into_iter()
+        .collect::<Vec<_>>();
+
+    let mut hasher = Sha256::new();
+    hasher.update(b"tauritavern-canon-changeset-v1\0");
+    hasher.update(world_id.0.as_bytes());
+    hasher.update(b"\0");
+    hasher.update(from_canon_revision.to_le_bytes());
+    hasher.update(to_canon_revision.to_le_bytes());
+    hasher.update(from_canon_fingerprint.as_bytes());
+    hasher.update(b"\0");
+    hasher.update(to_canon_fingerprint.as_bytes());
+    hasher.update(b"\0");
+    for (character_id, proposal_id) in &normalized {
+        hasher.update(character_id.as_bytes());
+        hasher.update(b"\0");
+        hasher.update(proposal_id.as_bytes());
+        hasher.update(b"\0");
+    }
+    hasher.update(created_at_runtime_revision.to_le_bytes());
+    let digest = hasher.finalize();
+    let digest_hex = digest
+        .iter()
+        .map(|byte| format!("{byte:02x}"))
+        .collect::<String>();
+
+    CanonChangeSet {
+        change_set_id: format!("canon-changeset-{}", &digest_hex[..24]),
+        world_id: world_id.clone(),
+        from_canon_revision,
+        to_canon_revision,
+        from_canon_fingerprint: from_canon_fingerprint.to_string(),
+        to_canon_fingerprint: to_canon_fingerprint.to_string(),
+        changed_entity_refs: entity_ids.clone(),
+        added_entity_refs: entity_ids,
+        updated_entity_refs: Vec::new(),
+        removed_entity_refs: Vec::new(),
+        origin_proposal_ids: proposal_ids,
+        change_classes: vec![CanonChangeClass::CharacterAdded],
+        created_at_runtime_revision,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn same_canonization_produces_same_changeset() {
+        let additions = vec![
+            ("npc-b".to_string(), "proposal-b".to_string()),
+            ("npc-a".to_string(), "proposal-a".to_string()),
+        ];
+        let first = build_character_added_change_set(
+            &WorldId("cityschool-core".to_string()), 7, 8, "from", "to", &additions, 42,
+        );
+        let second = build_character_added_change_set(
+            &WorldId("cityschool-core".to_string()),
+            7,
+            8,
+            "from",
+            "to",
+            &additions.into_iter().rev().collect::<Vec<_>>(),
+            42,
+        );
+        assert_eq!(first, second);
+        assert_eq!(first.added_entity_refs[0].0, "npc-a");
+        assert!(first.change_set_id.starts_with("canon-changeset-"));
+    }
+}
