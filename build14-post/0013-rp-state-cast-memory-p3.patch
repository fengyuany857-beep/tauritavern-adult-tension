+#[derive(Debug, Clone, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct PendingCanonization {
+    pub proposal_id: String,
+    pub character_id: String,
+    pub world_id: String,
+    pub world_revision: u64,
+    pub display_name: String,
+    pub aliases: Vec<String>,
+    pub narrative_role: String,
+    pub author_canon: BTreeMap<String, Value>,
+    pub stable_profile: BTreeMap<String, Value>,
+}
+
+pub(crate) async fn pending_canonizations_for_run(
+    workspace_repository: &dyn WorkspaceRepository, run_id: &str,
+) -> Result<Vec<PendingCanonization>, ApplicationError> {
+    let state = load_state(workspace_repository, run_id).await?;
+    let mut values = Vec::new();
+    for proposal in state.canonization_proposals.iter().filter(|proposal| proposal.status == "confirmed") {
+        let Some(character) = state.cast_registry.get(&proposal.character_id) else { continue; };
+        let stable_profile = character.stable_profile.iter().map(|(key, value)| (key.clone(), json!(value))).collect();
+        values.push(PendingCanonization {
+            proposal_id: proposal.proposal_id.clone(), character_id: character.character_id.clone(), world_id: proposal.requested_world_id.clone(), world_revision: proposal.requested_world_revision,
+            display_name: character.display_name.clone(), aliases: character.aliases.clone(), narrative_role: character.narrative_role.clone(), author_canon: character.author_canon.clone(), stable_profile,
+        });
+    }
+    Ok(values)
+}
+
+pub(crate) async fn mark_canonizations_applied(
+    workspace_repository: &dyn WorkspaceRepository, run_id: &str, proposal_ids: &[String], new_revision: u64, new_fingerprint: &str,
+) -> Result<(), ApplicationError> {
+    if proposal_ids.is_empty() { return Ok(()); }
+    let mut state = load_state(workspace_repository, run_id).await?;
+    for proposal in &mut state.canonization_proposals {
+        if proposal_ids.contains(&proposal.proposal_id) && proposal.status == "confirmed" {
+            proposal.status = "applied".to_string(); proposal.applied_turn = Some(state.turn);
+        }
+    }
+    if let Some(session) = state.session.as_mut() { session.bound_canon_revision = new_revision; session.bound_canon_fingerprint = new_fingerprint.to_string(); }
+    state.runtime_revision = state.runtime_revision.saturating_add(1); state.last_run_id = Some(run_id.to_string());
+    save_state(workspace_repository, run_id, &state).await
+}
