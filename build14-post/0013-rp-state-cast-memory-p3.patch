+pub(in crate::services::agent_tools) async fn confirm_canonization(
+    run_repository: &dyn AgentRunRepository,
+    workspace_repository: &dyn WorkspaceRepository,
+    run_id: &str,
+    prompt_snapshot: &Value,
+    call: &ToolInvocation,
+) -> Result<(AgentToolResult, AgentToolEffect), ApplicationError> {
+    let Some(args) = object_args(call) else { return Ok((tool_error(call, "tool.invalid_arguments", "arguments must be an object"), AgentToolEffect::None)); };
+    let proposal_id = args.get("proposal_id").and_then(Value::as_str).unwrap_or_default().trim();
+    if proposal_id.is_empty() { return Ok((tool_error(call, "rp.canonization_confirmation_required", "proposal_id is required"), AgentToolEffect::None)); }
+    let confirm = args.get("confirm").and_then(Value::as_bool).unwrap_or(false);
+    if !confirm { return Ok((tool_error(call, "rp.canonization_confirmation_required", "confirm must be true"), AgentToolEffect::None)); }
+    let user_text = last_user_text(prompt_snapshot).to_lowercase();
+    let explicit = user_text.contains(&proposal_id.to_lowercase()) && ["确认", "confirm", "批准", "应用", "写入"].iter().any(|token| user_text.contains(token));
+    if !explicit { return Ok((tool_error(call, "rp.canonization_confirmation_required", "The current explicit user message must name the proposal id and clearly confirm/approve applying it to World Canon."), AgentToolEffect::None)); }
+    let run = run_repository.load_run(run_id).await?;
+    let mut state = load_state(workspace_repository, run_id).await?;
+    let manifest = active_world_manifest(prompt_snapshot).map_err(|e| ApplicationError::ValidationError(e.message))?;
+    if let Some(session) = state.session.as_ref() { validate_bound_session(session, manifest.as_ref()).map_err(|e| ApplicationError::ValidationError(e.message))?; }
+    let (character_id, world_id) = {
+        let proposal = state.canonization_proposals.iter_mut().find(|proposal| proposal.proposal_id == proposal_id)
+            .ok_or_else(|| ApplicationError::ValidationError(format!("rp.canonization_proposal_missing: unknown proposal `{proposal_id}`")))?;
+        if proposal.status != "proposed" { return Ok((tool_error(call, "rp.canonization_invalid_status", "proposal is not awaiting confirmation"), AgentToolEffect::None)); }
+        proposal.status = "confirmed".to_string(); proposal.confirmed_turn = Some(state.turn);
+        (proposal.character_id.clone(), proposal.requested_world_id.clone())
+    };
+    state.runtime_revision = state.runtime_revision.saturating_add(1); state.last_run_id = Some(run_id.to_string());
+    save_state(workspace_repository, run_id, &state).await?;
+    let payload = json!({"proposalId": proposal_id, "characterId": character_id, "status":"confirmed_pending_finish", "worldId": world_id});
+    Ok((success(call, "Canonization confirmed and staged. World Canon will be written only at the successful workspace.finish commit boundary.".to_string(), payload), AgentToolEffect::None))
+}
+
+fn last_user_text(prompt_snapshot: &Value) -> String {
+    let messages = prompt_snapshot.get("chatCompletionPayload").and_then(|value| value.get("messages")).and_then(Value::as_array);
+    let Some(messages) = messages else { return String::new(); };
+    for message in messages.iter().rev() {
+        if message.get("role").and_then(Value::as_str) != Some("user") { continue; }
+        let Some(content) = message.get("content") else { continue; };
+        if let Some(text) = content.as_str() { return text.to_string(); }
+        if let Some(parts) = content.as_array() {
+            return parts.iter().filter_map(|part| part.get("text").and_then(Value::as_str)).collect::<Vec<_>>().join("\n");
+        }
+    }
+    String::new()
+}
