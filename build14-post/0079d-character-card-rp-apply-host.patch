+pub async fn preview_character_card_rp_apply(
+    stable_chat_id: String,
+    binding_id: String,
+    app_state: State<'_, Arc<AppState>>,
+) -> Result<
+    tt_application::services::character_card_rp_apply_service::CharacterCardRpApplyPreview,
+    CommandError,
+> {
+    log_command("preview_character_card_rp_apply");
