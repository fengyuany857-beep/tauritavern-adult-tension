+fn binding_state_hash(binding: &CharacterCardBinding) -> Result<String, DomainError> {
+    let bytes = serde_json::to_vec(binding).map_err(|error| {
+        DomainError::InvalidData(format!(
+            "failed to hash Character Card binding state: {error}"
+        ))
+    })?;
+    Ok(sha256_hex(&bytes))
