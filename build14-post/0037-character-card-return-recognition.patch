+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ReturnRecognitionContext {
+    pub user_indicated_return: bool,
+    pub binding_exists: bool,
+    pub local_binding_generation: Option<u64>,
+    pub target_exists: bool,
+    pub card_exists: bool,
+    pub base_snapshot_exists: bool,
+    pub export_already_committed: bool,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+enum ParsedReturnLink {
+    None,
+    FutureSchema,
+    ProtectedNamespaceViolation,
+    Metadata(PortableReturnMetadata),
+}
+
+pub fn recognize_return_card(
+    card: &Value,
+    local_secret: &[u8],
+    context: &ReturnRecognitionContext,
+) -> ReturnRecognitionState {
+    let parsed = match parse_return_link(card) {
+        Ok(parsed) => parsed,
+        Err(()) => return ReturnRecognitionState::InvalidCard,
+    };
+    let metadata = match parsed {
+        ParsedReturnLink::None => {
+            return if context.user_indicated_return {
+                ReturnRecognitionState::MetadataStripped
+            } else {
+                ReturnRecognitionState::OrdinaryCharacterCard
+            };
+        }
+        ParsedReturnLink::FutureSchema => return ReturnRecognitionState::FuturePromotionSchema,
+        ParsedReturnLink::ProtectedNamespaceViolation => {
+            return ReturnRecognitionState::ProtectedNamespaceViolation;
+        }
+        ParsedReturnLink::Metadata(metadata) => metadata,
+    };
+
+    if metadata.validate_shape().is_err() || !verify_origin_proof(local_secret, &metadata) {
+        return ReturnRecognitionState::UnverifiedReturnMetadata;
+    }
+    if !context.binding_exists {
+        return ReturnRecognitionState::UnknownBinding;
+    }
+    if context.local_binding_generation != Some(metadata.binding_generation) {
+        return ReturnRecognitionState::StaleBindingGeneration;
+    }
+    if !context.target_exists {
+        return ReturnRecognitionState::BindingTargetMissing;
+    }
+    if !context.card_exists {
+        return ReturnRecognitionState::CardTargetMissing;
+    }
+    if context.export_already_committed {
+        return ReturnRecognitionState::DuplicatedOrReplayedExport;
+    }
+    if !context.base_snapshot_exists {
+        return ReturnRecognitionState::KnownReturnBaseMissing;
+    }
+    ReturnRecognitionState::KnownExactReturn
+}
+
+fn parse_return_link(card: &Value) -> Result<ParsedReturnLink, ()> {
+    let Some(root) = card.as_object() else {
+        return Err(());
+    };
+    let Some(data) = root.get("data") else {
+        return Ok(ParsedReturnLink::None);
+    };
+    let Some(data) = data.as_object() else {
+        return Err(());
+    };
+    let Some(extensions) = data.get("extensions") else {
+        return Ok(ParsedReturnLink::None);
+    };
+    let Some(extensions) = extensions.as_object() else {
+        return Err(());
+    };
+    let Some(tauritavern) = extensions.get("tauritavern") else {
+        return Ok(ParsedReturnLink::None);
+    };
+    let Some(namespace) = tauritavern.as_object() else {
+        return Ok(ParsedReturnLink::ProtectedNamespaceViolation);
+    };
+    if namespace.keys().any(|key| key != "characterCardLink") {
+        return Ok(ParsedReturnLink::ProtectedNamespaceViolation);
+    }
+    let Some(link) = namespace.get("characterCardLink").and_then(Value::as_object) else {
+        return Ok(ParsedReturnLink::ProtectedNamespaceViolation);
+    };
+    let Some(schema) = link.get("schemaVersion").and_then(Value::as_u64) else {
+        return Ok(ParsedReturnLink::ProtectedNamespaceViolation);
+    };
+    if schema > CARD_LINK_SCHEMA_VERSION {
+        return Ok(ParsedReturnLink::FutureSchema);
+    }
+    if schema != CARD_LINK_SCHEMA_VERSION
+        || link.keys().any(|key| {
+            !matches!(
+                key.as_str(),
+                "schemaVersion" | "returnMetadata" | "exportAnnotations"
+            )
+        })
+    {
+        return Ok(ParsedReturnLink::ProtectedNamespaceViolation);
+    }
+    let Some(metadata) = link.get("returnMetadata") else {
+        return Ok(ParsedReturnLink::ProtectedNamespaceViolation);
+    };
+    let metadata = serde_json::from_value::<PortableReturnMetadata>(metadata.clone())
+        .map_err(|_| ())?;
+    Ok(ParsedReturnLink::Metadata(metadata))
+}
+
+/// Proof does not cover current content. This warning is a separate heuristic
+/// guard against copied valid metadata on a radically different body. It never
+/// authorizes or automatically rejects a Return Commit.
+pub fn content_identity_mismatch_suspected(
+    base: &Value,
+    imported: &Value,
+    avatar_changed: bool,
+) -> bool {
+    let fields = ["name", "description", "personality", "character_book"];
+    let changed = fields
+        .iter()
+        .filter(|field| card_data_field(base, field) != card_data_field(imported, field))
+        .count();
+    let name_changed = card_data_field(base, "name") != card_data_field(imported, "name");
+    name_changed && changed + usize::from(avatar_changed) >= 4
+}
+
+fn card_data_field<'a>(card: &'a Value, field: &str) -> Option<&'a Value> {
+    card.get("data").and_then(|data| data.get(field))
+}
