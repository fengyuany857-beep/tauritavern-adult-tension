+function renderRpApply(root, candidate, chatId, preview, renderList) {
+    root.replaceChildren();
+    const header = element('div');
+    Object.assign(header.style, { display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: '.7rem' });
+    const title = element('h2', `${tr('applyCardToRp')}: ${candidate.displayName}`);
+    title.style.margin = '0';
+    const back = element('button', tr('backToCharacters'), 'menu_button');
+    back.type = 'button';
+    back.addEventListener('click', renderList);
+    header.append(title, back);
+    root.append(header);
+
+    const summary = stack(element('section'), '.35rem');
+    Object.assign(summary.style, { border: '1px solid var(--SmartThemeBorderColor)', borderRadius: '8px', padding: '.7rem' });
+    meta(summary, tr('bindingId'), preview?.cas?.bindingId);
+    meta(summary, tr('cardRevision'), preview?.cas?.cardRevision);
+    meta(summary, tr('bindingGeneration'), preview?.cas?.bindingGeneration);
+    meta(summary, tr('profileRevision'), preview?.cas?.profileRevision);
+    root.append(summary);
+
+    const warning = element('div', tr('applyCardToRpBoundary'));
+    Object.assign(warning.style, { border: '1px solid var(--warning-color,currentColor)', borderRadius: '8px', padding: '.7rem' });
+    root.append(warning);
+    if (preview?.blockedReason) {
+        const blocked = element('div', preview.blockedReason === 'ACTIVE_AGENT_RUN' ? tr('applyCardToRpActiveRunBlocked') : String(preview.blockedReason));
+        blocked.style.fontWeight = '600';
+        root.append(blocked);
+    }
+
+    const mappings = Array.isArray(preview?.mappings) ? preview.mappings : [];
+    const rows = [];
+    for (const mapping of mappings) {
+        const section = stack(element('section'), '.35rem');
+        Object.assign(section.style, { border: '1px solid var(--SmartThemeBorderColor)', borderRadius: '8px', padding: '.7rem' });
+        const select = element('label');
+        Object.assign(select.style, { display: 'flex', alignItems: 'center', gap: '.5rem' });
+        const checkbox = element('input');
+        checkbox.type = 'checkbox';
+        checkbox.checked = true;
+        select.append(checkbox, element('strong', mapping?.traitKey || ''));
+        section.append(select);
+        meta(section, tr('cardSourceField'), mapping?.sourceField);
+        if (mapping?.currentStatement) meta(section, tr('currentRpValue'), mapping.currentStatement);
+        const label = stack(element('label'), '.2rem');
+        label.append(element('span', tr('proposedRpValue')));
+        const input = element('textarea', '', 'text_pole');
+        input.rows = 5;
+        input.value = String(mapping?.proposedStatement ?? '');
+        label.append(input);
+        section.append(label);
+        rows.push({ mapping, checkbox, input });
+        root.append(section);
+    }
+
+    if (!mappings.length) {
+        root.append(element('div', tr('noCardRpMappings')));
+    }
+    const apply = element('button', '', 'menu_button menu_button_icon');
+    apply.type = 'button';
+    apply.disabled = Boolean(preview?.blockedReason) || !mappings.length;
+    apply.innerHTML = '<i class="fa-solid fa-check"></i>';
+    apply.append(document.createTextNode(` ${tr('confirmApplyCardToRp')}`));
+    apply.addEventListener('click', async () => {
+        const selections = rows
+            .filter(row => row.checkbox.checked)
+            .map(row => ({ traitKey: row.mapping.traitKey, statement: row.input.value }));
+        if (!selections.length) {
+            window.toastr?.warning?.(tr('selectCardRpMapping'));
+            return;
+        }
+        if (!await confirmAction(tr('applyCardToRpConfirm'))) return;
+        apply.disabled = true;
+        back.disabled = true;
+        try {
+            const result = await api().applyCardToRp({
+                stableChatId: chatId,
+                bindingId: candidate.binding.bindingId,
+                planToken: preview.planToken,
+                selections,
+            });
+            window.toastr?.success?.(tr('applyCardToRpSuccess', { revision: result?.profileRevision ?? '?' }));
+            await renderList();
+        } catch (error) {
+            console.error('[AdultTensionCast] Card to RP Apply failed', error);
+            window.toastr?.error?.(errorText(error));
+        } finally {
+            apply.disabled = Boolean(preview?.blockedReason) || !mappings.length;
+            back.disabled = false;
+        }
+    });
+    root.append(apply);
+}
