+use tt_domain::models::character_card_materialization::{CharacterCardDraft, DraftSourceKind, DraftState};
+use tt_domain::models::rp_architecture::{CharacterEntity, CharacterProfile};
+
 const RETURN_PROOF_DOMAIN: &[u8] = b"tauritavern.character-card-return.v1\0";
 const CARD_LINK_SCHEMA_VERSION: u64 = 1;
@@ -487,6 +492,142 @@ fn card_data_field<'a>(card: &'a Value, field: &str) -> Option<&'a Value> {
