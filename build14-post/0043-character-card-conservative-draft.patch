+
+pub fn build_conservative_draft(
+    character: &CharacterEntity,
+    draft_id: impl Into<String>,
+    source_card_revision: Option<u64>,
+    updated_at: impl Into<String>,
+) -> Result<CharacterCardDraft, String> {
+    let name = character
+        .profile
+        .identity
+        .display_name
+        .as_deref()
+        .or(character.profile.identity.canonical_name.as_deref())
+        .map(str::trim)
+        .filter(|name| !name.is_empty())
+        .ok_or_else(|| {
+            "cannot materialize a Character Card without a stable character name".to_string()
+        })?;
+
+    let description = conservative_description(&character.profile);
+    let personality = conservative_personality(&character.profile);
+    let definition = json!({
+        "spec": "chara_card_v2",
+        "spec_version": "2.0",
+        "data": {
+            "name": name,
+            "description": description,
+            "personality": personality,
+            "scenario": "",
+            "first_mes": "",
+            "mes_example": "",
+            "creator_notes": "",
+            "system_prompt": "",
+            "post_history_instructions": "",
+            "tags": [],
+            "creator": "",
+            "character_version": "",
+            "alternate_greetings": [],
+            "extensions": {},
+            "character_book": null
+        }
+    });
+    let generated_base_hash = canonical_definition_hash(&definition)?;
+    let mut field_provenance = BTreeMap::new();
+    field_provenance.insert(
+        "data.name".to_string(),
+        vec![DraftSourceKind::StableProfile],
+    );
+    if !description.is_empty() {
+        field_provenance.insert(
+            "data.description".to_string(),
+            vec![DraftSourceKind::StableProfile],
+        );
+    }
+    if !personality.is_empty() {
+        field_provenance.insert(
+            "data.personality".to_string(),
+            vec![DraftSourceKind::StableProfile],
+        );
+    }
+
+    Ok(CharacterCardDraft {
+        draft_id: draft_id.into(),
+        character_id: character.character_id.clone(),
+        source_profile_revision: character.profile_revision,
+        source_card_revision,
+        draft_revision: 1,
+        generated_base_hash,
+        user_edited: false,
+        state: DraftState::Generated,
+        field_provenance,
+        definition,
+        updated_at: updated_at.into(),
+    })
+}
+
+fn conservative_description(profile: &CharacterProfile) -> String {
+    let mut lines = Vec::new();
+    if !profile.appearance.is_empty() {
+        lines.push("Appearance:".to_string());
+        for (key, value) in &profile.appearance {
+            lines.push(format!("- {key}: {}", compact_json_value(value)));
+        }
+    }
+    append_labeled_list(&mut lines, "Backstory", &profile.backstory);
+    append_labeled_list(&mut lines, "Capabilities", &profile.capabilities);
+    append_labeled_list(&mut lines, "Limitations", &profile.limitations);
+    lines.join("\n")
+}
+
+fn conservative_personality(profile: &CharacterProfile) -> String {
+    let mut lines = Vec::new();
+    append_labeled_list(
+        &mut lines,
+        "Personality invariants",
+        &profile.personality_invariants,
+    );
+    append_labeled_list(&mut lines, "Values", &profile.values);
+    append_labeled_list(
+        &mut lines,
+        "Long-term motivations",
+        &profile.long_term_motivations,
+    );
+    if !profile.speech_voice.is_empty() {
+        lines.push("Speech voice:".to_string());
+        for (key, value) in &profile.speech_voice {
+            lines.push(format!("- {key}: {}", compact_json_value(value)));
+        }
+    }
+    lines.join("\n")
+}
+
+fn append_labeled_list(output: &mut Vec<String>, label: &str, values: &[String]) {
+    if values.is_empty() {
+        return;
+    }
+    output.push(format!("{label}:"));
+    output.extend(values.iter().map(|value| format!("- {value}")));
+}
+
+fn compact_json_value(value: &Value) -> String {
+    match value {
+        Value::String(value) => value.clone(),
+        _ => value.to_string(),
+    }
+}
+
+pub fn refresh_draft_source_state(
+    draft: &mut CharacterCardDraft,
+    current_profile_revision: u64,
+) {
+    if current_profile_revision > draft.source_profile_revision {
+        draft.state = DraftState::SourceAdvanced;
+    }
+}
 
