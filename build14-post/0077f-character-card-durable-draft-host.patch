+#[tauri::command]
+pub async fn resume_character_card_draft(
+    stable_chat_id: String,
+    character_id: String,
+    app_state: State<'_, Arc<AppState>>,
+) -> Result<
+    Option<tt_application::services::character_card_draft_materialization_service::CharacterCardDraftPreview>,
+    CommandError,
+> {
+    log_command("resume_character_card_draft");
+    app_state
+        .services
+        .character_card_draft_materialization_service
+        .resume(&stable_chat_id, &character_id)
+        .await
