+async fn save_state(
+    workspace_repository: &dyn WorkspaceRepository,
+    run_id: &str,
+    state: &RpState,
+) -> Result<(), ApplicationError> {
+    let path = WorkspacePath::parse(RP_STATE_PATH)?;
+    let text = serde_json::to_string_pretty(state).map_err(|error| {
+        ApplicationError::InternalError(format!("rp.state_serialize_failed: {error}"))
+    })?;
+    if text.len() > MAX_STATE_BYTES {
+        return Err(ApplicationError::ValidationError("rp.state_capacity_exceeded: the branch-local RP state exceeded the 1 MB mobile safety bound".to_string()));
+    }
+    workspace_repository.write_text(run_id, &path, &text).await?;
+    Ok(())
+}
