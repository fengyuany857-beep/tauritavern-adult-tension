+#[tauri::command]
+pub async fn preview_character_card_draft(
+    stable_chat_id: String,
+    character_id: String,
+    app_state: State<'_, Arc<AppState>>,
+) -> Result<
+    tt_application::services::character_card_draft_materialization_service::CharacterCardDraftPreview,
+    CommandError,
+> {
+    log_command("preview_character_card_draft");
+    app_state
+        .services
+        .character_card_draft_materialization_service
+        .preview(&stable_chat_id, &character_id)
+        .await
+        .map_err(map_command_error("Failed to preview Character Card draft"))
+}
+
+#[tauri::command]
+pub async fn commit_character_card_draft(
+    request: tt_application::services::character_card_draft_materialization_service::CharacterCardDraftCommitRequest,
+    app_state: State<'_, Arc<AppState>>,
+) -> Result<
+    tt_application::services::character_card_draft_materialization_service::CharacterCardDraftCommitResult,
+    CommandError,
+> {
+    log_command("commit_character_card_draft");
+    app_state
+        .services
+        .character_card_draft_materialization_service
+        .commit(request)
+        .await
+        .map_err(map_command_error("Failed to materialize Character Card draft"))
+}
