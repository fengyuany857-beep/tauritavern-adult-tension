+use std::sync::Arc;
+
+use async_trait::async_trait;
+
+use tt_domain::errors::DomainError;
+
+use super::agent_run_repository::AgentRunRepository;
+use super::workspace_repository::WorkspaceRepository;
+
+pub const ACCEPTANCE_SUITE_VERSION: &str = "ios-runtime-acceptance-v1";
+
+pub struct AcceptanceSandbox {
+    pub sandbox_id: String,
+    pub run_repository: Arc<dyn AgentRunRepository>,
+    pub workspace_repository: Arc<dyn WorkspaceRepository>,
+}
+
+#[async_trait]
+pub trait AcceptanceSandboxFactory: Send + Sync {
+    async fn cleanup_stale(&self) -> Result<usize, DomainError>;
+    async fn prepare(&self, run_id: &str) -> Result<AcceptanceSandbox, DomainError>;
+    async fn cleanup(&self, sandbox_id: &str) -> Result<(), DomainError>;
+}
