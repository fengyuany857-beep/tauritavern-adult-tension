@@ -0,0 +1,53 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+
+const read = (path) => fs.readFileSync(new URL(`../${path}`, import.meta.url), 'utf8');
+const bootstrap = read('src-tauri/crates/tauritavern/src/app/composition/services/bundled_skills.rs');
+const profile = read('src-tauri/crates/tt-application/src/services/agent_profile_service/defaults.rs');
+const readiness = read('src/scripts/extensions/agent-system/src/adult-tension-readiness.js');
+
+test('four bundled archives preserve New, Same, and Different -> Skip behavior', () => {
+    assert.match(bootstrap, /EXPECTED_SKILLS:\s*\[ExpectedBundledSkill; 4\]/);
+    assert.match(bootstrap, /adult-tension-narrative-v0\.3\.1\.zip/);
+    assert.match(bootstrap, /expected_version: Some\("0\.3\.1"\)/);
+    assert.match(bootstrap, /adult-tension-runtime-skills\/adult-tension-narrative-v0\.3\.1\.zip/);
+    assert.match(bootstrap, /SkillInstallConflictStrategy::Skip/);
+    assert.match(bootstrap, /SkillInstallAction::Skipped/);
+    assert.doesNotMatch(bootstrap, /conflict_strategy: Some\(SkillInstallConflictStrategy::Replace\)/);
+});
+
+test('Profile routes state -> plan -> stage -> render and keeps ordinary RP conditional', () => {
+    assert.match(profile, /"adult-tension-narrative"\.to_string\(\)/);
+    assert.match(profile, /skill_search on adult-tension-narrative with ATN-GATE/);
+    assert.match(profile, /INACTIVE and ELIGIBLE keep base prose/);
+    assert.match(profile, /ACTIVE targeted-reads ATN-PLAN/);
+    assert.match(profile, /exactly one successful rp\.stage_turn/);
+    assert.match(profile, /targeted-reads? ATN-RENDER/);
+    assert.match(profile, /AFTERMATH uses ATN-AFTERMATH/);
+    assert.match(profile, /rp\.state -> plan -> rp\.stage_turn -> render/);
+});
+
+test('Owner Matrix keeps authority, voice, sexuality, POV, and aftermath facts on legacy Runtime', () => {
+    assert.match(profile, /adult-tension-narrative-owner-matrix-v1/);
+    assert.match(profile, /eligibility, safety, permission\/grants, boundaries, player sovereignty/);
+    assert.match(profile, /sexuality_profile, sexuality_development, voice mode, POV/);
+    assert.match(profile, /beat physical\/spatial planning, scene-local psychophysical continuity/);
+    assert.match(profile, /directness is composed/);
+    assert.match(profile, /does not write sexuality_profile or sexuality_development/);
+    assert.match(profile, /explicitly requests fade, summary, less detail, fast-forward/);
+    assert.match(profile, /never expands permission, creates unstaged behavior/);
+    assert.match(profile, /one primary sensory focal subject\/viewpoint/);
+    assert.match(profile, /must not duplicate a staged or committed consequence/);
+});
+
+test('Readiness exposes Missing, Exact Bundled, and Different Custom states', () => {
+    assert.match(readiness, /ADULT_TENSION_REQUIRED_SKILLS[\s\S]*adult-tension-narrative/);
+    assert.match(readiness, /ADULT_TENSION_NARRATIVE_VERSION = '0\.3\.1'/);
+    assert.match(readiness, /ADULT_TENSION_NARRATIVE_PACKAGE_SHA256 = '[0-9a-f]{64}'/);
+    assert.match(readiness, /classifyAdultTensionSkillStates/);
+    assert.match(readiness, /'MISSING'/);
+    assert.match(readiness, /'EXACT_BUNDLED'/);
+    assert.match(readiness, /'DIFFERENT_CUSTOM'/);
+    assert.match(readiness, /sourceRefs/);
+    assert.match(readiness, /requiredSkillCount: ADULT_TENSION_REQUIRED_SKILLS\.length/);
+});
