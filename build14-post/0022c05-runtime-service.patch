+    async fn case_memory_dedup(&self, ctx: &SuiteContext) -> Result<CaseRunResult, ApplicationError> {
+        let run = self.create_run(ctx, "memory", None, &ctx.base_prompt).await?;
+        let staged = self.rp_call(ctx, &run.id, &ctx.base_prompt, "rp.stage_turn", json!({
+            "beat_summary":"Small synthetic memory batch.","advances_story":true,
+            "memory_updates":[
+                {"id":"mem-a","tier":"episodic","summary":"Aster found the blue key."},
+                {"id":"mem-b","tier":"episodic","summary":"Aster found the blue key."},
+                {"id":"mem-c","tier":"semantic","summary":"Blue key serial is KT-71839."}
+            ]
+        })).await?;
+        require_success(&staged, "memory.tiny_dedup.stage")?;
+        let state = self.rp_call(ctx, &run.id, &ctx.base_prompt, "rp.state", json!({})).await?;
+        let memories = state.structured.get("memories").and_then(Value::as_array).ok_or_else(|| ApplicationError::ValidationError("acceptance.memory_state_missing".to_string()))?;
+        if memories.len() != 2 { return Err(ApplicationError::ValidationError(format!("acceptance.memory_dedup_mismatch: expected 2 compact memories, got {}", memories.len()))); }
+        Ok(CaseRunResult::pass("Tiny duplicate memory batch compacts without state growth."))
+    }
