new file mode 100644
--- /dev/null
+++ b/src/scripts/extensions/agent-system/src/adult-tension-cast.js
@@ -0,0 +1,399 @@
+import { getActiveChatSnapshot } from '../../../../tauri/main/adapters/st/active-chat-ref.js';
+import { resolveStableChatId } from '../../../../tauri/main/api/agent-chat-identity.js';
+import { isAdultTensionDistribution } from './adult-tension-readiness.js';
+import { errorText } from './host-api.js';
+import { translateAgentSystem as tr } from './i18n.js';
+
+const BUTTON_ID = 'ttas_adult_tension_cast';
+const DIALOG_CLASS = 'ttas-dialog ttas-cast-dialog';
+const DRAFT_FIELDS = Object.freeze([
+    { key: 'name', label: 'Name', required: true },
+    { key: 'description', label: 'Description', multiline: true },
+    { key: 'personality', label: 'Personality', multiline: true },
+    { key: 'scenario', label: 'Scenario', multiline: true },
+    { key: 'first_mes', label: 'First Message', multiline: true },
+    { key: 'mes_example', label: 'Message Example', multiline: true },
+    { key: 'creator_notes', label: 'Creator Notes', multiline: true },
+    { key: 'system_prompt', label: 'System Prompt', multiline: true },
+    { key: 'post_history_instructions', label: 'Post-history Instructions', multiline: true },
+    { key: 'creator', label: 'Creator' },
+    { key: 'character_version', label: 'Character Version' },
+]);
+
+let activeDialog = null;
+
+function characterCardsApi() {
+    const api = window.__TAURITAVERN__?.api?.characterCards;
+    for (const name of [
+        'listMaterializationDraftCandidates',
+        'previewMaterializationDraft',
+        'commitMaterializationDraft',
+    ]) {
+        if (typeof api?.[name] !== 'function') {
+            throw new Error(tr('characterCardDraftApiUnavailable'));
+        }
+    }
+    return api;
+}
+
+function createElement(tag, className = '', text = '') {
+    const node = document.createElement(tag);
+    if (className) node.className = className;
+    if (text) node.textContent = text;
+    return node;
+}
+
+function setStack(node, gap = '.75rem') {
+    node.style.display = 'flex';
+    node.style.flexDirection = 'column';
+    node.style.gap = gap;
+    return node;
+}
+
+function appendMeta(parent, label, value) {
+    const row = createElement('div');
+    row.style.display = 'grid';
+    row.style.gridTemplateColumns = 'minmax(7.5rem, .34fr) minmax(0, 1fr)';
+    row.style.gap = '.65rem';
+    row.append(createElement('strong', '', label), createElement('span', '', String(value ?? '')));
+    parent.append(row);
+}
+
+function normalizeDefinition(preview) {
+    const definition = structuredClone(preview?.draft?.definition);
+    if (!definition || typeof definition !== 'object' || Array.isArray(definition)) {
+        throw new Error(tr('characterCardDraftInvalid'));
+    }
+    if (!definition.data || typeof definition.data !== 'object' || Array.isArray(definition.data)) {
+        throw new Error(tr('characterCardDraftInvalid'));
+    }
+    return definition;
+}
+
+function fieldSourceText(preview, fieldPath) {
+    const values = preview?.draft?.fieldProvenance?.[fieldPath];
+    if (!Array.isArray(values) || values.length === 0) return '';
+    return values.join(', ');
+}
+
+function renderStableTraits(parent, candidate) {
+    const traits = Array.isArray(candidate?.stableTraits) ? candidate.stableTraits : [];
+    if (traits.length === 0) return;
+    const details = createElement('details');
+    const summary = createElement('summary', '', `${tr('stableTraits')} (${traits.length})`);
+    details.append(summary);
+    const list = setStack(createElement('div'), '.45rem');
+    list.style.marginTop = '.55rem';
+    for (const trait of traits) {
+        const row = createElement('div');
+        const key = createElement('strong', '', `${trait?.key || ''}: `);
+        const statement = document.createTextNode(String(trait?.statement || ''));
+        row.append(key, statement);
+        if (trait?.status && trait.status !== 'stable') {
+            row.append(document.createTextNode(` [${trait.status}]`));
+        }
+        list.append(row);
+    }
+    details.append(list);
+    parent.append(details);
+}
+
+function renderCandidateCard(parent, candidate, openDraft) {
+    const card = setStack(createElement('section'), '.55rem');
+    card.style.border = '1px solid var(--SmartThemeBorderColor)';
+    card.style.borderRadius = '8px';
+    card.style.padding = '.8rem';
+
+    const heading = createElement('div');
+    heading.style.display = 'flex';
+    heading.style.justifyContent = 'space-between';
+    heading.style.gap = '.75rem';
+    heading.style.alignItems = 'flex-start';
+    const title = createElement('strong', '', candidate?.displayName || candidate?.characterId || tr('unknownCharacter'));
+    const state = createElement('span', '', candidate?.materialized ? tr('boundCard') : tr('draftAvailable'));
+    heading.append(title, state);
+    card.append(heading);
+
+    appendMeta(card, tr('narrativeRole'), candidate?.narrativeRole);
+    appendMeta(card, tr('controlOwner'), candidate?.controlOwner);
+    appendMeta(card, tr('lifecycleStatus'), candidate?.lifecycleStatus);
+    appendMeta(card, tr('scope'), candidate?.scopeKind);
+    appendMeta(card, tr('profileRevision'), candidate?.profileRevision);
+    renderStableTraits(card, candidate);
+
+    const canonFields = Array.isArray(candidate?.authorCanonFields) ? candidate.authorCanonFields : [];
+    if (canonFields.length) {
+        appendMeta(card, tr('authorCanonFields'), canonFields.join(', '));
+    }
+    if (Number(candidate?.inferredFieldCount || 0) > 0) {
+        const note = createElement('small', '', tr('inferredFieldsExcluded', { count: candidate.inferredFieldCount }));
+        note.style.opacity = '.75';
+        card.append(note);
+    }
+
+    const action = createElement('button', 'menu_button menu_button_icon');
+    action.type = 'button';
+    action.disabled = Boolean(candidate?.materialized);
+    action.innerHTML = '<i class="fa-solid fa-address-card"></i>';
+    action.append(document.createTextNode(candidate?.materialized ? ` ${tr('cardAlreadyMaterialized')}` : ` ${tr('materializeCharacterCard')}`));
+    action.addEventListener('click', () => openDraft(candidate));
+    card.append(action);
+    parent.append(card);
+}
+
+function renderDraftEditor(root, candidate, preview, onBack, onCommitted) {
+    root.replaceChildren();
+    const header = createElement('div');
+    header.style.display = 'flex';
+    header.style.justifyContent = 'space-between';
+    header.style.alignItems = 'center';
+    header.style.gap = '.75rem';
+    const title = createElement('h2', '', `${tr('characterCardDraft')}: ${candidate.displayName}`);
+    title.style.margin = '0';
+    const back = createElement('button', 'menu_button', tr('backToCharacters'));
+    back.type = 'button';
+    back.addEventListener('click', onBack);
+    header.append(title, back);
+    root.append(header);
+
+    const authority = setStack(createElement('section'), '.35rem');
+    authority.style.border = '1px solid var(--SmartThemeBorderColor)';
+    authority.style.borderRadius = '8px';
+    authority.style.padding = '.75rem';
+    appendMeta(authority, tr('narrativeRole'), candidate.narrativeRole);
+    appendMeta(authority, tr('scope'), preview?.scopeKind);
+    appendMeta(authority, tr('controlOwner'), candidate.controlOwner);
+    appendMeta(authority, tr('profileRevision'), preview?.cas?.sourceProfileRevision);
+    root.append(authority);
+
+    const warnings = Array.isArray(preview?.warnings) ? preview.warnings : [];
+    if (warnings.length) {
+        const warningBox = setStack(createElement('section'), '.3rem');
+        warningBox.style.border = '1px solid var(--warning-color, currentColor)';
+        warningBox.style.borderRadius = '8px';
+        warningBox.style.padding = '.75rem';
+        warningBox.append(createElement('strong', '', tr('draftWarnings')));
+        const list = createElement('ul');
+        for (const warning of warnings) list.append(createElement('li', '', String(warning)));
+        warningBox.append(list);
+        root.append(warningBox);
+    }
+
+    const definition = normalizeDefinition(preview);
+    const data = definition.data;
+    const form = setStack(createElement('div'), '.7rem');
+    for (const field of DRAFT_FIELDS) {
+        const label = setStack(createElement('label'), '.25rem');
+        const source = fieldSourceText(preview, `data.${field.key}`);
+        const heading = createElement('span');
+        const strong = createElement('strong', '', field.label);
+        heading.append(strong);
+        if (source) {
+            const provenance = createElement('small', '', ` · ${tr('draftSource')}: ${source}`);
+            provenance.style.opacity = '.7';
+            heading.append(provenance);
+        }
+        label.append(heading);
+        const input = field.multiline ? createElement('textarea', 'text_pole') : createElement('input', 'text_pole');
+        if (field.multiline) input.rows = field.key === 'description' || field.key === 'personality' ? 7 : 4;
+        input.value = String(data[field.key] ?? '');
+        input.required = Boolean(field.required);
+        input.addEventListener('input', () => {
+            data[field.key] = input.value;
+        });
+        label.append(input);
+        form.append(label);
+    }
+
+    const tagsLabel = setStack(createElement('label'), '.25rem');
+    tagsLabel.append(createElement('strong', '', 'Tags'));
+    const tags = createElement('input', 'text_pole');
+    tags.value = Array.isArray(data.tags) ? data.tags.join(', ') : '';
+    tags.addEventListener('input', () => {
+        data.tags = tags.value.split(',').map(value => value.trim()).filter(Boolean);
+    });
+    tagsLabel.append(tags);
+    form.append(tagsLabel);
+    root.append(form);
+
+    const commit = createElement('button', 'menu_button menu_button_icon');
+    commit.type = 'button';
+    commit.innerHTML = '<i class="fa-solid fa-floppy-disk"></i>';
+    commit.append(document.createTextNode(` ${tr('saveCharacterCardAndBind')}`));
+    commit.addEventListener('click', async () => {
+        if (!String(data.name || '').trim()) {
+            window.toastr?.warning?.(tr('characterCardNameRequired'));
+            return;
+        }
+        commit.disabled = true;
+        back.disabled = true;
+        try {
+            const result = await characterCardsApi().commitMaterializationDraft({
+                cas: preview.cas,
+                definition,
+            });
+            window.toastr?.success?.(tr('characterCardMaterialized', {
+                name: result?.character?.name || data.name,
+            }));
+            await onCommitted();
+        } catch (error) {
+            const message = errorText(error);
+            console.error('[AdultTensionCast] Character Card materialization failed', error);
+            window.toastr?.error?.(message);
+            if (message.includes('DRAFT_STALE')) {
+                await onCommitted();
+            }
+        } finally {
+            commit.disabled = false;
+            back.disabled = false;
+        }
+    });
+    root.append(commit);
+}
+
+async function resolveCurrentStableChatId() {
+    const activeChat = getActiveChatSnapshot();
+    if (!activeChat?.ref) throw new Error(tr('activeChatRequired'));
+    return resolveStableChatId(activeChat.ref);
+}
+
+async function openCastDialog() {
+    if (activeDialog?.open) {
+        activeDialog.focus();
+        return;
+    }
+    if (typeof HTMLDialogElement === 'undefined') {
+        throw new Error(tr('agentSystemElementUnsupported'));
+    }
+
+    const dialog = document.createElement('dialog');
+    dialog.className = DIALOG_CLASS;
+    dialog.setAttribute('data-tt-mobile-surface', 'fullscreen-window');
+    const root = setStack(createElement('div', 'ttas-popup-mount'), '.8rem');
+    dialog.append(root);
+    document.body.append(dialog);
+    activeDialog = dialog;
+
+    const cleanup = () => {
+        dialog.remove();
+        if (activeDialog === dialog) activeDialog = null;
+    };
+    dialog.addEventListener('close', cleanup, { once: true });
+    dialog.addEventListener('cancel', event => {
+        event.preventDefault();
+        dialog.close();
+    });
+
+    const renderList = async () => {
+        root.replaceChildren();
+        const header = createElement('div');
+        header.style.display = 'flex';
+        header.style.justifyContent = 'space-between';
+        header.style.alignItems = 'center';
+        const title = createElement('h2', '', tr('rpCharacters'));
+        title.style.margin = '0';
+        const close = createElement('button', 'menu_button', tr('close'));
+        close.type = 'button';
+        close.addEventListener('click', () => dialog.close());
+        header.append(title, close);
+        root.append(header, createElement('p', '', tr('rpCharactersHint')));
+
+        const loading = createElement('div', '', tr('loading'));
+        root.append(loading);
+        try {
+            const stableChatId = await resolveCurrentStableChatId();
+            const result = await characterCardsApi().listMaterializationDraftCandidates({ stableChatId });
+            loading.remove();
+            const candidates = Array.isArray(result?.candidates) ? result.candidates : [];
+            if (candidates.length === 0) {
+                root.append(createElement('div', '', tr('noRpCharacters')));
+                return;
+            }
+            for (const candidate of candidates) {
+                renderCandidateCard(root, candidate, async selected => {
+                    try {
+                        const preview = await characterCardsApi().previewMaterializationDraft({
+                            stableChatId,
+                            characterId: selected.characterId,
+                        });
+                        renderDraftEditor(root, selected, preview, renderList, renderList);
+                    } catch (error) {
+                        console.error('[AdultTensionCast] draft preview failed', error);
+                        window.toastr?.error?.(errorText(error));
+                    }
+                });
+            }
+        } catch (error) {
+            loading.remove();
+            const message = errorText(error);
+            const errorBox = createElement('div', '', message);
+            errorBox.style.whiteSpace = 'pre-wrap';
+            root.append(errorBox);
+            console.error('[AdultTensionCast] candidate list failed', error);
+        }
+    };
+
+    dialog.showModal();
+    await renderList();
+}
+
+function reportInteractionError(error) {
+    console.error('[AdultTensionCast]', error);
+    window.toastr?.error?.(errorText(error));
+}
+
+export async function mountAdultTensionCastEntry() {
+    if (!await isAdultTensionDistribution()) return;
+    if (document.getElementById(BUTTON_ID)) return;
+
+    const rightSendForm = document.getElementById('rightSendForm');
+    const sendButton = document.getElementById('send_but');
+    if (!(rightSendForm instanceof HTMLElement) || !(sendButton instanceof HTMLElement)) {
+        throw new Error(tr('sendFormNotFound'));
+    }
+
+    const button = document.createElement('button');
+    button.id = BUTTON_ID;
+    button.type = 'button';
+    button.className = 'ttas-agent-send-toggle interactable';
+    button.innerHTML = '<i class="fa-solid fa-users"></i>';
+    button.title = tr('rpCharacters');
+    button.setAttribute('aria-label', tr('rpCharacters'));
+    rightSendForm.insertBefore(button, sendButton);
+
+    const syncVisibility = () => {
+        button.classList.toggle('displayNone', sendButton.classList.contains('displayNone'));
+    };
+    const observer = new MutationObserver(syncVisibility);
+    observer.observe(sendButton, { attributes: true, attributeFilter: ['class'] });
+    syncVisibility();
+
+    button.addEventListener('click', () => {
+        try {
+            const result = openCastDialog();
+            result?.catch?.(reportInteractionError);
+        } catch (error) {
+            reportInteractionError(error);
+        }
+    });
+}
