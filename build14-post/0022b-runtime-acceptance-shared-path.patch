+    Advisory,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum AcceptancePhase {
+    Idle,
+    Environment,
+    Agent,
+    Rp,
+    World,
+    CastMemory,
+    Persistence,
+    Burst,
+    Cleanup,
