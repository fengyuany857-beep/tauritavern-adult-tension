+    pub platform: String,
+    pub tauri_version: String,
+    pub integration_revision: Option<String>,
+    pub git_branch: Option<String>,
+    pub distribution_flavor: String,
+    pub control_sha: Option<String>,
+    pub upstream_sha: Option<String>,
+    pub github_run_id: Option<String>,
+    pub github_run_number: Option<String>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct AcceptanceCaseStatusDto {
+    pub id: String,
+    pub title: String,
+    pub kind: AcceptanceCaseKind,
+    pub phase: AcceptancePhase,
+    pub state: AcceptanceCaseState,
+    pub duration_ms: Option<u128>,
+    pub code: Option<String>,
+    pub detail: Option<String>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct AcceptanceStatusDto {
+    pub schema_version: u32,
+    pub suite_version: String,
+    pub run_id: Option<String>,
+    pub revision: u64,
+    pub state: AcceptanceSuiteState,
+    pub phase: AcceptancePhase,
+    pub started_at: Option<String>,
+    pub updated_at: String,
+    pub finished_at: Option<String>,
+    pub current_case_id: Option<String>,
+    pub completed_cases: usize,
+    pub total_cases: usize,
+    pub cancellation_requested: bool,
+    pub cases: Vec<AcceptanceCaseStatusDto>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct AcceptanceStartResultDto {
+    pub run_id: String,
+    pub status: AcceptanceStatusDto,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct AcceptanceCancelResultDto {
+    pub run_id: String,
+    pub cancellation_requested: bool,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct AcceptanceStatusRequestDto {
+    #[serde(default)]
+    pub run_id: Option<String>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct AcceptanceRunRequestDto {
+    pub run_id: String,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, Default)]
+#[serde(rename_all = "camelCase")]
+pub struct AcceptanceSummaryDto {
+    pub passed: usize,
+    pub warned: usize,
+    pub failed: usize,
+    pub skipped: usize,
+    pub cancelled: usize,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct AcceptanceEnvironmentDto {
+    pub platform: String,
+    pub profile_id: String,
+    pub profile_runtime_ready: bool,
+    pub model_configuration_ready: bool,
+    pub stale_sandbox_count_cleaned: usize,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct AcceptanceSandboxReportDto {
+    pub isolation_verified: bool,
+    pub cleaned: bool,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct AcceptanceCapabilitiesDto {
+    pub process_death_recovery_tested: bool,
+    pub live_llm_api_tested: bool,
+    pub large_state_stress_tested: bool,
+    pub long_context_tested: bool,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct AcceptanceReportDto {
+    pub schema_version: u32,
+    pub suite_version: String,
+    pub run_id: String,
+    pub started_at: String,
+    pub finished_at: String,
+    pub overall: AcceptanceSuiteState,
+    pub build: AcceptanceBuildInfoDto,
+    pub environment: AcceptanceEnvironmentDto,
+    pub summary: AcceptanceSummaryDto,
+    pub cases: Vec<AcceptanceCaseStatusDto>,
+    pub sandbox: AcceptanceSandboxReportDto,
+    pub capabilities: AcceptanceCapabilitiesDto,
+}
