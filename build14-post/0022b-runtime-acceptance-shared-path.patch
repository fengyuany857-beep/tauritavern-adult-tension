+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum AcceptanceSuiteState {
+    Idle,
+    Running,
+    Pass,
+    PassWithWarnings,
+    Fail,
+    Cancelled,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum AcceptanceCaseState {
+    Pending,
+    Running,
+    Pass,
+    Warn,
+    Fail,
+    Skip,
+    Cancelled,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
