diff --git a/src-tauri/crates/tt-application/src/services/agent_tools/rp/mod.rs b/src-tauri/crates/tt-application/src/services/agent_tools/rp/mod.rs
index aa29928..b347226 100644
--- a/src-tauri/crates/tt-application/src/services/agent_tools/rp/mod.rs
+++ b/src-tauri/crates/tt-application/src/services/agent_tools/rp/mod.rs
@@ -2,11 +2,38 @@ mod binding;
 mod descriptors;
 mod state;
 
+use serde_json::Value;
+
+use crate::errors::ApplicationError;
+use crate::services::agent_tools::dispatcher::AgentToolEffect;
+use tt_domain::models::agent::AgentToolResult;
+use tt_domain::models::tool::ToolInvocation;
+use tt_ports::repositories::agent_run_repository::AgentRunRepository;
+use tt_ports::repositories::workspace_repository::WorkspaceRepository;
+
 pub(super) use descriptors::{rp_confirm_canonization_descriptor, rp_recall_descriptor, rp_stage_turn_descriptor, rp_state_descriptor};
-pub(super) use state::{confirm_canonization, recall, stage_turn, staged_for_run, state};
+pub(super) use state::staged_for_run;
 pub(crate) use state::{mark_canonizations_applied, pending_canonizations_for_run};
 
 pub(super) const RP_STATE: &str = "rp.state";
 pub(super) const RP_RECALL: &str = "rp.recall";
 pub(super) const RP_STAGE_TURN: &str = "rp.stage_turn";
 pub(super) const RP_CONFIRM_CANONIZATION: &str = "rp.confirm_canonization";
+
+pub(crate) async fn dispatch_tool(
+    run_repository: &dyn AgentRunRepository,
+    workspace_repository: &dyn WorkspaceRepository,
+    run_id: &str,
+    prompt_snapshot: &Value,
+    call: &ToolInvocation,
+) -> Result<(AgentToolResult, AgentToolEffect), ApplicationError> {
+    match call.tool_id.native_name() {
+        RP_STATE => state::state(run_repository, workspace_repository, run_id, prompt_snapshot, call).await,
+        RP_RECALL => state::recall(run_repository, workspace_repository, run_id, prompt_snapshot, call).await,
+        RP_STAGE_TURN => state::stage_turn(run_repository, workspace_repository, run_id, prompt_snapshot, call).await,
+        RP_CONFIRM_CANONIZATION => state::confirm_canonization(run_repository, workspace_repository, run_id, prompt_snapshot, call).await,
+        other => Err(ApplicationError::InternalError(format!(
+            "rp.dispatch_handler_missing: admitted RP tool `{other}` has no execution handler"
+        ))),
+    }
+}
