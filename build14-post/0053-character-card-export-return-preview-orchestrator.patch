+#[cfg(test)]
+mod tests {
+    use serde_json::json;
+    use tt_domain::models::character_card_materialization::MergeFieldState;
+
+    use super::*;
+
+    #[test]
+    fn missing_imported_field_is_not_treated_as_deletion() {
+        let base = json!({"spec":"chara_card_v2","data":{"name":"A"}});
+        let local = base.clone();
+        let imported = json!({"spec":"chara_card_v2","data":{}});
+        let decisions = top_level_three_way_decisions(&base, &local, &imported);
+        let name = decisions
+            .iter()
+            .find(|decision| decision.field_path == "data.name")
+            .expect("name decision");
+        assert_eq!(name.state, MergeFieldState::FieldMissingImported);
+        assert!(name.requires_user_confirmation);
+    }
+
+    #[test]
+    fn return_metadata_extractor_reads_only_opaque_locator_tuple() {
+        let card = json!({
+            "data": {
+                "extensions": {
+                    "tauritavern": {
+                        "characterCardLink": {
+                            "returnMetadata": {
+                                "bindingId": "binding-opaque",
+                                "exportId": "export-opaque",
+                                "bindingGeneration": 2,
+                                "baseCardRevision": 4,
+                                "baseCardHash": "a".repeat(64),
+                                "originProof": "b".repeat(64)
+                            }
+                        }
+                    }
+                }
+            }
+        });
+        let metadata = extract_return_metadata(&card).expect("metadata");
+        assert_eq!(metadata.binding_id, "binding-opaque");
+        assert_eq!(metadata.export_id, "export-opaque");
+    }
+
+    #[test]
+    fn export_record_tuple_must_match_all_authenticated_base_fields() {
+        let metadata = PortableReturnMetadata {
+            binding_id: "binding-a".to_string(),
+            export_id: "export-a".to_string(),
+            binding_generation: 3,
+            base_card_revision: 7,
+            base_card_hash: "a".repeat(64),
+            origin_proof: "b".repeat(64),
+        };
+        let mut record = ExportRecord {
+            schema_version: CHARACTER_CARD_MATERIALIZATION_SCHEMA_VERSION,
+            export_id: metadata.export_id.clone(),
+            binding_id: metadata.binding_id.clone(),
+            binding_generation: metadata.binding_generation,
+            base_card_revision: metadata.base_card_revision,
+            base_card_hash: metadata.base_card_hash.clone(),
+            base_profile_revision: 9,
+            snapshot_ref: "snapshots/a.json".to_string(),
+            exported_at: "2026-09-11T00:00:00Z".to_string(),
+            format: "json".to_string(),
+            transaction_id: None,
+        };
+        assert!(export_record_matches_metadata(&record, &metadata));
+        record.base_card_revision += 1;
+        assert!(!export_record_matches_metadata(&record, &metadata));
+    }
+}
