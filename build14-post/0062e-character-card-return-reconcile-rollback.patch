+    async fn reconcile_committed_return(
+        &self,
+        transaction_id: &str,
+        plan: &ReturnImportPlan,
+        avatar_replaced: bool,
+    ) -> Result<CharacterCardReturnCommitResult, DomainError> {
+        let journal = self
+            .materialization
+            .read_transaction(transaction_id)
+            .await?
+            .ok_or_else(|| DomainError::NotFound(format!(
+                "Character Card transaction {transaction_id}"
+            )))?;
+        if journal.state != CharacterCardTransactionState::Committed
+            || journal.plan_token != plan.plan_token
+            || journal.expected_after_card_hash.as_deref()
+                != Some(plan.resolved_choices_hash.as_str())
+        {
+            return Err(DomainError::Conflict(
+                "committed Character Card Return journal does not match supplied plan"
+                    .to_string(),
+            ));
+        }
+        let binding = self
+            .materialization
+            .read_binding(&plan.target_binding_id)
+            .await?
+            .ok_or_else(|| DomainError::NotFound(format!(
+                "character card binding {}",
+                plan.target_binding_id
+            )))?;
+        let expected_revision = plan.expected_card_revision.checked_add(1).ok_or_else(|| {
+            DomainError::InvalidData("Character Card revision overflow".to_string())
+        })?;
+        if binding.generation != plan.expected_binding_generation
+            || binding.card_revision != expected_revision
+            || binding.profile_revision_at_last_sync != Some(plan.expected_profile_revision)
+        {
+            return Err(DomainError::Conflict(
+                "committed Character Card Return binding no longer matches committed result"
+                    .to_string(),
+            ));
+        }
+        let card_text = self.cards.read_card_json(&binding.card_storage_identity).await?;
+        let card = parse_json_card(card_text.as_bytes())?;
+        let card_hash = canonical_definition_hash(&portable_definition_projection(card))
+            .map_err(DomainError::InvalidData)?;
+        if card_hash != plan.resolved_choices_hash {
+            return Err(DomainError::Conflict(
+                "committed Character Card Return card no longer matches committed result"
+                    .to_string(),
+            ));
+        }
+        if let Some(export_id) = journal.export_id.as_deref() {
+            let export = self
+                .materialization
+                .read_export_record(export_id)
+                .await?
+                .ok_or_else(|| DomainError::NotFound(format!(
+                    "character card export record {export_id}"
+                )))?;
+            if export.transaction_id.as_deref() != Some(transaction_id) {
+                return Err(DomainError::Conflict(
+                    "committed Character Card Return replay marker is missing".to_string(),
+                ));
+            }
+        }
+        Ok(CharacterCardReturnCommitResult {
+            transaction_id: transaction_id.to_string(),
+            binding_id: binding.binding_id,
+            card_revision: expected_revision,
+            binding_generation: plan.expected_binding_generation,
+            card_hash,
+            avatar_replaced,
+            idempotent_replay: true,
+        })
+    }
