+    async fn rollback_return_transaction(
+        &self,
+        journal: &mut CharacterCardTransactionJournal,
+    ) -> Result<(), DomainError> {
+        let pre_rollback_state = journal.state;
+        advance_return_journal(
+            &*self.materialization,
+            journal,
+            CharacterCardTransactionState::RollingBack,
+        )
+        .await?;
+
+        let rollback: Result<(), DomainError> = async {
+            let snapshots_required = !matches!(
+                pre_rollback_state,
+                CharacterCardTransactionState::Prepared
+                    | CharacterCardTransactionState::StagedInputVerified
+            );
+            match (
+                journal.before_card_ref.as_deref(),
+                journal.before_binding_ref.as_deref(),
+            ) {
+                (Some(card_ref), Some(binding_ref)) => {
+                    let before_png = self.materialization.read_snapshot(card_ref).await?;
+                    let before_card_json = self.cards.inspect_png_card_json(&before_png).await?;
+                    let before_card = parse_json_card(before_card_json.as_bytes())?;
+                    let before_hash = canonical_definition_hash(&portable_definition_projection(before_card))
+                        .map_err(DomainError::InvalidData)?;
+                    let before_binding_bytes = self.materialization.read_snapshot(binding_ref).await?;
+                    let before_binding: CharacterCardBinding = serde_json::from_slice(&before_binding_bytes)
+                        .map_err(|error| DomainError::InvalidData(format!(
+                            "invalid Character Card rollback binding snapshot: {error}"
+                        )))?;
+
+                    let current_text = self.cards.read_card_json(&before_binding.card_storage_identity).await?;
+                    let current_card = parse_json_card(current_text.as_bytes())?;
+                    let current_hash = canonical_definition_hash(&portable_definition_projection(current_card))
+                        .map_err(DomainError::InvalidData)?;
+                    if current_hash != before_hash {
+                        let Some(expected_after) = journal.expected_after_card_hash.as_deref() else {
+                            return Err(DomainError::Conflict(
+                                "rollback cannot prove ownership of current Character Card state"
+                                    .to_string(),
+                            ));
+                        };
+                        if current_hash != expected_after {
+                            return Err(DomainError::Conflict(
+                                "Character Card changed after Return transaction; rollback will not overwrite it"
+                                    .to_string(),
+                            ));
+                        }
+                        self.cards
+                            .restore_card_png_bytes(&before_binding.card_storage_identity, &before_png)
+                            .await?;
+                    }
+
+                    let current_binding = self
+                        .materialization
+                        .read_binding(&before_binding.binding_id)
+                        .await?
+                        .ok_or_else(|| DomainError::NotFound(format!(
+                            "character card binding {}",
+                            before_binding.binding_id
+                        )))?;
+                    if current_binding != before_binding {
+                        let expected_written_revision = before_binding.card_revision.checked_add(1)
+                            .ok_or_else(|| DomainError::InvalidData(
+                                "Character Card revision overflow".to_string(),
+                            ))?;
+                        if current_binding.generation != before_binding.generation
+                            || current_binding.card_revision != expected_written_revision
+                            || current_binding.profile_revision_at_last_sync
+                                != before_binding.profile_revision_at_last_sync
+                        {
+                            return Err(DomainError::Conflict(
+                                "Character Card binding changed after Return transaction; rollback will not overwrite it"
+                                    .to_string(),
+                            ));
+                        }
+                        self.materialization.write_binding(&before_binding).await?;
+                    }
+                }
+                _ if snapshots_required => {
+                    return Err(DomainError::InvalidData(
+                        "Return transaction requires rollback snapshots but journal is incomplete"
+                            .to_string(),
+                    ));
+                }
+                _ => {}
+            }
+
+            if let Some(export_id) = journal.export_id.as_deref() {
+                if let Some(mut export) = self.materialization.read_export_record(export_id).await? {
+                    match export.transaction_id.as_deref() {
+                        Some(transaction_id) if transaction_id == journal.transaction_id => {
+                            export.transaction_id = None;
+                            self.materialization.write_export_record(&export).await?;
+                        }
+                        Some(_) => {
+                            return Err(DomainError::Conflict(
+                                "Character Card export was consumed by another transaction during rollback"
+                                    .to_string(),
+                            ));
+                        }
+                        None => {}
+                    }
+                }
+            }
+            Ok(())
+        }
+        .await;
+
+        match rollback {
+            Ok(()) => {
+                advance_return_journal(
+                    &*self.materialization,
+                    journal,
+                    CharacterCardTransactionState::RolledBack,
+                )
+                .await
+            }
+            Err(error) => {
+                journal.state = CharacterCardTransactionState::RollbackFailed;
+                journal.updated_at = Utc::now().to_rfc3339();
+                let _ = self.materialization.write_transaction(journal).await;
+                Err(error)
+            }
+        }
+    }
 
