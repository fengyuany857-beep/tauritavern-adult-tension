+pub struct CharacterCardDraftAuthority {
+    pub stable_chat_id: String,
+    pub state_id: String,
+    pub world_id: WorldId,
+    pub session_id: SessionId,
+    pub active_branch_id: BranchId,
+    pub proposed_binding_id: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct CharacterCardDraftRecord {
+    pub schema_version: u32,
+    pub authority: CharacterCardDraftAuthority,
+    pub scope_kind: BindingScopeKind,
+    pub draft: CharacterCardDraft,
+    #[serde(default)]
+    pub warnings: Vec<String>,
+}
+
+impl CharacterCardDraftRecord {
+    pub fn validate(&self) -> Result<(), String> {
+        if self.schema_version != CHARACTER_CARD_MATERIALIZATION_SCHEMA_VERSION {
+            return Err("unsupported Character Card draft record schema version".to_string());
+        }
+        if self.draft.draft_id.trim().is_empty()
+            || self.draft.character_id.0.trim().is_empty()
+            || self.authority.stable_chat_id.trim().is_empty()
+            || self.authority.state_id.trim().is_empty()
+            || self.authority.world_id.0.trim().is_empty()
+            || self.authority.session_id.0.trim().is_empty()
+            || self.authority.active_branch_id.0.trim().is_empty()
+            || self.authority.proposed_binding_id.trim().is_empty()
+        {
+            return Err("Character Card draft record contains an empty authority identifier".to_string());
+        }
+        if self.draft.draft_revision == 0 {
+            return Err("Character Card draft revision must start at 1".to_string());
+        }
+        Ok(())
+    }
+}
