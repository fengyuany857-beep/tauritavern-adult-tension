+const RP_STATE_PATH: &str = "persist/rp/state.json";
+const MAX_RUN_PROBE: usize = 64;
+const MAX_PROFILE_EVIDENCE: usize = 1024;
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct CharacterCardRpApplyCas {
+    pub stable_chat_id: String,
+    pub selected_state_id: String,
+    pub binding_id: String,
+    pub binding_generation: u64,
+    pub card_revision: u64,
+    pub card_hash: String,
+    pub character_id: String,
+    pub profile_revision: u64,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct CharacterCardRpApplyMapping {
+    pub trait_key: String,
+    pub source_field: String,
+    pub proposed_statement: String,
+    pub current_statement: Option<String>,
+}
+
+#[derive(Debug, Clone, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct CharacterCardRpApplyPreview {
+    pub plan_token: String,
+    pub cas: CharacterCardRpApplyCas,
+    pub character_name: String,
+    pub mappings: Vec<CharacterCardRpApplyMapping>,
+    pub active_agent_run: bool,
+    pub blocked_reason: Option<String>,
+    pub warning: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Deserialize)]
