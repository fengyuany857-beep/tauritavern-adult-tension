 impl CharacterCardMaterializationOrchestrator {
     pub fn new(
         materialization: Arc<dyn CharacterCardMaterializationRepository>,
         cards: Arc<dyn CharacterCardReturnRepository>,
+        authority: Arc<dyn CharacterCardReturnAuthorityRepository>,
+        runs: Arc<dyn AgentRunRepository>,
     ) -> Self {
         Self {
             materialization,
             cards,
+            authority,
+            runs,
         }
     }
+
+    /// Hard gate shared by every future Return Commit path.
+    ///
+    /// This deliberately blocks on any non-terminal Agent Run. It is more
+    /// conservative than target-scoped locking, but guarantees that Return
+    /// cannot race an Agent workspace mutation while target-specific run
+    /// ownership is still evolving.
+    pub async fn verify_commit_authority(
+        &self,
+        binding_id: &str,
+        expected_binding_generation: u64,
+        expected_card_revision: u64,
+        expected_profile_revision: u64,
+    ) -> Result<CharacterCardReturnAuthoritySnapshot, DomainError> {
+        let binding = self
+            .materialization
+            .read_binding(binding_id)
+            .await?
+            .ok_or_else(|| DomainError::NotFound(format!("character card binding {binding_id}")))?;
+        validate_active_binding(&binding)?;
+        if binding.generation != expected_binding_generation {
+            return Err(DomainError::Conflict(format!(
+                "binding generation CAS failed: expected {expected_binding_generation}, current {}",
+                binding.generation
+            )));
+        }
+        if binding.card_revision != expected_card_revision {
+            return Err(DomainError::Conflict(format!(
+                "card revision CAS failed: expected {expected_card_revision}, current {}",
+                binding.card_revision
+            )));
+        }
+
+        if let Some(run) = self
+            .runs
+            .list_all_runs()
+            .await?
+            .into_iter()
+            .find(|run| !run.status.is_terminal())
+        {
+            return Err(DomainError::Conflict(format!(
+                "active Agent run blocks Character Card Return Commit: {} ({:?})",
+                run.id, run.status
+            )));
+        }
+
+        let snapshot = self
+            .authority
+            .resolve_authority(&binding.target, &binding.contexts)
+            .await?;
+        validate_authority_snapshot(&binding, &snapshot, expected_profile_revision)?;
+        Ok(snapshot)
+    }
 
