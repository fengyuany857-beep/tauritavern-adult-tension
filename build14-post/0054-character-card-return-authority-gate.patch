+
+/// Authoritative RP-side CAS snapshot used by Character Card Return Commit.
+///
+/// Implementations must read the live RP authority store. Binding caches,
+/// frontend request values, exported metadata, and Character Card fields are
+/// explicitly not authoritative sources for profile revision.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct CharacterCardReturnAuthoritySnapshot {
+    pub world_id: WorldId,
+    pub character_id: CharacterId,
+    pub session_id: SessionId,
+    pub branch_id: BranchId,
+    pub profile_revision: u64,
+}
+
+#[async_trait]
+pub trait CharacterCardReturnAuthorityRepository: Send + Sync {
+    /// Resolve exactly one live RP authority record for the binding target.
+    /// Ambiguous, missing, stale, or inaccessible authority must fail closed.
+    async fn resolve_authority(
+        &self,
+        target: &CharacterCardBindingTarget,
+        contexts: &[CharacterCardBindingContext],
+    ) -> Result<CharacterCardReturnAuthoritySnapshot, DomainError>;
+}
