+fn validate_authority_snapshot(
+    binding: &CharacterCardBinding,
+    snapshot: &CharacterCardReturnAuthoritySnapshot,
+    expected_profile_revision: u64,
+) -> Result<(), DomainError> {
+    if snapshot.world_id != binding.target.world_id
+        || snapshot.character_id != binding.target.character_id
+    {
+        return Err(DomainError::Conflict(
+            "authoritative RP target does not match Character Card binding target".to_string(),
+        ));
+    }
+    if binding.target.scope_kind == BindingScopeKind::SessionCharacter
+        && binding.target.source_session_id.as_ref() != Some(&snapshot.session_id)
+    {
+        return Err(DomainError::Conflict(
+            "authoritative RP session does not match session-created Character binding provenance"
+                .to_string(),
+        ));
+    }
+    if !binding.contexts.iter().any(|context| {
+        context.session_id == snapshot.session_id && context.branch_id == snapshot.branch_id
+    }) {
+        return Err(DomainError::Conflict(
+            "authoritative RP session/branch is not an attached binding context".to_string(),
+        ));
+    }
+    if snapshot.profile_revision != expected_profile_revision {
+        return Err(DomainError::Conflict(format!(
+            "RP profile revision CAS failed: expected {expected_profile_revision}, current {}",
+            snapshot.profile_revision
+        )));
+    }
+    if binding.profile_revision_at_last_sync != Some(expected_profile_revision) {
+        return Err(DomainError::Conflict(format!(
+            "binding profile revision is stale: expected synchronized revision {expected_profile_revision}, binding records {:?}",
+            binding.profile_revision_at_last_sync
+        )));
+    }
+    Ok(())
+}
