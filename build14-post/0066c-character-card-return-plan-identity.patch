+fn staged_return_transaction_id(
+    staged_ref: &str,
+    format: PortableCharacterCardFormat,
+) -> Result<String, DomainError> {
+    let file_name = staged_ref.strip_prefix("staging/").ok_or_else(|| {
+        DomainError::InvalidData("Character Card staged ref must be under staging/".to_string())
+    })?;
+    let (transaction_id, extension) = file_name.rsplit_once('.').ok_or_else(|| {
+        DomainError::InvalidData("Character Card staged ref has no extension".to_string())
+    })?;
+    if extension != format.as_str() {
+        return Err(DomainError::Conflict(
+            "Character Card staged ref format does not match Return format".to_string(),
+        ));
+    }
+    if transaction_id.is_empty()
+        || transaction_id.len() > 128
+        || !transaction_id
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_'))
+    {
+        return Err(DomainError::InvalidData(
+            "Character Card staged transaction id is invalid".to_string(),
+        ));
+    }
+    Ok(transaction_id.to_string())
+}
