+fn canonical_return_choices_hash(
+    choices: &BTreeMap<String, ReturnFieldChoice>,
+) -> Result<String, DomainError> {
+    let bytes = serde_json::to_vec(choices).map_err(|error| {
+        DomainError::InvalidData(format!(
+            "failed to canonicalize Character Card Return choices: {error}"
+        ))
+    })?;
+    Ok(sha256_hex(&bytes))
+}
 
