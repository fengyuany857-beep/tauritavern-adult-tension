+            return Err("JSON Return plan cannot replace avatar pixels".to_string());
+        }
+        let Some(file_name) = self.staged_import_ref.strip_prefix("staging/") else {
+            return Err("return import plan staged ref must be under staging/".to_string());
+        };
+        let Some((transaction_id, extension)) = file_name.rsplit_once('.') else {
+            return Err("return import plan staged ref has no extension".to_string());
+        };
+        if transaction_id != self.transaction_id || extension != self.format {
+            return Err("return import plan staged ref does not match transaction/format".to_string());
+        }
+        for (name, hash) in [
+            ("expectedCardHash", self.expected_card_hash.as_str()),
+            ("stagedImportHash", self.staged_import_hash.as_str()),
+            ("resolvedChoicesHash", self.resolved_choices_hash.as_str()),
+            ("expectedFinalCardHash", self.expected_final_card_hash.as_str()),
+        ] {
+            if hash.len() != 64 || !hash.bytes().all(|byte| byte.is_ascii_hexdigit()) {
+                return Err(format!("return import plan {name} must be SHA-256 hex"));
+            }
+        }
+        if let Some(hash) = self.base_snapshot_hash.as_deref()
+            && (hash.len() != 64 || !hash.bytes().all(|byte| byte.is_ascii_hexdigit()))
+        {
+            return Err("return import plan baseSnapshotHash must be SHA-256 hex".to_string());
+        }
         Ok(())
     }
 }
