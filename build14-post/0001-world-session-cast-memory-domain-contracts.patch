+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn manifest(world: &str, revision: u64, fingerprint: &str) -> WorldManifest {
+        WorldManifest {
+            schema_version: RP_ARCHITECTURE_SCHEMA_VERSION,
+            world_id: WorldId(world.to_string()),
+            title: world.to_string(),
+            manifest_revision: 1,
+            canon_revision: revision,
+            canon_fingerprint: fingerprint.to_string(),
+            immutable_rules: Vec::new(),
+            canon_entity_refs: Vec::new(),
+            lore_pack_refs: Vec::new(),
+            compatibility: BTreeMap::new(),
+        }
+    }
+
+    fn session(world: &str, revision: u64, fingerprint: &str) -> SessionIdentity {
+        SessionIdentity {
+            schema_version: RP_ARCHITECTURE_SCHEMA_VERSION,
+            session_id: SessionId("session-1".to_string()),
+            world_id: WorldId(world.to_string()),
+            bound_canon_revision: revision,
+            bound_canon_fingerprint: fingerprint.to_string(),
+            session_status: SessionStatus::Active,
+            host_chat_id: Some("chat-1".to_string()),
+            active_branch_id: BranchId("main".to_string()),
+        }
+    }
+
+    #[test]
+    fn world_binding_distinguishes_world_mismatch_from_revision_divergence() {
+        let bound = session("world-a", 17, "fp-17");
+        assert_eq!(
+            check_world_binding(&bound, &manifest("world-b", 17, "fp-17")),
+            WorldBindingDecision::WorldBindingMismatch
+        );
+        assert_eq!(
+            check_world_binding(&bound, &manifest("world-a", 18, "fp-18")),
+            WorldBindingDecision::WorldRevisionDiverged
+        );
+        assert_eq!(
+            check_world_binding(&bound, &manifest("world-a", 17, "fp-17")),
+            WorldBindingDecision::Match
+        );
+    }
+
+    #[test]
+    fn narrative_role_and_control_owner_are_independent() {
+        let entity = CharacterEntity {
+            schema_version: RP_ARCHITECTURE_SCHEMA_VERSION,
+            character_id: CharacterId("char-eve".to_string()),
+            origin: CharacterOrigin {
+                kind: CharacterOriginKind::SessionCreated,
+                world_ref: None,
+                source_session_id: Some(SessionId("session-1".to_string())),
+            },
+            narrative_role: NarrativeRole::Main,
+            control_owner: ControlOwner::Ai,
+            control_policy: ControlPolicy::Normal,
+            lifecycle_status: LifecycleStatus::Active,
+            first_seen_turn: 1,
+            promoted_at_turn: Some(42),
+            profile_revision: 1,
+            profile: CharacterProfile::default(),
+        };
+        assert_eq!(entity.narrative_role, NarrativeRole::Main);
+        assert_eq!(entity.control_owner, ControlOwner::Ai);
+    }
+
+    #[test]
+    fn cast_registry_keys_by_immutable_character_id_not_display_name() {
+        let mut registry = CastRegistry::default();
+        let id = CharacterId("char-eve".to_string());
+        let mut profile = CharacterProfile::default();
+        profile.identity.display_name = Some("伊芙".to_string());
+        registry.characters.insert(
+            id.clone(),
+            CharacterEntity {
+                schema_version: RP_ARCHITECTURE_SCHEMA_VERSION,
+                character_id: id.clone(),
+                origin: CharacterOrigin {
+                    kind: CharacterOriginKind::WorldCanon,
+                    world_ref: Some("world-a:characters/eve".to_string()),
+                    source_session_id: None,
+                },
+                narrative_role: NarrativeRole::Supporting,
+                control_owner: ControlOwner::Ai,
+                control_policy: ControlPolicy::Normal,
+                lifecycle_status: LifecycleStatus::Active,
+                first_seen_turn: 1,
+                promoted_at_turn: None,
+                profile_revision: 1,
+                profile,
+            },
+        );
+        registry
+            .characters
+            .get_mut(&id)
+            .expect("character must exist")
+            .profile
+            .identity
+            .display_name = Some("Eve".to_string());
+        assert!(registry.characters.contains_key(&id));
+    }
+
+    #[test]
+    fn inferred_character_knowledge_has_no_canon_authority_by_default() {
+        let knowledge = CharacterKnowledge {
+            character_id: CharacterId("char-eve".to_string()),
+            subject: "BX-100".to_string(),
+            predicate: "may be an earlier batch".to_string(),
+            state: KnowledgeState::Suspects,
+            source: KnowledgeSource {
+                kind: KnowledgeSourceKind::Inferred,
+                reference: None,
+                turn: Some(9),
+            },
+            canon_authority: false,
+        };
+        assert!(!knowledge.canon_authority);
+    }
+
+    #[test]
+    fn archive_memory_is_distinct_from_retraction() {
+        let record = MemoryRecord {
+            id: "memory-1".to_string(),
+            tier: MemoryTier::Archive,
+            summary: "cold but historically valid".to_string(),
+            source_refs: vec![],
+            confidence: None,
+            character_refs: vec![],
+            source_turn: Some(3),
+            retracted: false,
+        };
+        assert_eq!(record.tier, MemoryTier::Archive);
+        assert!(!record.retracted);
+    }
