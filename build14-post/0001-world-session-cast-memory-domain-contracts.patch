+pub fn check_world_binding(
+    session: &SessionIdentity,
+    manifest: &WorldManifest,
+) -> WorldBindingDecision {
+    if session.world_id != manifest.world_id {
+        return WorldBindingDecision::WorldBindingMismatch;
+    }
+
+    if session.bound_canon_revision != manifest.canon_revision
+        || session.bound_canon_fingerprint != manifest.canon_fingerprint
+    {
+        return WorldBindingDecision::WorldRevisionDiverged;
+    }
+
+    WorldBindingDecision::Match
+}
