+fn validate_binding_plan_cas(
+    binding: &CharacterCardBinding,
+    plan: &ReturnImportPlan,
+) -> Result<(), DomainError> {
+    if binding.binding_id != plan.target_binding_id {
+        return Err(DomainError::Conflict(
+            "Character Card Return binding identity changed since planning".to_string(),
+        ));
+    }
+    if binding.generation != plan.expected_binding_generation {
+        return Err(DomainError::Conflict(format!(
+            "Character Card Return binding generation CAS failed: expected {}, current {}",
+            plan.expected_binding_generation, binding.generation
+        )));
+    }
+    if binding.card_revision != plan.expected_card_revision {
+        return Err(DomainError::Conflict(format!(
+            "Character Card Return card revision CAS failed: expected {}, current {}",
+            plan.expected_card_revision, binding.card_revision
+        )));
+    }
+    if binding.profile_revision_at_last_sync != Some(plan.expected_profile_revision) {
+        return Err(DomainError::Conflict(format!(
+            "Character Card Return RP profile CAS failed: expected {}, binding records {:?}",
+            plan.expected_profile_revision, binding.profile_revision_at_last_sync
+        )));
+    }
+    Ok(())
+}
