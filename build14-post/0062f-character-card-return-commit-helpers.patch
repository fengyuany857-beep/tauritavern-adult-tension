+fn validate_local_card_plan_hash(
+    local_raw: &Value,
+    plan: &ReturnImportPlan,
+) -> Result<(), DomainError> {
+    let local_hash = canonical_definition_hash(&portable_definition_projection(local_raw.clone()))
+        .map_err(DomainError::InvalidData)?;
+    if local_hash != plan.expected_card_hash {
+        return Err(DomainError::Conflict(format!(
+            "Character Card Return local card CAS failed: expected {}, current {}",
+            plan.expected_card_hash, local_hash
+        )));
+    }
+    Ok(())
+}
+
+/// Apply only portable definition values onto the current stored card. Starting
+/// from LOCAL deliberately preserves storage/runtime-only fields stripped by
+/// portable_definition_projection (chat/date/fav/world/internal namespace).
+/// Missing imported fields cannot delete LOCAL portable values because plan
+/// resolution already treats missing as non-deletion.
+fn merge_resolved_portable_into_local(
+    local_raw: &Value,
+    resolved_portable: &Value,
+    expected_resolved_hash: &str,
+) -> Result<Value, DomainError> {
+    scan_portable_card(resolved_portable).map_err(portable_security_error)?;
+    let mut merged = local_raw.clone();
+    overlay_return_value(&mut merged, resolved_portable);
+    let projected = portable_definition_projection(merged.clone());
+    let projected_hash = canonical_definition_hash(&projected).map_err(DomainError::InvalidData)?;
+    if projected_hash != expected_resolved_hash {
+        return Err(DomainError::Conflict(
+            "resolved Character Card cannot be merged without changing portable definition identity"
+                .to_string(),
+        ));
+    }
+    Ok(merged)
+}
+
+fn overlay_return_value(target: &mut Value, source: &Value) {
+    match (target, source) {
+        (Value::Object(target), Value::Object(source)) => {
+            for (key, source_value) in source {
+                match target.get_mut(key) {
+                    Some(target_value) => overlay_return_value(target_value, source_value),
+                    None => {
+                        target.insert(key.clone(), source_value.clone());
+                    }
+                }
+            }
+        }
+        (target, source) => *target = source.clone(),
+    }
+}
+
+async fn advance_return_journal(
+    materialization: &dyn CharacterCardMaterializationRepository,
+    journal: &mut CharacterCardTransactionJournal,
+    next_state: CharacterCardTransactionState,
+) -> Result<(), DomainError> {
+    if !valid_return_journal_transition(journal.state, next_state) {
+        return Err(DomainError::Conflict(format!(
+            "invalid Character Card Return journal transition: {:?} -> {:?}",
+            journal.state, next_state
+        )));
+    }
+    let mut next = journal.clone();
+    next.state = next_state;
+    next.updated_at = Utc::now().to_rfc3339();
+    materialization.write_transaction(&next).await?;
+    *journal = next;
+    Ok(())
+}
+
+fn valid_return_journal_transition(
+    current: CharacterCardTransactionState,
+    next: CharacterCardTransactionState,
+) -> bool {
+    use CharacterCardTransactionState as State;
+    if next == State::RollingBack {
+        return !current.is_terminal() || current == State::RollingBack;
+    }
+    matches!(
+        (current, next),
+        (State::Prepared, State::StagedInputVerified)
+            | (State::StagedInputVerified, State::CardSnapshotSaved)
+            | (State::CardSnapshotSaved, State::CardWritten)
+            | (State::CardWritten, State::BindingWritten)
+            | (State::BindingWritten, State::RpProfileWritten)
+            | (State::BindingWritten, State::IndexesInvalidated)
+            | (State::RpProfileWritten, State::IndexesInvalidated)
+            | (State::IndexesInvalidated, State::ReadbackVerified)
+            | (State::ReadbackVerified, State::Committed)
+            | (State::RollingBack, State::RollingBack)
+            | (State::RollingBack, State::RolledBack)
+    )
+}
 
