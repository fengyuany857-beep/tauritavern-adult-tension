+fn return_transaction_id(plan_token: &str) -> Result<String, DomainError> {
+    if plan_token.len() != 64 || !plan_token.bytes().all(|byte| byte.is_ascii_hexdigit()) {
+        return Err(DomainError::InvalidData(
+            "Character Card Return plan token must be HMAC-SHA256 hex".to_string(),
+        ));
+    }
+    Ok(format!("return-{plan_token}"))
+}
