+async fn parse_staged_card(
+    cards: &dyn CharacterCardReturnRepository,
+    format: PortableCharacterCardFormat,
+    bytes: &[u8],
+) -> Result<Value, DomainError> {
+    match format {
+        PortableCharacterCardFormat::Json => parse_json_card(bytes),
+        PortableCharacterCardFormat::Png => {
+            let json = cards.inspect_png_card_json(bytes).await?;
+            parse_json_card(json.as_bytes())
+        }
+    }
+}
