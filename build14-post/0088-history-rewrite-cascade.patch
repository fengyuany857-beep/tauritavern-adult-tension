--- /dev/null
+++ b/tests/history-rewrite-cascade.test.mjs
@@ -0,0 +1,38 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import test from 'node:test';
+
+const root = path.resolve(import.meta.dirname, '..');
+const state = fs.readFileSync(path.join(root, 'src-tauri/crates/tt-application/src/services/agent_tools/rp/state.rs'), 'utf8');
+const descriptor = fs.readFileSync(path.join(root, 'src-tauri/crates/tt-application/src/services/agent_tools/rp/descriptors.rs'), 'utf8');
+const profile = fs.readFileSync(path.join(root, 'src-tauri/crates/tt-application/src/services/agent_profile_service/defaults.rs'), 'utf8');
+
+test('history rewrite uses existing retraction, supersedes, and replacement semantics', () => {
+    assert.match(state, /fn apply_fact_replacement_cascade/);
+    assert.match(state, /prior\.truth_status = "SUPERSEDED"/);
+    assert.match(state, /event\.status = "cancelled"/);
+    assert.match(state, /fact_edge_is_stale/);
+    assert.match(state, /event_edge_is_stale/);
+    assert.match(state, /fn active_knowledge_indices/);
+    assert.match(state, /state\.events\.iter\(\)\.filter\(\|event\| event_is_active\(event\)\)/);
+    assert.match(state, /let mut staged_state = state\.clone\(\)/);
+});
+
+test('history rewrite contract keeps authority separate from happened history', () => {
+    assert.match(descriptor, /History rewrite|history rewrite/);
+    assert.match(descriptor, /supersedes/);
+    assert.match(descriptor, /replacement event/);
+    assert.match(descriptor, /grant.*(?:never|not).*evidence|grant.*proof/i);
+    assert.match(descriptor, /real .*?(?:accepted|staged).*?(?:id|reference)/i);
+    assert.match(profile, /retract_turns/);
+    assert.match(profile, /facts\.supersedes/);
+});
+
+test('stage hotfix contract remains present', () => {
+    assert.match(descriptor, /RP_STAGE_TURN_MODEL_CONTRACT_V1/);
+    assert.match(profile, /npc_updates \(not npcs\)/);
+    assert.match(profile, /at most 3 stage attempts/);
+    assert.match(profile, /at most one successful stage/);
+    assert.match(profile, /render only the successfully staged beat/);
+});
