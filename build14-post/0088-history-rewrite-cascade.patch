+fn active_knowledge_indices(state: &RpState) -> HashSet<usize> {
+    let mut latest_by_proposition = BTreeMap::<(String, String, String), usize>::new();
+    for (index, knowledge) in state.knowledge.iter().enumerate() {
+        latest_by_proposition.insert(
+            (compact(&knowledge.character_id), compact(&knowledge.subject), compact(&knowledge.predicate)),
+            index,
+        );
+    }
+    latest_by_proposition
+        .into_values()
+        .filter(|index| {
+            let knowledge = &state.knowledge[*index];
+            let fact_is_valid = knowledge
+                .fact_id
+                .as_deref()
+                .is_none_or(|fact_id| state.facts.iter().any(|fact| fact.id == fact_id && fact_is_active(fact)));
+            let event_is_valid = knowledge
+                .source
+                .as_ref()
+                .filter(|source| source.kind == "event_derived")
+                .and_then(|source| source.reference.as_deref())
+                .is_none_or(|event_id| state.events.iter().any(|event| event.id == event_id && event_is_active(event)));
+            fact_is_valid && event_is_valid
+        })
