+fn apply_fact_replacement_cascade(state: &mut RpState, prior_id: &str, _replacement_id: &str, turn: u64) {
+    let mut invalidated_fact_ids = HashSet::new();
+    if let Some(prior) = state.facts.iter_mut().find(|item| item.id == prior_id && fact_is_active(item)) {
+        prior.truth_status = "SUPERSEDED".to_string();
+        prior.invalid_at_turn = Some(turn);
+        invalidated_fact_ids.insert(prior.id.clone());
+    }
+    if invalidated_fact_ids.is_empty() {
+        return;
+    }
+
+    // A replacement keeps the old records for audit, but removes their
+    // causal edges from the effective history projection.
+    let invalidated_event_ids = state
+        .facts
+        .iter()
+        .filter(|fact| invalidated_fact_ids.contains(&fact.id))
+        .filter_map(|fact| fact.source.as_ref())
+        .filter(|source| source.kind == "event_derived")
+        .filter_map(|source| source.reference.clone())
+        .collect::<HashSet<_>>();
+    for event in state.events.iter_mut().filter(|event| invalidated_event_ids.contains(&event.id)) {
+        event.status = "cancelled".to_string();
+    }
+    state.knowledge.retain(|knowledge| {
+        let fact_edge_is_stale = knowledge.fact_id.as_deref().is_some_and(|fact_id| invalidated_fact_ids.contains(fact_id));
+        let event_edge_is_stale = knowledge
+            .source
+            .as_ref()
+            .filter(|source| source.kind == "event_derived")
+            .and_then(|source| source.reference.as_deref())
+            .is_some_and(|event_id| invalidated_event_ids.contains(event_id));
+        !fact_edge_is_stale && !event_edge_is_stale
+    });
+}
