+    async fn execute_case(&self, case_id: &str, ctx: &SuiteContext) -> Result<CaseRunResult, ApplicationError> {
+        match case_id {
+            "agent.required_tool_surface" => self.case_required_tools(ctx).await,
+            "rp.empty_state" => self.case_empty_state(ctx).await,
+            "rp.stage_recall_roundtrip" => self.case_stage_recall(ctx).await,
+            "rp.knowledge_provenance_pair" => self.case_knowledge_provenance(ctx).await,
+            "rp.retraction_pair" => self.case_retraction(ctx).await,
+            "rp.authority_pause_gate" => self.case_pause_gate(ctx).await,
+            "world.binding_matrix" => self.case_world_binding(ctx).await,
+            "cast.lifecycle_revision" => self.case_cast_lifecycle(ctx).await,
+            "memory.tiny_dedup" => self.case_memory_dedup(ctx).await,
+            "canon.confirmation_fail_closed" => self.case_canon_fail_closed(ctx).await,
+            "persist.commit_reopen" => self.case_persist_reopen(ctx).await,
+            "branch.fork_isolation" => self.case_branch_isolation(ctx).await,
+            "burst.quick_local" => self.case_quick_burst(ctx).await,
+            _ => Err(ApplicationError::InternalError(format!("acceptance.case_unknown: {case_id}"))),
+        }
+    }
+
+    async fn case_required_tools(&self, ctx: &SuiteContext) -> Result<CaseRunResult, ApplicationError> {
+        const REQUIRED: &[&str] = &["rp.state", "rp.recall", "rp.stage_turn", "rp.confirm_canonization", "workspace.write_file", "workspace.commit", "workspace.finish"];
+        for name in REQUIRED {
+            let id = ToolId::builtin(name)?;
+            if self.agent_runtime_service.tool_catalog().get(&id).is_none() {
+                return Err(ApplicationError::ValidationError(format!("acceptance.required_tool_missing: {name}")));
+            }
+            if !ctx.profile.tools.allow.iter().any(|item| item == name) {
+                return Err(ApplicationError::ValidationError(format!("acceptance.profile_tool_missing: {name}")));
+            }
+        }
+        Ok(CaseRunResult::pass("Required RP and workspace tools exist in both the catalog and Adult Tension profile."))
+    }
