+/// selected chat history branch.
+#[async_trait]
+pub trait CharacterCardReturnPersistentStateRepository: Send + Sync {
+    async fn read_persistent_text(
+        &self,
+        workspace_id: &str,
+        state_id: &str,
+        path: &WorkspacePath,
+    ) -> Result<String, DomainError>;
+}
