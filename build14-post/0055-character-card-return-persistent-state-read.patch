+#[async_trait::async_trait]
+impl CharacterCardReturnPersistentStateRepository for FileAgentRepository {
+    async fn read_persistent_text(
+        &self,
+        workspace_id: &str,
+        state_id: &str,
+        path: &WorkspacePath,
+    ) -> Result<String, DomainError> {
+        let state_dir = self.persistent_state_dir(workspace_id, state_id)?;
+        let manifest = self.read_persistent_state_manifest(&state_dir).await?;
+        if manifest.workspace_id != workspace_id || manifest.state_id != state_id {
+            return Err(DomainError::InvalidData(
+                "character_card_return.persistent_state_identity_mismatch".to_string(),
+            ));
+        }
+        let requested = path.as_str();
+        if !manifest.files.iter().any(|file| file.path == requested) {
+            return Err(DomainError::NotFound(format!(
+                "character_card_return.persistent_file_not_found: {requested}"
+            )));
+        }
+
+        let target = state_dir.join(requested);
+        let metadata = fs::symlink_metadata(&target).await.map_err(|error| {
+            if error.kind() == std::io::ErrorKind::NotFound {
+                DomainError::NotFound(format!(
+                    "character_card_return.persistent_file_not_found: {requested}"
+                ))
+            } else {
+                DomainError::InternalError(format!(
+                    "Failed to inspect durable persistent file {}: {error}",
+                    target.display()
+                ))
+            }
+        })?;
+        if metadata.file_type().is_symlink() || !metadata.is_file() {
+            return Err(DomainError::InvalidData(format!(
+                "character_card_return.persistent_file_invalid: {requested}"
+            )));
+        }
+
+        let canonical_state = fs::canonicalize(&state_dir).await.map_err(|error| {
+            DomainError::InternalError(format!(
+                "Failed to resolve durable persistent state {}: {error}",
+                state_dir.display()
+            ))
+        })?;
+        let canonical_target = fs::canonicalize(&target).await.map_err(|error| {
+            DomainError::InternalError(format!(
+                "Failed to resolve durable persistent file {}: {error}",
+                target.display()
+            ))
+        })?;
+        if !canonical_target.starts_with(&canonical_state) {
+            return Err(DomainError::InvalidData(format!(
+                "character_card_return.persistent_file_escape: {requested}"
+            )));
+        }
+
+        fs::read_to_string(&canonical_target).await.map_err(|error| {
+            DomainError::InternalError(format!(
+                "Failed to read durable persistent file {}: {error}",
+                canonical_target.display()
+            ))
+        })
+    }
+}
 
