+pub(crate) fn compute_return_plan_token(
+    secret: &[u8],
+    plan: &ReturnImportPlan,
+    session_id: &SessionId,
+    branch_id: &BranchId,
+) -> String {
+    let mut message = Vec::from(b"tauritavern.character-card-return-plan.v1\0".as_slice());
+    let generation = plan.expected_binding_generation.to_string();
+    let card_revision = plan.expected_card_revision.to_string();
+    let profile_revision = plan.expected_profile_revision.to_string();
+    for component in [
+        plan.target_binding_id.as_str(),
+        generation.as_str(),
+        card_revision.as_str(),
+        plan.expected_card_hash.as_str(),
+        profile_revision.as_str(),
+        plan.staged_import_hash.as_str(),
+        plan.base_snapshot_hash.as_deref().unwrap_or_default(),
+        plan.resolved_choices_hash.as_str(),
+        session_id.0.as_str(),
+        branch_id.0.as_str(),
+    ] {
+        message.extend_from_slice(&(component.len() as u64).to_be_bytes());
+        message.extend_from_slice(component.as_bytes());
+    }
+    let mac = return_plan_hmac_sha256(secret, &message);
+    let mut output = String::with_capacity(64);
+    for byte in mac {
+        let _ = write!(&mut output, "{byte:02x}");
+    }
+    output
+}
+
+fn return_plan_hmac_sha256(secret: &[u8], message: &[u8]) -> [u8; 32] {
+    const BLOCK: usize = 64;
+    let mut key = [0u8; BLOCK];
+    if secret.len() > BLOCK {
+        key[..32].copy_from_slice(&Sha256::digest(secret));
+    } else {
+        key[..secret.len()].copy_from_slice(secret);
+    }
+    let mut inner_pad = [0x36u8; BLOCK];
+    let mut outer_pad = [0x5cu8; BLOCK];
+    for index in 0..BLOCK {
+        inner_pad[index] ^= key[index];
+        outer_pad[index] ^= key[index];
+    }
+    let mut inner = Sha256::new();
+    inner.update(inner_pad);
+    inner.update(message);
+    let inner_digest = inner.finalize();
+    let mut outer = Sha256::new();
+    outer.update(outer_pad);
+    outer.update(inner_digest);
+    outer.finalize().into()
+}
 
