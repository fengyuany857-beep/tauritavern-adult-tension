+fn resolve_return_decisions(
+    local: &Value,
+    decisions: &[MergeFieldDecision],
+    choices: &BTreeMap<String, ReturnFieldChoice>,
+) -> Result<Value, DomainError> {
+    let mut resolved = local.clone();
+    for decision in decisions {
+        let value = if let Some(value) = decision.resolution.clone() {
+            value
+        } else {
+            match choices.get(&decision.field_path) {
+                Some(ReturnFieldChoice::KeepLocal) => decision.local.clone().ok_or_else(|| {
+                    DomainError::InvalidData(format!(
+                        "field {} has no local value; implicit deletion is not allowed",
+                        decision.field_path
+                    ))
+                })?,
+                Some(ReturnFieldChoice::UseImported) => decision.imported.clone().ok_or_else(|| {
+                    DomainError::InvalidData(format!(
+                        "field {} is missing from imported card; missing is not deletion",
+                        decision.field_path
+                    ))
+                })?,
+                None => {
+                    return Err(DomainError::Conflict(format!(
+                        "field {} requires an explicit merge choice",
+                        decision.field_path
+                    )));
+                }
+            }
+        };
+        set_return_field(&mut resolved, &decision.field_path, value)?;
+    }
+    for field in choices.keys() {
+        if !decisions.iter().any(|decision| &decision.field_path == field) {
+            return Err(DomainError::InvalidData(format!(
+                "merge choice references unknown field {field}"
+            )));
+        }
+    }
+    Ok(resolved)
+}
+
+fn set_return_field(target: &mut Value, field_path: &str, value: Value) -> Result<(), DomainError> {
+    let root = target.as_object_mut().ok_or_else(|| {
+        DomainError::InvalidData("resolved Character Card root must be an object".to_string())
+    })?;
+    if let Some(data_key) = field_path.strip_prefix("data.") {
+        let data = root
+            .entry("data")
+            .or_insert_with(|| Value::Object(Default::default()))
+            .as_object_mut()
+            .ok_or_else(|| DomainError::InvalidData(
+                "resolved Character Card data must be an object".to_string(),
+            ))?;
+        data.insert(data_key.to_string(), value);
+        return Ok(());
+    }
+    if field_path.contains('.') {
+        return Err(DomainError::InvalidData(format!(
+            "unsupported Character Card merge field path {field_path}"
+        )));
+    }
+    root.insert(field_path.to_string(), value);
+    Ok(())
+}
