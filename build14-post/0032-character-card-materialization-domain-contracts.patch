+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn binding(scope_kind: BindingScopeKind) -> CharacterCardBinding {
+        CharacterCardBinding {
+            schema_version: CHARACTER_CARD_MATERIALIZATION_SCHEMA_VERSION,
+            binding_id: "binding-random-1".to_string(),
+            target: CharacterCardBindingTarget {
+                scope_kind,
+                world_id: WorldId("world-a".to_string()),
+                character_id: CharacterId("character-stable-a".to_string()),
+                source_session_id: Some(SessionId("session-origin".to_string())),
+            },
+            contexts: vec![CharacterCardBindingContext {
+                session_id: SessionId("session-current".to_string()),
+                branch_id: BranchId("branch-a".to_string()),
+                last_seen_profile_revision: Some(9),
+            }],
+            card_storage_identity: "characters/lin-yue.png".to_string(),
+            card_revision: 7,
+            profile_revision_at_last_sync: Some(9),
+            generation: 3,
+            status: BindingStatus::Active,
+            created_at: "2026-09-11T00:00:00Z".to_string(),
+            updated_at: "2026-09-11T00:00:00Z".to_string(),
+        }
+    }
+
+    #[test]
+    fn binding_identity_is_character_not_branch() {
+        let mut value = binding(BindingScopeKind::SessionCharacter);
+        let identity_before = value.target.character_id.clone();
+        value.contexts[0].branch_id = BranchId("branch-b".to_string());
+        assert_eq!(value.target.character_id, identity_before);
+        assert!(value.validate().is_ok());
+    }
+
+    #[test]
+    fn canonized_binding_keeps_identity_and_binding_lineage() {
+        let mut value = binding(BindingScopeKind::SessionCharacter);
+        let character_id = value.target.character_id.clone();
+        let binding_id = value.binding_id.clone();
+        value.target.scope_kind = BindingScopeKind::WorldCharacter;
+        assert_eq!(value.target.character_id, character_id);
+        assert_eq!(value.binding_id, binding_id);
+        assert!(value.validate().is_ok());
+    }
+
+    #[test]
+    fn binding_rejects_absolute_ios_sandbox_path() {
+        let mut value = binding(BindingScopeKind::SessionCharacter);
+        value.card_storage_identity =
+            "/private/var/mobile/Containers/Data/Application/UUID/card.png".to_string();
+        assert!(value.validate().is_err());
+    }
+
+    #[test]
+    fn default_role_policy_matches_v13_confirmation_boundaries() {
+        let policy = CastLifecyclePolicy::default();
+        assert_eq!(policy.incidental_to_recurring, TransitionMode::AutoAllowed);
+        assert_eq!(
+            policy.recurring_to_supporting,
+            TransitionMode::UserConfirmRequired
+        );
+        assert_eq!(
+            policy.supporting_to_main,
+            TransitionMode::UserConfirmRequired
+        );
+        assert_eq!(policy.demotion_policy, TransitionMode::ManualOnly);
+    }
+
+    #[test]
+    fn portable_return_metadata_has_no_rp_address_fields() {
+        let metadata = PortableReturnMetadata {
+            binding_id: "binding-random-1".to_string(),
+            export_id: "export-random-1".to_string(),
+            binding_generation: 1,
+            base_card_revision: 7,
+            base_card_hash: "abc123".to_string(),
+            origin_proof: "proof".to_string(),
+        };
+        let json = serde_json::to_value(metadata).expect("metadata serializes");
+        assert!(json.get("characterId").is_none());
+        assert!(json.get("worldId").is_none());
+        assert!(json.get("sessionId").is_none());
+        assert!(json.get("branchId").is_none());
+    }
+
+    #[test]
+    fn transaction_terminal_states_are_explicit() {
+        assert!(CharacterCardTransactionState::Committed.is_terminal());
+        assert!(CharacterCardTransactionState::RolledBack.is_terminal());
+        assert!(CharacterCardTransactionState::RollbackFailed.is_terminal());
+        assert!(!CharacterCardTransactionState::CardWritten.is_terminal());
+    }
+
+    #[test]
+    fn missing_and_empty_are_not_collapsed() {
+        assert_ne!(FieldPresence::Missing, FieldPresence::Empty);
+        assert_ne!(FieldPresence::Missing, FieldPresence::UnsetIntent);
+    }
+
+    #[test]
+    fn return_plan_requires_generation_and_hashes() {
+        let plan = ReturnImportPlan {
+            plan_token: "plan-random".to_string(),
+            target_binding_id: "binding-random".to_string(),
+            expected_binding_generation: 4,
+            expected_card_revision: 8,
+            expected_card_hash: "cardhash".to_string(),
+            expected_profile_revision: 11,
+            staged_import_hash: "importhash".to_string(),
+            base_snapshot_hash: Some("basehash".to_string()),
+            resolved_choices_hash: "choiceshash".to_string(),
+        };
+        assert!(plan.validate_shape().is_ok());
+    }
+}
