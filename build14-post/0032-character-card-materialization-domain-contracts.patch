+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct CharacterCardBinding {
+    pub schema_version: u32,
+    pub binding_id: String,
+    pub target: CharacterCardBindingTarget,
+    pub contexts: Vec<CharacterCardBindingContext>,
+    pub card_storage_identity: String,
+    pub card_revision: u64,
+    pub profile_revision_at_last_sync: Option<u64>,
+    pub generation: u64,
+    pub status: BindingStatus,
+    pub created_at: String,
+    pub updated_at: String,
+}
+
+impl CharacterCardBinding {
+    pub fn validate(&self) -> Result<(), String> {
+        if self.schema_version != CHARACTER_CARD_MATERIALIZATION_SCHEMA_VERSION {
+            return Err("unsupported character card binding schema version".to_string());
+        }
+        if self.binding_id.trim().is_empty() {
+            return Err("bindingId must not be empty".to_string());
+        }
+        if self.target.character_id.0.trim().is_empty() {
+            return Err("characterId must not be empty".to_string());
+        }
+        if self.target.world_id.0.trim().is_empty() {
+            return Err("worldId must not be empty".to_string());
+        }
+        if self.generation == 0 {
+            return Err("binding generation must start at 1".to_string());
+        }
+        if !is_stable_storage_identity(&self.card_storage_identity) {
+            return Err("card storage identity must be stable and relative".to_string());
+        }
+        if self.target.scope_kind == BindingScopeKind::SessionCharacter
+            && self.target.source_session_id.is_none()
+        {
+            return Err("session character binding requires sourceSessionId provenance".to_string());
+        }
+        Ok(())
+    }
+}
+
+fn is_stable_storage_identity(value: &str) -> bool {
+    let value = value.trim();
+    if value.is_empty()
+        || value.starts_with('/')
+        || value.starts_with('\\')
+        || value.contains(":/")
+        || value.contains(":\\")
+    {
+        return false;
+    }
+    !value
+        .split(['/', '\\'])
+        .any(|segment| segment == ".." || segment.is_empty())
+}
