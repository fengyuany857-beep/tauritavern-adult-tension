+#[serde(rename_all = "SCREAMING_SNAKE_CASE")]
+pub enum CharacterCardTransactionState {
+    Prepared,
+    StagedInputVerified,
+    CardSnapshotSaved,
+    CardWritten,
+    BindingWritten,
+    RpProfileWritten,
+    IndexesInvalidated,
+    ReadbackVerified,
+    Committed,
+    RollingBack,
+    RolledBack,
+    RollbackFailed,
+}
+
+impl CharacterCardTransactionState {
+    pub fn is_terminal(self) -> bool {
+        matches!(
+            self,
+            Self::Committed | Self::RolledBack | Self::RollbackFailed
+        )
+    }
+}
