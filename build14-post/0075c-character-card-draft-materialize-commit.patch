+fn validate_commit_cas(cas: &CharacterCardDraftCas) -> Result<(), ApplicationError> {
+    for (label, value) in [
+        ("stableChatId", cas.stable_chat_id.as_str()),
+        ("stateId", cas.state_id.as_str()),
+        ("worldId", cas.world_id.as_str()),
+        ("sessionId", cas.session_id.as_str()),
+        ("activeBranchId", cas.active_branch_id.as_str()),
+        ("characterId", cas.character_id.as_str()),
+        ("proposedBindingId", cas.proposed_binding_id.as_str()),
+    ] {
+        if value.trim().is_empty() {
+            return Err(ApplicationError::ValidationError(format!(
+                "character_card_draft.invalid_cas: {label} must not be empty"
+            )));
+        }
+    }
+    Ok(())
+}
+
+fn create_character_dto(definition: &Value) -> Result<CreateCharacterDto, ApplicationError> {
+    let root = definition.as_object().ok_or_else(|| {
+        ApplicationError::ValidationError(
+            "character_card_draft.invalid_definition: card root must be an object".to_string(),
+        )
+    })?;
+    if root.get("spec").and_then(Value::as_str) != Some("chara_card_v2") {
+        return Err(ApplicationError::ValidationError(
+            "character_card_draft.invalid_definition: spec must be chara_card_v2".to_string(),
+        ));
+    }
+    let data = root.get("data").and_then(Value::as_object).ok_or_else(|| {
+        ApplicationError::ValidationError(
+            "character_card_draft.invalid_definition: data must be an object".to_string(),
+        )
+    })?;
+    if data
+        .get("extensions")
+        .and_then(Value::as_object)
+        .is_some_and(|extensions| extensions.contains_key("tauritavern"))
+    {
+        return Err(ApplicationError::ValidationError(
+            "character_card_draft.protected_namespace: data.extensions.tauritavern is host-owned and cannot be supplied by a draft"
+                .to_string(),
+        ));
+    }
+
+    let name = required_string(data, "name")?;
+    let extensions = data.get("extensions").cloned();
+    let talkativeness = extensions
+        .as_ref()
+        .and_then(Value::as_object)
+        .and_then(|value| value.get("talkativeness"))
+        .and_then(Value::as_f64);
+    let fav = extensions
+        .as_ref()
+        .and_then(Value::as_object)
+        .and_then(|value| value.get("fav"))
+        .and_then(Value::as_bool);
+    let json_data = serde_json::to_string(definition).map_err(|error| {
+        ApplicationError::ValidationError(format!(
+            "character_card_draft.invalid_definition: failed to serialize card JSON: {error}"
+        ))
+    })?;
+
+    Ok(CreateCharacterDto {
+        file_name: None,
+        json_data: Some(json_data),
+        primary_lorebook: None,
+        name,
+        description: optional_string(data, "description"),
+        personality: optional_string(data, "personality"),
+        scenario: optional_string(data, "scenario"),
+        first_mes: optional_string(data, "first_mes"),
+        mes_example: optional_string(data, "mes_example"),
+        creator: Some(optional_string(data, "creator")),
+        creator_notes: Some(optional_string(data, "creator_notes")),
+        character_version: Some(optional_string(data, "character_version")),
+        tags: Some(string_array(data, "tags")?),
+        talkativeness,
+        fav,
+        alternate_greetings: Some(string_array(data, "alternate_greetings")?),
+        system_prompt: Some(optional_string(data, "system_prompt")),
+        post_history_instructions: Some(optional_string(data, "post_history_instructions")),
+        extensions,
+    })
+}
+
+fn required_string(
+    object: &serde_json::Map<String, Value>,
+    key: &str,
+) -> Result<String, ApplicationError> {
+    let value = optional_string(object, key);
+    if value.is_empty() {
+        return Err(ApplicationError::ValidationError(format!(
+            "character_card_draft.invalid_definition: data.{key} must not be empty"
+        )));
+    }
+    Ok(value)
+}
+
+fn optional_string(object: &serde_json::Map<String, Value>, key: &str) -> String {
+    object
+        .get(key)
+        .and_then(Value::as_str)
+        .unwrap_or_default()
+        .to_string()
+}
+
+fn string_array(
+    object: &serde_json::Map<String, Value>,
+    key: &str,
+) -> Result<Vec<String>, ApplicationError> {
+    let Some(value) = object.get(key) else { return Ok(Vec::new()); };
+    let Some(values) = value.as_array() else {
+        return Err(ApplicationError::ValidationError(format!(
+            "character_card_draft.invalid_definition: data.{key} must be an array"
+        )));
+    };
+    values
+        .iter()
+        .map(|value| {
+            value.as_str().map(ToOwned::to_owned).ok_or_else(|| {
+                ApplicationError::ValidationError(format!(
+                    "character_card_draft.invalid_definition: data.{key} must contain only strings"
+                ))
+            })
+        })
+        .collect()
+}
