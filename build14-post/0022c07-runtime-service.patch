+async fn create_synthetic_run(
+    sandbox: &AcceptanceSandbox,
+    profile: &ResolvedAgentProfile,
+    suite_run_id: &str,
+    suffix: &str,
+    base_state_id: Option<String>,
+    prompt: &Value,
+) -> Result<AgentRun, ApplicationError> {
+    let now = Utc::now();
+    let run = AgentRun {
+        id: format!("{suite_run_id}-{suffix}"),
+        workspace_id: "acceptance-workspace".to_string(),
+        stable_chat_id: "acceptance-chat".to_string(),
+        chat_ref: AgentChatRef::Character { character_id: "acceptance-character".to_string(), file_name: "acceptance-character.png".to_string() },
+        generation_type: "acceptance".to_string(),
+        profile_id: Some(profile.id.as_str().to_string()),
+        skill_scope_refs: AgentRunSkillScopeRefs::default(),
+        persist_base_state_id: base_state_id,
+        input_message_count: Some(1),
+        presentation: AgentRunPresentation::Foreground,
+        status: AgentRunStatus::Created,
+        created_at: now,
+        updated_at: now,
+    };
+    sandbox.run_repository.create_run(&run).await?;
+    let manifest = build_agent_manifest(&run, profile);
+    sandbox.workspace_repository.initialize_run(&run, &manifest, prompt, profile).await?;
