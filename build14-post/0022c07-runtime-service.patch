+    async fn finish_suite(&self, run_id: &str, build: AcceptanceBuildInfoDto, sandbox: Option<Arc<AcceptanceSandbox>>, desired: AcceptanceSuiteState, stale: usize, model_ready: bool) -> Result<(), ApplicationError> {
+        {
+            let mut hub = self.hub.lock().await;
+            let active = active_mut(&mut hub, run_id)?;
+            active.status.phase = AcceptancePhase::Cleanup;
+            active.status.current_case_id = None;
+            for case in &mut active.status.cases {
+                if matches!(case.state, AcceptanceCaseState::Pending | AcceptanceCaseState::Running) {
+                    case.state = if desired == AcceptanceSuiteState::Cancelled { AcceptanceCaseState::Cancelled } else { AcceptanceCaseState::Skip };
+                    if case.detail.is_none() { case.detail = Some(if desired == AcceptanceSuiteState::Cancelled { "Not run because cancellation was requested.".to_string() } else { "Not run because an earlier core prerequisite failed.".to_string() }); }
+                }
+            }
+            active.status.completed_cases = active.status.cases.len();
+            touch_status(&mut active.status);
+        }
+        let cleaned = if let Some(sandbox) = sandbox {
+            match tokio::time::timeout(CLEANUP_TIMEOUT, self.sandbox_factory.cleanup(&sandbox.sandbox_id)).await {
+                Ok(Ok(())) => true,
+                _ => false,
+            }
+        } else { false };
+        let final_state = if !cleaned { AcceptanceSuiteState::Fail } else { desired };
+        self.finalize_terminal(run_id, build, final_state, cleaned, true, stale, model_ready).await
+    }
+
+    async fn finalize_terminal(&self, run_id: &str, build: AcceptanceBuildInfoDto, mut desired: AcceptanceSuiteState, cleaned: bool, isolation_verified: bool, stale: usize, model_ready: bool) -> Result<(), ApplicationError> {
+        let mut hub = self.hub.lock().await;
+        let mut active = hub.active.take().ok_or_else(|| ApplicationError::NotFound("acceptance.run_not_found".to_string()))?;
+        if active.status.run_id.as_deref() != Some(run_id) {
+            hub.active = Some(active);
+            return Err(ApplicationError::NotFound("acceptance.run_not_found".to_string()));
+        }
+        let has_fail = active.status.cases.iter().any(|case| case.state == AcceptanceCaseState::Fail);
+        let has_warn = active.status.cases.iter().any(|case| case.state == AcceptanceCaseState::Warn);
+        if !cleaned { desired = AcceptanceSuiteState::Fail; }
+        else if has_fail { desired = AcceptanceSuiteState::Fail; }
+        else if desired == AcceptanceSuiteState::Pass && has_warn { desired = AcceptanceSuiteState::PassWithWarnings; }
+        let finished = Utc::now().to_rfc3339();
+        active.status.state = desired.clone();
+        active.status.phase = AcceptancePhase::Complete;
+        active.status.finished_at = Some(finished.clone());
+        active.status.updated_at = finished.clone();
+        active.status.current_case_id = None;
+        active.status.revision = active.status.revision.saturating_add(1);
+        let summary = summarize(&active.status.cases);
+        let report = AcceptanceReportDto {
+            schema_version: REPORT_SCHEMA_VERSION,
+            suite_version: ACCEPTANCE_SUITE_VERSION.to_string(),
+            run_id: run_id.to_string(),
+            started_at: active.status.started_at.clone().unwrap_or_default(),
+            finished_at: finished,
+            overall: desired,
+            build,
+            environment: AcceptanceEnvironmentDto {
+                platform: active.build.platform.clone(),
+                profile_id: ADULT_TENSION_RP_PROFILE_ID.to_string(),
+                profile_runtime_ready: !has_fail,
+                model_configuration_ready: model_ready,
+                stale_sandbox_count_cleaned: stale,
+            },
+            summary,
+            cases: active.status.cases.clone(),
+            sandbox: AcceptanceSandboxReportDto { isolation_verified, cleaned },
+            capabilities: AcceptanceCapabilitiesDto { process_death_recovery_tested: false, live_llm_api_tested: false, large_state_stress_tested: false, long_context_tested: false },
+        };
+        let status = active.status.clone();
+        hub.last_terminal = Some(TerminalRun { status, report });
+        Ok(())
+    }
+}
