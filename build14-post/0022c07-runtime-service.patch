+#[derive(Clone, Copy)]
+struct RuntimeAcceptanceTaskView;
+
+impl RuntimeAcceptanceTaskView {
+    async fn create_run(&self, ctx: &SuiteContext, suffix: &str, base_state_id: Option<String>, prompt: &Value) -> Result<AgentRun, ApplicationError> {
+        create_synthetic_run(&ctx.sandbox, &ctx.profile, &ctx.suite_run_id, suffix, base_state_id, prompt).await
+    }
+
+    async fn rp_call(&self, ctx: &SuiteContext, run_id: &str, prompt: &Value, name: &str, args: Value) -> Result<tt_domain::models::agent::AgentToolResult, ApplicationError> {
+        let call = tool_call(name, args)?;
+        let (result, _) = rp::dispatch_tool(ctx.sandbox.run_repository.as_ref(), ctx.sandbox.workspace_repository.as_ref(), run_id, prompt, &call).await?;
+        Ok(result)
+    }
+}
