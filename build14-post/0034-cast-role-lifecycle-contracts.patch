+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct RoleSuggestionControl {
+    pub character_id: CharacterId,
+    pub branch_id: BranchId,
+    pub locked_role: Option<NarrativeRole>,
+    pub suppressed_targets: Vec<NarrativeRole>,
+    pub snooze_until_turn: Option<u64>,
+}
+
+impl RoleSuggestionControl {
+    pub fn blocks_runtime_transition(&self, target: &NarrativeRole, turn: u64) -> bool {
+        self.locked_role.is_some()
+            || self.suppressed_targets.contains(target)
+            || self.snooze_until_turn.is_some_and(|until| turn < until)
+    }
+}
