+impl CastLifecyclePolicy {
+    /// Runtime transition policy only. Explicit user-direct role assignment is
+    /// handled separately and is intentionally not forced through this path.
+    pub fn runtime_transition_mode(
+        &self,
+        from: &NarrativeRole,
+        to: &NarrativeRole,
+    ) -> TransitionMode {
+        use NarrativeRole::{Incidental, Main, Recurring, Supporting};
+        match (from, to) {
+            (Incidental, Recurring) => self.incidental_to_recurring,
+            (Recurring, Supporting) => self.recurring_to_supporting,
+            (Supporting, Main) => self.supporting_to_main,
+            (left, right) if role_rank(right) < role_rank(left) => self.demotion_policy,
+            _ => TransitionMode::Disabled,
+        }
+    }
+}
+
+fn role_rank(role: &NarrativeRole) -> u8 {
+    match role {
+        NarrativeRole::Incidental => 0,
+        NarrativeRole::Recurring => 1,
+        NarrativeRole::Supporting => 2,
+        NarrativeRole::Main => 3,
+    }
+}
