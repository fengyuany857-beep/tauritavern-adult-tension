+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "SCREAMING_SNAKE_CASE")]
+pub enum RoleTransitionCandidateState {
+    Pending,
+    Deferred,
+    Accepted,
+    Rejected,
+    Suppressed,
+    Stale,
+    Superseded,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct RoleTransitionCandidate {
+    pub candidate_id: String,
+    pub character_id: CharacterId,
+    pub branch_id: BranchId,
+    pub from_role: NarrativeRole,
+    pub to_role: NarrativeRole,
+    pub policy_revision: u64,
+    pub evidence_summary: Vec<String>,
+    /// [EXPORT-LOCAL-ONLY] Structured refs only, never full private chat text.
+    pub evidence_refs: Vec<String>,
+    pub created_at_turn: u64,
+    pub state: RoleTransitionCandidateState,
+    pub snooze_until: Option<u64>,
+    pub superseded_by: Option<String>,
+}
+
+impl RoleTransitionCandidate {
+    pub fn is_effective(&self) -> bool {
+        matches!(
+            self.state,
+            RoleTransitionCandidateState::Pending | RoleTransitionCandidateState::Deferred
+        )
+    }
+
+    pub fn mark_stale(&mut self) {
+        if self.is_effective() {
+            self.state = RoleTransitionCandidateState::Stale;
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
