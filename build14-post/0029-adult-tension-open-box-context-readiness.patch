+
+const read = (path) => fs.readFileSync(new URL(`../${path}`, import.meta.url), 'utf8');
+const defaults = read('src-tauri/crates/tt-application/src/services/agent_profile_service/defaults.rs');
+const rpState = read('src-tauri/crates/tt-application/src/services/agent_tools/rp/state.rs');
+const settings = read('src/scripts/tauritavern/agent/agent-system-settings.js');
+const readiness = read('src/scripts/extensions/agent-system/src/adult-tension-readiness.js');
+const agentIndex = read('src/scripts/extensions/agent-system/src/index.js');
+const adapterManifest = JSON.parse(read('extras/adult-tension-tauritavern-adapter/agents/tauritavern.json'));
+
+const profileBlock = defaults.slice(defaults.indexOf('pub(super) fn adult_tension_rp_profile'));
+
+test('Adult Tension profile uses bounded layered context and tool budgets', () => {
+    assert.match(profileBlock, /initial_chat_history_messages:\s*16/);
+    assert.match(profileBlock, /include_activated_world_info:\s*true/);
+    assert.match(profileBlock, /max_rounds:\s*16/);
+    assert.match(profileBlock, /max_calls_per_run:\s*32/);
+    assert.match(profileBlock, /max_read_chars_per_call:\s*16_000/);
+    assert.match(profileBlock, /max_read_chars_per_run:\s*32_000/);
+    for (const skill of ['adult-tension', 'adult-tension-continuity', 'adult-tension-tauritavern-adapter']) {
+        assert.match(profileBlock, new RegExp(`"${skill}"\\.to_string\\(\\)`));
+    }
+    assert.doesNotMatch(profileBlock.match(/skills:\s*AgentSkillPolicy[\s\S]*?\n\s*},/)[0], /visible:\s*vec!\["\*"/);
+    assert.match(profileBlock, /Do not routinely reread the full/);
+    assert.match(profileBlock, /Activated World Info is already injected/);
+});
+
+test('Adapter recommendations avoid routine duplicate World Info and full Skill reads', () => {
+    assert.equal(adapterManifest.recommendedTools.includes('skill.read'), false);
+    assert.equal(adapterManifest.recommendedTools.includes('worldinfo.read_activated'), false);
+    assert.equal(Object.hasOwn(adapterManifest, 'recommendedContext'), false);
+});
+
+test('RP state bounds hot memory while recall indexes historical memory', () => {
+    assert.match(rpState, /const HOT_MEMORY_LIMIT:\s*usize\s*=\s*24/);
+    assert.match(rpState, /memory_count:\s*usize/);
+    assert.match(rpState, /memory_tier_counts:\s*BTreeMap/);
+    assert.match(rpState, /take\(HOT_MEMORY_LIMIT\)/);
+    assert.match(rpState, /"kind":"memory"/);
+    assert.match(rpState, /state_payload_bounds_hot_memories_but_recall_keeps_cold_memory_retrievable/);
+});
+
+test('Adult Tension distribution bootstraps once and exposes local readiness', () => {
+    assert.match(settings, /adultTensionBootstrapVersion:\s*0/);
+    assert.match(settings, /adultTensionContextBootstrapVersion:\s*0/);
+    assert.match(readiness, /adult_tension_selfsign/);
+    assert.match(readiness, /ADULT_TENSION_MIN_CONTEXT\s*=\s*16_384/);
+    assert.match(readiness, /ADULT_TENSION_MIN_RESPONSE\s*=\s*1_024/);
+    assert.match(readiness, /adult-tension-continuity/);
+    assert.match(readiness, /Local readiness only/);
+    assert.match(agentIndex, /applyAdultTensionBootstrap/);
+    assert.match(agentIndex, /checkAdultTensionReadiness/);
+});
