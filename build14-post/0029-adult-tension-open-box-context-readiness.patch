index 0000000..59ef568
--- /dev/null
+++ b/src/scripts/extensions/agent-system/src/adult-tension-readiness.js
@@ -0,0 +1,147 @@
+import { getClientVersion } from '../../../../tauri-bridge.js';
+import { getChatCompletionModel } from '../../../openai.js';
+import { loadSettings, patchSettings } from './settings-store.js';
+import { requireAgentApi, requireSkillApi, requireSillyTavernContext } from './host-api.js';
+
+export const ADULT_TENSION_DISTRIBUTION = 'adult_tension_selfsign';
+export const ADULT_TENSION_PROFILE_ID = 'adult-tension-rp';
+export const ADULT_TENSION_BOOTSTRAP_VERSION = 1;
+export const ADULT_TENSION_CONTEXT_BOOTSTRAP_VERSION = 1;
+export const ADULT_TENSION_MIN_CONTEXT = 16_384;
+export const ADULT_TENSION_MIN_RESPONSE = 1_024;
+export const ADULT_TENSION_REQUIRED_SKILLS = Object.freeze([
+    'adult-tension',
+    'adult-tension-continuity',
+    'adult-tension-tauritavern-adapter',
+]);
+
+async function distributionFlavor() {
+    const version = await getClientVersion();
+    return String(version?.distributionFlavor || '').trim();
+}
+
+export async function isAdultTensionDistribution() {
+    return await distributionFlavor() === ADULT_TENSION_DISTRIBUTION;
+}
+
+function factoryLikeAgentSettings(settings) {
+    const active = String(settings?.activeProfileId || 'default-writer').trim() || 'default-writer';
+    const editing = String(settings?.editingProfileId || active).trim() || active;
+    return active === 'default-writer' && editing === 'default-writer';
+}
+
+async function adultTensionProfileAvailable() {
+    const result = await requireAgentApi().profiles.list();
+    return Array.isArray(result?.profiles)
+        && result.profiles.some((profile) => profile?.id === ADULT_TENSION_PROFILE_ID && profile?.directRunnable !== false);
+}
+
+async function applyContextBootstrap(settings) {
+    if (Number(settings?.adultTensionContextBootstrapVersion || 0) >= ADULT_TENSION_CONTEXT_BOOTSTRAP_VERSION) {
+        return settings;
+    }
+    const context = requireSillyTavernContext();
+    if (context.mainApi !== 'openai') {
+        return settings;
+    }
+    const chatSettings = context.chatCompletionSettings;
+    if (!chatSettings || typeof chatSettings !== 'object') {
+        return settings;
+    }
+
+    let changed = false;
+    const currentContext = Number(chatSettings.openai_max_context);
+    if (Number.isFinite(currentContext) && currentContext <= 4095) {
+        chatSettings.openai_max_context = ADULT_TENSION_MIN_CONTEXT;
+        changed = true;
+    }
+    const currentResponse = Number(chatSettings.openai_max_tokens);
+    if (Number.isFinite(currentResponse) && currentResponse <= 300) {
+        chatSettings.openai_max_tokens = ADULT_TENSION_MIN_RESPONSE;
+        changed = true;
+    }
+    if (changed && typeof context.saveSettingsDebounced === 'function') {
+        context.saveSettingsDebounced();
+    }
+    return await patchSettings(settings, {
+        adultTensionContextBootstrapVersion: ADULT_TENSION_CONTEXT_BOOTSTRAP_VERSION,
+    });
+}
+
+export async function applyAdultTensionBootstrap() {
+    if (!await isAdultTensionDistribution()) {
+        return { applicable: false, changed: false };
+    }
+
+    let settings = await loadSettings();
+    let changed = false;
+    if (Number(settings?.adultTensionBootstrapVersion || 0) < ADULT_TENSION_BOOTSTRAP_VERSION) {
+        const profileAvailable = await adultTensionProfileAvailable();
+        const factoryLike = factoryLikeAgentSettings(settings);
+        const patch = {
+            adultTensionBootstrapVersion: ADULT_TENSION_BOOTSTRAP_VERSION,
+        };
+        if (profileAvailable && factoryLike) {
+            patch.agentModeEnabled = true;
+            patch.activeProfileId = ADULT_TENSION_PROFILE_ID;
+            patch.editingProfileId = ADULT_TENSION_PROFILE_ID;
+            changed = true;
+        }
+        settings = await patchSettings(settings, patch);
+    }
+
+    const beforeContextVersion = Number(settings?.adultTensionContextBootstrapVersion || 0);
+    settings = await applyContextBootstrap(settings);
+    changed ||= Number(settings?.adultTensionContextBootstrapVersion || 0) > beforeContextVersion;
+    return { applicable: true, changed, settings };
+}
+
+function readinessItem(id, ok, detail) {
+    return { id, ok: Boolean(ok), detail: String(detail || '') };
+}
+
+export async function checkAdultTensionReadiness() {
+    const flavor = await distributionFlavor();
+    if (flavor !== ADULT_TENSION_DISTRIBUTION) {
+        return { applicable: false, ready: false, items: [] };
+    }
+
+    const [settings, profilesResult, skills] = await Promise.all([
+        loadSettings(),
+        requireAgentApi().profiles.list(),
+        requireSkillApi().list({ scope: { kind: 'all' } }),
+    ]);
+    const context = requireSillyTavernContext();
+    const profiles = Array.isArray(profilesResult?.profiles) ? profilesResult.profiles : [];
+    const installedSkills = new Set((Array.isArray(skills) ? skills : []).map((skill) => String(skill?.name || '').trim()).filter(Boolean));
+    const missingSkills = ADULT_TENSION_REQUIRED_SKILLS.filter((name) => !installedSkills.has(name));
+    const chatSettings = context.chatCompletionSettings || {};
+    const maxContext = Number(chatSettings.openai_max_context || 0);
+    const responseLength = Number(chatSettings.openai_max_tokens || 0);
+    const model = context.mainApi === 'openai' ? String(getChatCompletionModel(chatSettings) || '').trim() : '';
+
+    const items = [
+        readinessItem('distribution', true, ADULT_TENSION_DISTRIBUTION),
+        readinessItem('agentMode', settings.agentModeEnabled === true, settings.agentModeEnabled ? 'ON' : 'OFF'),
+        readinessItem('profile', settings.activeProfileId === ADULT_TENSION_PROFILE_ID && profiles.some((p) => p?.id === ADULT_TENSION_PROFILE_ID), settings.activeProfileId || ''),
+        readinessItem('skills', missingSkills.length === 0, missingSkills.length ? `Missing: ${missingSkills.join(', ')}` : '3/3 installed'),
+        readinessItem('chatCompletion', context.mainApi === 'openai', String(context.mainApi || 'unset')),
+        readinessItem('model', Boolean(model), model || 'No chat-completion model selected'),
+        readinessItem('context', maxContext >= ADULT_TENSION_MIN_CONTEXT && responseLength >= ADULT_TENSION_MIN_RESPONSE, `${maxContext || 0} context / ${responseLength || 0} response`),
+        readinessItem('contextRouting', true, '16 recent messages + RP recall + exact chat retrieval + injected World Info'),
+    ];
+    return {
+        applicable: true,
+        ready: items.every((item) => item.ok),
+        items,
+        missingSkills,
+        model,
+        context: { maxContext, responseLength },
+        note: 'Local readiness only. It does not call the live LLM API or measure a real assembled prompt token ratio.',
+    };
+}
