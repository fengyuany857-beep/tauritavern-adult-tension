+use std::fs::{self, File, OpenOptions};
+use std::io::{Read, Write};
+use std::path::{Path, PathBuf};
+
+use chrono::Utc;
+use serde::{Deserialize, Serialize};
+use uuid::Uuid;
+use zip::write::SimpleFileOptions as FileOptions;
+use zip::{CompressionMethod, ZipWriter};
+
+use tt_domain::errors::DomainError;
+
+const CONTINUITY_SCHEMA_VERSION: u32 = 1;
+const DATA_SCHEMA_VERSION: u32 = 1;
+const CONTINUITY_DIR: &str = "_tauritavern";
+const CONTINUITY_FILE: &str = "continuity.json";
+const RECOVERY_DIR: &str = "recovery";
+const MAX_INTERNAL_RECOVERY_SNAPSHOTS: usize = 3;
+const EXPECTED_BUNDLE_IDENTIFIER: &str = "com.tauritavern.client";
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(super) enum DataContainerClassification {
+    NewInstall,
+    Existing,
+    LegacyExisting,
+}
+
+impl DataContainerClassification {
+    pub(super) fn as_str(self) -> &'static str {
+        match self {
+            Self::NewInstall => "NEW_INSTALL",
+            Self::Existing => "EXISTING",
+            Self::LegacyExisting => "LEGACY_EXISTING",
+        }
+    }
+}
+
+#[derive(Debug, Clone)]
+pub(super) struct ContinuityPreflight {
+    pub(super) classification: DataContainerClassification,
+    pub(super) installation_id: String,
+    pub(super) last_recovery_snapshot: Option<PathBuf>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct ContinuityMarker {
+    schema_version: u32,
+    installation_id: String,
+    data_schema_version: u32,
+    last_good_build: String,
+    last_successful_migration: Option<String>,
+    last_recovery_snapshot: Option<String>,
+}
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+struct RecoveryManifest<'a> {
+    format_version: u32,
+    created_at: &'a str,
+    bundle_identifier: &'a str,
+    source_app_version: &'a str,
+    source_build_revision: &'a str,
+    data_schema_version: u32,
+    adult_tension_suite_version: &'a str,
+    include_secrets: bool,
+    installation_id: &'a str,
+    purpose: &'a str,
+}
+
+pub(super) fn preflight(data_root: &Path) -> Result<ContinuityPreflight, DomainError> {
+    let marker_path = marker_path(data_root);
+
+    if marker_path.exists() {
+        let marker = read_and_validate_marker(&marker_path)?;
+        if !has_meaningful_existing_data(data_root)? {
+            return Err(DomainError::InvalidData(
+                "Continuity marker exists but authoritative data is empty; recovery is required and destructive initialization is blocked"
+                    .to_string(),
+            ));
+        }
+        return Ok(ContinuityPreflight {
+            classification: DataContainerClassification::Existing,
+            installation_id: marker.installation_id,
+            last_recovery_snapshot: marker.last_recovery_snapshot.map(PathBuf::from),
+        });
+    }
+
+    let has_existing_data = has_meaningful_existing_data(data_root)?;
+    let installation_id = Uuid::new_v4().simple().to_string();
+    let classification = if has_existing_data {
+        DataContainerClassification::LegacyExisting
+    } else {
+        DataContainerClassification::NewInstall
+    };
+
+    let recovery_snapshot = if classification == DataContainerClassification::LegacyExisting {
+        Some(create_internal_recovery_snapshot(
+            data_root,
+            &installation_id,
+            "legacy-pre-marker-upgrade",
+        )?)
+    } else {
+        None
+    };
+
+    let marker = ContinuityMarker {
+        schema_version: CONTINUITY_SCHEMA_VERSION,
+        installation_id: installation_id.clone(),
+        data_schema_version: DATA_SCHEMA_VERSION,
+        last_good_build: current_build_identity(),
+        last_successful_migration: None,
+        last_recovery_snapshot: recovery_snapshot
+            .as_ref()
+            .map(|path| path.to_string_lossy().to_string()),
+    };
+    write_marker_atomically(&marker_path, &marker)?;
+
+    Ok(ContinuityPreflight {
+        classification,
+        installation_id,
+        last_recovery_snapshot: recovery_snapshot,
+    })
+}
+
+fn read_and_validate_marker(path: &Path) -> Result<ContinuityMarker, DomainError> {
+    let bytes = fs::read(path).map_err(|error| io_error("read continuity marker", path, error))?;
+    let marker: ContinuityMarker = serde_json::from_slice(&bytes).map_err(|error| {
+        DomainError::InvalidData(format!(
+            "Data continuity marker is corrupt or unknown; refusing destructive initialization: {error}"
+        ))
+    })?;
+
+    if marker.schema_version != CONTINUITY_SCHEMA_VERSION {
+        return Err(DomainError::InvalidData(format!(
+            "Unsupported data continuity marker schemaVersion {}; expected {}",
+            marker.schema_version, CONTINUITY_SCHEMA_VERSION
+        )));
+    }
+    if marker.data_schema_version > DATA_SCHEMA_VERSION {
+        return Err(DomainError::InvalidData(format!(
+            "Data schema {} is newer than supported schema {}; refusing downgrade initialization",
+            marker.data_schema_version, DATA_SCHEMA_VERSION
+        )));
+    }
+    if marker.installation_id.trim().is_empty() {
+        return Err(DomainError::InvalidData(
+            "Data continuity marker has an empty installationId; recovery is required".to_string(),
+        ));
+    }
+    Ok(marker)
+}
+
+fn has_meaningful_existing_data(data_root: &Path) -> Result<bool, DomainError> {
+    if !data_root.exists() {
+        return Ok(false);
+    }
+    if !data_root.is_dir() {
+        return Err(DomainError::InvalidData(format!(
+            "Data root is not a directory: {}",
+            data_root.display()
+        )));
+    }
+
+    let mut stack = vec![data_root.to_path_buf()];
+    while let Some(directory) = stack.pop() {
+        for entry in fs::read_dir(&directory)
+            .map_err(|error| io_error("inspect data root", &directory, error))?
+        {
+            let entry = entry.map_err(|error| {
+                DomainError::InternalError(format!("Failed to inspect data root entry: {error}"))
+            })?;
+            let path = entry.path();
+            let metadata = fs::symlink_metadata(&path)
+                .map_err(|error| io_error("inspect data root entry metadata", &path, error))?;
+            if metadata.file_type().is_symlink() {
+                return Err(DomainError::InvalidData(format!(
+                    "Unexpected symlink in data root {}; refusing to classify as a new install",
+                    path.display()
+                )));
+            }
+            if metadata.is_dir() {
+                stack.push(path);
+                continue;
+            }
+            if metadata.is_file() && !is_ignorable_scaffolding_file(&path) {
+                return Ok(true);
+            }
+        }
+    }
+    Ok(false)
+}
+
+fn is_ignorable_scaffolding_file(path: &Path) -> bool {
+    let Some(name) = path.file_name().and_then(|name| name.to_str()) else {
+        return false;
+    };
+    matches!(name.to_ascii_lowercase().as_str(), ".ds_store" | ".localized")
+        || name == CONTINUITY_FILE
+        || name.starts_with("continuity.json.tmp-")
+}
+
+fn create_internal_recovery_snapshot(
+    data_root: &Path,
+    installation_id: &str,
+    purpose: &str,
+) -> Result<PathBuf, DomainError> {
+    let app_root = data_root.parent().ok_or_else(|| {
+        DomainError::InternalError("Data root has no app-data parent".to_string())
+    })?;
+    let recovery_root = app_root.join(".data-archive").join(RECOVERY_DIR);
+    fs::create_dir_all(&recovery_root)
+        .map_err(|error| io_error("create recovery directory", &recovery_root, error))?;
+
+    let timestamp = Utc::now().format("%Y%m%d-%H%M%S%.3fZ").to_string();
+    let final_path = recovery_root.join(format!("recovery-{timestamp}.zip"));
+    let temporary_path = recovery_root.join(format!(".recovery-{timestamp}.partial"));
+    let file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(&temporary_path)
+        .map_err(|error| io_error("create recovery snapshot", &temporary_path, error))?;
+    let mut zip = ZipWriter::new(file);
+    let options = FileOptions::default().compression_method(CompressionMethod::Deflated);
+
+    let manifest = RecoveryManifest {
+        format_version: 1,
+        created_at: &timestamp,
+        bundle_identifier: EXPECTED_BUNDLE_IDENTIFIER,
+        source_app_version: crate::product::VERSION,
+        source_build_revision: crate::product::optional_build_value(crate::product::GIT_REVISION)
+            .unwrap_or("unknown"),
+        data_schema_version: DATA_SCHEMA_VERSION,
+        adult_tension_suite_version: "adult-tension-runtime-skills-v1",
+        include_secrets: true,
+        installation_id,
+        purpose,
+    };
+    let manifest_bytes = serde_json::to_vec_pretty(&manifest).map_err(|error| {
+        DomainError::InternalError(format!("Failed to serialize recovery manifest: {error}"))
+    })?;
+    zip.start_file("recovery-manifest.json", options)
+        .map_err(|error| archive_error("start recovery manifest", error))?;
+    zip.write_all(&manifest_bytes).map_err(|error| {
+        DomainError::InternalError(format!("Failed to write recovery manifest: {error}"))
+    })?;
+
+    append_data_tree(&mut zip, data_root, options)?;
+    let mut output = zip
+        .finish()
+        .map_err(|error| archive_error("finalize recovery snapshot", error))?;
+    output
+        .flush()
+        .map_err(|error| io_error("flush recovery snapshot", &temporary_path, error))?;
+    output
+        .sync_all()
+        .map_err(|error| io_error("sync recovery snapshot", &temporary_path, error))?;
+    drop(output);
+    fs::rename(&temporary_path, &final_path)
+        .map_err(|error| io_error("publish recovery snapshot", &final_path, error))?;
+    prune_internal_recovery_snapshots(&recovery_root)?;
+    Ok(final_path)
+}
+
+fn append_data_tree(
+    zip: &mut ZipWriter<File>,
+    data_root: &Path,
+    options: FileOptions,
+) -> Result<(), DomainError> {
+    let mut stack = vec![data_root.to_path_buf()];
+    let mut buffer = vec![0_u8; 64 * 1024];
+    while let Some(directory) = stack.pop() {
+        let mut entries = fs::read_dir(&directory)
+            .map_err(|error| io_error("read recovery source directory", &directory, error))?
+            .collect::<Result<Vec<_>, _>>()
+            .map_err(|error| DomainError::InternalError(format!("Failed to enumerate recovery source: {error}")))?;
+        entries.sort_by_key(|entry| entry.file_name());
+        for entry in entries {
+            let path = entry.path();
+            let metadata = fs::symlink_metadata(&path)
+                .map_err(|error| io_error("inspect recovery source", &path, error))?;
+            if metadata.file_type().is_symlink() {
+                return Err(DomainError::InvalidData(format!(
+                    "Recovery snapshot refused symlink in authoritative data: {}",
+                    path.display()
+                )));
+            }
+            if metadata.is_dir() {
+                stack.push(path);
+                continue;
+            }
+            if !metadata.is_file() {
+                continue;
+            }
+            let relative = path.strip_prefix(data_root).map_err(|error| {
+                DomainError::InternalError(format!("Failed to relativize recovery path: {error}"))
+            })?;
+            let archive_name = format!("data/{}", relative.to_string_lossy().replace('\\', "/"));
+            zip.start_file(archive_name, options)
+                .map_err(|error| archive_error("start recovery data entry", error))?;
+            let mut input = File::open(&path)
+                .map_err(|error| io_error("open recovery source file", &path, error))?;
+            loop {
+                let read = input
+                    .read(&mut buffer)
+                    .map_err(|error| io_error("read recovery source file", &path, error))?;
+                if read == 0 {
+                    break;
+                }
+                zip.write_all(&buffer[..read]).map_err(|error| {
+                    DomainError::InternalError(format!("Failed to write recovery data entry: {error}"))
+                })?;
+            }
+        }
+    }
+    Ok(())
+}
+
+fn prune_internal_recovery_snapshots(recovery_root: &Path) -> Result<(), DomainError> {
+    let mut snapshots = fs::read_dir(recovery_root)
+        .map_err(|error| io_error("list recovery snapshots", recovery_root, error))?
+        .filter_map(Result::ok)
+        .filter(|entry| {
+            let name = entry.file_name();
+            let name = name.to_string_lossy();
+            name.starts_with("recovery-") && name.ends_with(".zip")
+        })
+        .collect::<Vec<_>>();
+    snapshots.sort_by_key(|entry| entry.file_name());
+    let remove_count = snapshots.len().saturating_sub(MAX_INTERNAL_RECOVERY_SNAPSHOTS);
+    for entry in snapshots.into_iter().take(remove_count) {
+        let path = entry.path();
+        fs::remove_file(&path)
+            .map_err(|error| io_error("prune recovery snapshot", &path, error))?;
+    }
+    Ok(())
+}
+
+fn write_marker_atomically(path: &Path, marker: &ContinuityMarker) -> Result<(), DomainError> {
+    let parent = path.parent().ok_or_else(|| {
+        DomainError::InternalError("Continuity marker path has no parent".to_string())
+    })?;
+    fs::create_dir_all(parent)
+        .map_err(|error| io_error("create continuity marker directory", parent, error))?;
+    let bytes = serde_json::to_vec_pretty(marker).map_err(|error| {
+        DomainError::InternalError(format!("Failed to serialize continuity marker: {error}"))
+    })?;
+    let temporary_path = parent.join(format!("continuity.json.tmp-{}", Uuid::new_v4().simple()));
+    let mut file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(&temporary_path)
+        .map_err(|error| io_error("create temporary continuity marker", &temporary_path, error))?;
+    file.write_all(&bytes)
+        .map_err(|error| io_error("write temporary continuity marker", &temporary_path, error))?;
+    file.flush()
+        .map_err(|error| io_error("flush temporary continuity marker", &temporary_path, error))?;
+    file.sync_all()
+        .map_err(|error| io_error("sync temporary continuity marker", &temporary_path, error))?;
+    drop(file);
+    if path.exists() {
+        fs::remove_file(&temporary_path).ok();
+        return Err(DomainError::InvalidData(
+            "Continuity marker appeared during preflight; refusing to overwrite concurrent state"
+                .to_string(),
+        ));
+    }
+    fs::rename(&temporary_path, path)
+        .map_err(|error| io_error("publish continuity marker", path, error))?;
+    Ok(())
+}
+
+fn marker_path(data_root: &Path) -> PathBuf {
+    data_root.join(CONTINUITY_DIR).join(CONTINUITY_FILE)
+}
+
+fn current_build_identity() -> String {
+    match crate::product::optional_build_value(crate::product::GIT_REVISION) {
+        Some(revision) => format!("{}+{}", crate::product::VERSION, revision),
+        None => crate::product::VERSION.to_string(),
+    }
+}
+
+fn io_error(action: &str, path: &Path, error: std::io::Error) -> DomainError {
+    DomainError::InternalError(format!("Failed to {action} at {}: {error}", path.display()))
+}
+
+fn archive_error(action: &str, error: zip::result::ZipError) -> DomainError {
+    DomainError::InternalError(format!("Failed to {action}: {error}"))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use zip::ZipArchive;
+
+    struct TempDataRoot {
+        root: PathBuf,
+        data: PathBuf,
+    }
+
+    impl TempDataRoot {
+        fn new() -> Self {
+            let root = std::env::temp_dir().join(format!(
+                "tauritavern-continuity-test-{}",
+                Uuid::new_v4().simple()
+            ));
+            let data = root.join("data");
+            fs::create_dir_all(&data).expect("create test data root");
+            Self { root, data }
+        }
+    }
+
+    impl Drop for TempDataRoot {
+        fn drop(&mut self) {
+            let _ = fs::remove_dir_all(&self.root);
+        }
+    }
+
+    #[test]
+    fn empty_root_is_new_install_without_recovery_snapshot() {
+        let temp = TempDataRoot::new();
+        let result = preflight(&temp.data).expect("new-install preflight");
+        assert_eq!(result.classification, DataContainerClassification::NewInstall);
+        assert!(result.last_recovery_snapshot.is_none());
+        assert!(marker_path(&temp.data).is_file());
+    }
+
+    #[test]
+    fn legacy_existing_data_is_snapshotted_before_marker_creation() {
+        let temp = TempDataRoot::new();
+        let chat = temp.data.join("default-user/chats/TEST_CHARACTER_A/chat.jsonl");
+        fs::create_dir_all(chat.parent().unwrap()).expect("create legacy chat directory");
+        fs::write(&chat, b"legacy-world-state").expect("write legacy chat");
+
+        let result = preflight(&temp.data).expect("legacy preflight");
+        assert_eq!(
+            result.classification,
+            DataContainerClassification::LegacyExisting
+        );
+        let snapshot = result.last_recovery_snapshot.expect("legacy recovery snapshot");
+        assert!(snapshot.is_file());
+        assert!(marker_path(&temp.data).is_file());
+
+        let file = File::open(snapshot).expect("open recovery snapshot");
+        let mut archive = ZipArchive::new(file).expect("open recovery zip");
+        let mut archived_chat = archive
+            .by_name("data/default-user/chats/TEST_CHARACTER_A/chat.jsonl")
+            .expect("archived legacy chat");
+        let mut text = String::new();
+        archived_chat.read_to_string(&mut text).expect("read archived chat");
+        assert_eq!(text, "legacy-world-state");
+    }
+
+    #[test]
+    fn corrupt_marker_fails_closed_without_touching_existing_data() {
+        let temp = TempDataRoot::new();
+        let chat = temp.data.join("default-user/chats/keep.jsonl");
+        fs::create_dir_all(chat.parent().unwrap()).expect("create chat directory");
+        fs::write(&chat, b"keep-me").expect("write chat");
+        let marker = marker_path(&temp.data);
+        fs::create_dir_all(marker.parent().unwrap()).expect("create marker directory");
+        fs::write(&marker, b"{broken-json").expect("write corrupt marker");
+
+        assert!(preflight(&temp.data).is_err());
+        assert_eq!(fs::read(&chat).expect("read preserved chat"), b"keep-me");
+    }
+
+    #[test]
+    fn future_data_schema_fails_closed() {
+        let temp = TempDataRoot::new();
+        fs::write(temp.data.join("settings.json"), b"{}").expect("write existing data");
+        let marker = marker_path(&temp.data);
+        fs::create_dir_all(marker.parent().unwrap()).expect("create marker directory");
+        fs::write(
+            marker,
+            br#"{"schemaVersion":1,"installationId":"stable-id","dataSchemaVersion":999,"lastGoodBuild":"old","lastSuccessfulMigration":null,"lastRecoverySnapshot":null}"#,
+        )
+        .expect("write future marker");
+        assert!(preflight(&temp.data).is_err());
+    }
+}
