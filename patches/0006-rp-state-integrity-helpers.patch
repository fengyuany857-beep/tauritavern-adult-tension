+fn fact_is_active(fact: &RpFact) -> bool {
+    fact.admission_state == "COMMITTED"
+        && fact.invalid_at_turn.is_none()
+        && !matches!(fact.truth_status.as_str(), "SUPERSEDED" | "RETRACTED")
+}
+
+fn apply_retractions(state: &mut RpState, target_turns: &[u64], reason: &str, recorded_at_turn: u64) {
+    let targets = target_turns.iter().copied().collect::<HashSet<_>>();
+    let removed_facts = state
+        .facts
+        .iter()
+        .filter(|fact| targets.contains(&fact.recorded_at_turn))
+        .map(|fact| (fact.id.clone(), compact(&format!("{}{}", fact.subject, fact.predicate))))
+        .collect::<Vec<_>>();
+    let removed_fact_ids = removed_facts.iter().map(|(id, _)| id.as_str()).collect::<HashSet<_>>();
+    let removed_signatures = removed_facts.iter().map(|(_, signature)| signature.as_str()).collect::<HashSet<_>>();
+
+    state.events.retain(|event| !targets.contains(&event.turn));
+    state.facts.retain(|fact| !targets.contains(&fact.recorded_at_turn));
+    state.knowledge.retain(|knowledge| {
+        if targets.contains(&knowledge.turn) {
+            return false;
+        }
+        if knowledge.fact_id.as_deref().is_some_and(|fact_id| removed_fact_ids.contains(fact_id)) {
+            return false;
+        }
+        let signature = compact(&format!("{}{}", knowledge.subject, knowledge.predicate));
+        !removed_signatures.contains(signature.as_str())
+    });
+    state.commitments.retain(|commitment| !targets.contains(&commitment.turn));
+    state.threads.retain(|thread| {
+        !targets.contains(&thread.turn)
+            && !thread.requires.iter().any(|required| removed_fact_ids.contains(required.as_str()))
+    });
+    state.living_world.agendas.retain(|agenda| !targets.contains(&agenda.turn));
+    state.recent_beats.retain(|beat| !targets.contains(&beat.turn));
+    state.npcs.retain(|_, npc| npc.last_updated_turn.is_none_or(|turn| !targets.contains(&turn)));
+
+    for target_turn in target_turns {
+        state.retractions.push(RpRetraction {
+            target_turn: *target_turn,
+            reason: reason.to_string(),
+            recorded_at_turn,
+            runtime_revision: state.runtime_revision,
+        });
+    }
+    trim_front(&mut state.retractions, 64);
+}
