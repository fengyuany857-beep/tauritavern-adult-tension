+    #[test]
+    fn retraction_cascades_turn_derived_continuity() {
+        let mut state = RpState {
+            runtime_revision: 6,
+            turn: 6,
+            npcs: BTreeMap::from([(
+                "Eve".to_string(),
+                RpNpcState { last_updated_turn: Some(6), goal: Some("read invalid letter".to_string()), ..RpNpcState::default() },
+            )]),
+            events: vec![RpEvent { id: "event-6".to_string(), summary: "invalid letter event".to_string(), status: "resolved".to_string(), turn: 6 }],
+            facts: vec![RpFact {
+                id: "fact-6".to_string(),
+                subject: "letter".to_string(),
+                predicate: "exists".to_string(),
+                value: json!(true),
+                plane: "OBJECTIVE".to_string(),
+                classification: "HISTORICAL".to_string(),
+                truth_status: "HISTORICAL_FACT".to_string(),
+                admission_state: "COMMITTED".to_string(),
+                valid_from_turn: 6,
+                invalid_at_turn: None,
+                recorded_at_turn: 6,
+            }],
+            knowledge: vec![RpKnowledge {
+                character_id: "Eve".to_string(),
+                subject: "letter".to_string(),
+                predicate: "content".to_string(),
+                state: "knows".to_string(),
+                fact_id: Some("fact-6".to_string()),
+                source: Some(RpKnowledgeSource { kind: "observed".to_string(), reference: None }),
+                turn: 6,
+            }],
+            threads: vec![RpThread {
+                id: "thread-later".to_string(),
+                summary: "depends on invalid letter".to_string(),
+                status: "open".to_string(),
+                requires: vec!["fact-6".to_string()],
+                reveal_gate: None, presentation_gate: None, anti_merge: vec![], turn: 7,
+            }],
+            recent_beats: vec![RpBeat { turn: 6, summary: "invalid beat".to_string(), run_id: "run-6".to_string() }],
+            ..RpState::default()
+        };
+        apply_retractions(&mut state, &[6], "user corrected the prior beat", 6);
+        assert!(state.events.is_empty());
+        assert!(state.facts.is_empty());
+        assert!(state.knowledge.is_empty());
+        assert!(state.npcs.is_empty());
+        assert!(state.threads.is_empty());
+        assert!(state.recent_beats.is_empty());
+        assert_eq!(state.retractions.len(), 1);
+        assert_eq!(state.retractions[0].target_turn, 6);
+    }
